<!DOCTYPE html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title><%= typeof title === 'string' && title ? title + ' · ' : '' %>OpenRice LINE CRM</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/style.css" />
    <style>
      .topbar--admin{position:relative;z-index:900;box-shadow:0 1px 0 rgba(255,255,255,.08)}
      .admin-main-link,.admin-guide-link,.admin-find-btn{position:relative;color:#d1d5db;border:0;background:none;padding:8px 6px;border-radius:6px;font:inherit;font-size:13px;font-weight:650;text-decoration:none;cursor:pointer;white-space:nowrap}
      .admin-main-link:hover,.admin-guide-link:hover,.admin-find-btn:hover{color:#fff;background:rgba(255,255,255,.08);text-decoration:none}
      .admin-main-link.has-active,.admin-guide-link.has-active{color:#fcc726}
      .admin-main-link.has-active::after,.admin-guide-link.has-active::after{content:"";position:absolute;left:7px;right:7px;bottom:1px;height:2px;border-radius:2px;background:#fcc726}
      .admin-find-btn{border:1px solid rgba(255,255,255,.22);padding-left:10px;padding-right:10px}
      .admin-find-btn kbd{margin-left:4px;color:#9ca3af;font:inherit;font-size:10px}
      .admin-context{display:flex;align-items:center;gap:7px;margin:0 0 12px;color:#7b706b;font-size:12px}
      .admin-context[hidden]{display:none}.admin-context a{color:#6f4a00;text-decoration:none}.admin-context a:hover{text-decoration:underline}.admin-context-current{font-weight:700;color:#4b403c}
      .admin-shell .card{border:1px solid #ebe7e4;box-shadow:0 4px 18px rgba(30,20,15,.045)}
      .sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
      .admin-finder{width:min(760px,calc(100vw - 30px));max-height:min(780px,calc(100vh - 40px));padding:0;border:1px solid #ddd6d2;border-radius:16px;box-shadow:0 28px 80px rgba(20,13,10,.24)}
      .admin-finder::backdrop{background:rgba(17,24,39,.52);backdrop-filter:blur(2px)}
      .admin-finder-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding:22px 24px 14px}.admin-finder-head h2{margin:0 0 4px;color:#302522;font-size:22px}.admin-finder-head p{margin:0;color:#786d68;font-size:13px}.admin-finder-close{width:34px;height:34px;border:0;border-radius:50%;background:#f2efed;color:#5f514c;font-size:22px;cursor:pointer}
      .admin-finder-search{display:block;margin:0 24px 15px}.admin-finder-search input{width:100%;min-height:46px;padding:10px 13px;border:1px solid #d7d1cd;border-radius:10px;color:#302522;font:inherit}.admin-finder-search input:focus{outline:3px solid rgba(249,199,59,.28);border-color:#d8a900}
      .admin-finder-results{max-height:540px;overflow:auto;padding:0 16px 20px}.admin-finder-group{margin:4px 0 15px}.admin-finder-group h3{margin:0 8px 6px;color:#8b7e78;font-size:11px;letter-spacing:.08em}.admin-finder-group a{display:grid;grid-template-columns:190px 1fr;gap:12px;padding:10px 11px;border-radius:9px;color:#302522;text-decoration:none}.admin-finder-group a:hover,.admin-finder-group a:focus{background:#fff9df;outline:none}.admin-finder-group strong{font-size:14px}.admin-finder-group span{color:#786d68;font-size:12px;line-height:1.45}.admin-finder-group[hidden],.admin-finder-group a[hidden],.admin-finder-empty[hidden]{display:none!important}.admin-finder-empty{padding:26px 12px;color:#786d68;text-align:center}
      .nav-toggle{display:none}.nav-toggle-btn{width:40px;height:36px;border:0;background:none;cursor:pointer;padding:8px}.nav-toggle-btn .bar{display:block;width:100%;height:2px;background:#d1d5db;border-radius:2px;transition:transform .2s,opacity .2s}.nav-toggle-btn .bar+.bar{margin-top:5px}.nav-toggle-btn[aria-expanded="true"] .bar:nth-child(1){transform:translateY(7px) rotate(45deg)}.nav-toggle-btn[aria-expanded="true"] .bar:nth-child(2){opacity:0}.nav-toggle-btn[aria-expanded="true"] .bar:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
      @media(max-width:900px){.topbar--admin .welcome{display:none}.admin-main-link,.admin-guide-link{font-size:12px;padding-left:4px;padding-right:4px}}
      @media(max-width:720px){.nav-toggle{display:inline-flex;align-items:center}.topbar.topbar--admin .topbar-nav { display: none;width:100%;flex-direction:column;align-items:stretch;gap:2px;margin-top:10px}.topbar.topbar--admin .topbar-nav.nav-open { display: flex; }.topbar-inner{flex-wrap:wrap}.admin-main-link,.admin-guide-link,.admin-find-btn{display:block;width:100%;padding:11px 8px;text-align:left}.admin-main-link.has-active::after,.admin-guide-link.has-active::after{left:0;right:auto;top:7px;bottom:7px;width:3px;height:auto}.admin-find-btn{border:0}.admin-find-btn kbd{display:none}.admin-finder-group a{grid-template-columns:1fr;gap:3px}}
    </style>
  </head>
  <body class="<%= typeof bodyClass === 'string' && bodyClass.trim() ? bodyClass.trim() : '' %>">
    <% if (typeof isSafePreview !== 'undefined' && isSafePreview) { %><div role="status" style="position:sticky;top:0;z-index:1000;padding:9px 14px;text-align:center;background:#FEF3C7;border-bottom:1px solid #F59E0B;color:#78350F;font-size:14px;font-weight:700;">STAGING 測試環境｜使用隔離測試資料，不會真的傳 LINE、寄 Email 或建立正式訂位</div><% } %>
    <header class="topbar<%= typeof bodyClass === 'string' && String(bodyClass).includes('admin-shell') ? ' topbar--admin' : '' %>"><div class="container topbar-inner"><div class="brand"><% if (typeof isAdmin !== 'undefined' && isAdmin && user) { %><a href="/admin" class="brand-link">OpenRice LINE CRM</a><% } else { %><span class="brand-text">OpenRice LINE CRM</span><% } %></div>
      <% if (user) { %><div class="nav-toggle"><button type="button" class="nav-toggle-btn" id="nav-toggle-btn" aria-label="開關選單" aria-expanded="false" aria-controls="topbar-nav"><span class="bar"></span><span class="bar"></span><span class="bar"></span></button></div><% } %>
      <nav class="topbar-nav" id="topbar-nav" aria-label="主選單"><% if (user) { %><span class="welcome">嗨，<%= user %></span><% if (isAdmin) { %>
        <a class="admin-main-link" data-admin-section="home" href="/admin">工作台</a>
        <a class="admin-main-link" data-admin-section="message" href="/admin/broadcast">傳訊息</a>
        <a class="admin-main-link" data-admin-section="people" href="/admin/recipient-lists">顧客名單</a>
        <a class="admin-main-link" data-admin-section="activity" href="/admin/activities">活動</a>
        <a class="admin-main-link" data-admin-section="insight" href="/admin/insight">看成效</a>
        <a class="admin-main-link" data-admin-section="settings" href="/admin/accounts">設定</a>
        <button type="button" class="admin-find-btn" id="admin-find-trigger">全部功能 <kbd>⌘K</kbd></button><a class="admin-guide-link" href="/admin/guide">教學</a>
      <% } %><form action="/logout" method="post" class="inline-form topbar-logout"><button type="submit">登出</button></form><% } else { %><a class="topbar-guest-hint" href="<%= typeof loginAction === 'string' && loginAction ? loginAction : '/admin/login' %>">內部員工請由此登入</a><% } %></nav>
    </div></header>
    <% if (typeof authDegraded !== 'undefined' && authDegraded) { %><div style="max-width:1200px;margin:12px auto 0;padding:11px 14px;border:1px solid #FDE68A;background:#FFFBEB;border-radius:10px;font-size:13.5px;color:#92400E;line-height:1.7;"><b>現在連不上資料庫，先讓你看畫面</b>：這段時間畫面上的資料可能不是最新的，而且<b>不能存檔或送出任何動作</b>。過一下重新整理，正常了就會恢復。</div><% } %>
    <% if (typeof isAdmin !== 'undefined' && isAdmin && user) { %>
    <dialog class="admin-finder" id="admin-finder" aria-labelledby="admin-finder-title"><div class="admin-finder-head"><div><h2 id="admin-finder-title">全部功能</h2><p>只有需要時才來這裡找，平常用上方六個入口就好。</p></div><button type="button" class="admin-finder-close" id="admin-finder-close" aria-label="關閉">×</button></div><label class="admin-finder-search"><span class="sr-only">搜尋功能</span><input id="admin-finder-input" type="search" placeholder="例如：訂位、名單、活動、Email…" autocomplete="off" /></label><div class="admin-finder-results" id="admin-finder-results">
      <section class="admin-finder-group" data-finder-group data-category="傳訊息"><h3>傳訊息</h3>
        <a data-finder-item data-section="message" href="/admin/broadcast"><strong>傳訊息給顧客</strong><span>選名單、選內容、測試後送出</span></a><a data-finder-item data-section="message" href="/admin/broadcast/history"><strong>發送紀錄</strong><span>查每一篇內容、成功人數與成果</span></a><a data-finder-item data-section="message" href="/admin/messages"><strong>已存訊息</strong><span>管理文字、圖片、影片與卡片</span></a><a data-finder-item data-section="message" href="/admin/messages/sequence"><strong>多段訊息編輯</strong><span>把文字、圖片、影片與卡片一起發送</span></a><a data-finder-item data-section="message" href="/admin/revisit-email"><strong>訂位客回訪 Email</strong><span>匯入訂位與優惠，產生回訪信</span></a><a data-finder-item data-section="message" href="/admin/keyword-replies"><strong>關鍵字自動回覆</strong><span>顧客輸入指定文字時回答</span></a><a data-finder-item data-section="message" href="/admin/flows"><strong>自動傳訊</strong><span>依加好友、點擊或活動行為追發</span></a><a data-finder-item data-section="message" href="/admin/invite-reminders"><strong>邀請進度提醒</strong><span>提醒還沒完成好友任務的顧客</span></a><a data-finder-item data-section="message" href="/admin/richmenu"><strong>LINE 圖文選單</strong><span>設計、預覽、排程與發布選單</span></a>
      </section><section class="admin-finder-group" data-finder-group data-category="顧客名單"><h3>顧客名單</h3>
        <a data-finder-item data-section="people" href="/admin/recipient-lists"><strong>顧客名單</strong><span>建立固定或自動更新的發送名單</span></a><a data-finder-item data-section="people" href="/admin/users"><strong>顧客資料</strong><span>搜尋一位顧客的行為與標籤</span></a><a data-finder-item data-section="people" href="/admin/tag-rules"><strong>自動貼標</strong><span>依顧客行為自動增減標籤</span></a><a data-finder-item data-section="people" href="/admin/oa-contacts"><strong>OA 好友名單</strong><span>查看官方帳號好友匯入狀態</span></a><a data-finder-item data-section="people" href="/admin/restaurants"><strong>餐廳資料</strong><span>管理餐廳名稱與對應資料</span></a><a data-finder-item data-section="people" href="/admin/users/bonus"><strong>人工補遊戲次數</strong><span>查核後替指定顧客補發機會</span></a><a data-finder-item data-section="people" href="/admin/users/bonus/logs"><strong>補發紀錄</strong><span>查看人工補遊戲次數的歷史</span></a>
      </section><section class="admin-finder-group" data-finder-group data-category="活動"><h3>活動</h3>
        <a data-finder-item data-section="activity" href="/admin/activities"><strong>活動管理</strong><span>建立活動、獎項、次數與前台畫面</span></a><a data-finder-item data-section="activity" href="/admin/mgm"><strong>活動成果</strong><span>看參與、邀請、得獎、庫存與名單</span></a><a data-finder-item data-section="activity" href="/admin/mgm/draw"><strong>抽出得獎者</strong><span>依活動規則執行後台抽獎</span></a><a data-finder-item data-section="activity" href="/admin/prizes"><strong>獎項管理</strong><span>管理刮刮樂獎項與數量</span></a><a data-finder-item data-section="activity" href="/admin/campaign"><strong>刮刮樂活動時間</strong><span>設定活動開始與結束時間</span></a><a data-finder-item data-section="activity" href="/admin/coupons"><strong>優惠券</strong><span>查發放、領取與使用狀態</span></a><a data-finder-item data-section="activity" href="/admin/booking-reg"><strong>訂位抽獎登記</strong><span>管理訂位完成後的抽獎資格</span></a><a data-finder-item data-section="activity" href="/admin/campaigns/spring"><strong>春日饗里</strong><span>管理春日活動資料</span></a><a data-finder-item data-section="activity" href="/admin/campaigns/ludian"><strong>旅電借電券</strong><span>查看與設定旅電活動兌換</span></a>
      </section><section class="admin-finder-group" data-finder-group data-category="看成效"><h3>看成效</h3>
        <a data-finder-item data-section="insight" href="/admin/insight"><strong>成效總覽</strong><span>好友成長、互動與圖文選單曝光</span></a><a data-finder-item data-section="insight" href="/admin/reports"><strong>推播與互動紀錄</strong><span>查 LINE 推播、點擊與系統紀錄</span></a><a data-finder-item data-section="insight" href="/admin/campaign-performance"><strong>訊息發送成果</strong><span>從發送、開啟、點擊看到轉換</span></a><a data-finder-item data-section="insight" href="/admin/attribution"><strong>哪個入口帶來成果</strong><span>比較活動與渠道的轉換</span></a><a data-finder-item data-section="insight" href="/admin/liff-tracking"><strong>顧客從哪裡進活動</strong><span>比較圖文選單、推播與歡迎訊息</span></a><a data-finder-item data-section="insight" href="/admin/referrals"><strong>好友邀請成果</strong><span>查誰邀請誰、是否成功與原因</span></a><a data-finder-item data-section="insight" href="/admin/liff/random-rice"><strong>好康地圖使用情況</strong><span>開啟、搜尋、查看與訂位點擊</span></a><a data-finder-item data-section="insight" href="/admin/rfm"><strong>會員價值分級</strong><span>依消費與互動找高價值會員</span></a>
      </section><section class="admin-finder-group" data-finder-group data-category="設定"><h3>設定</h3>
        <a data-finder-item data-section="settings" href="/admin/accounts"><strong>後台帳號</strong><span>新增、停用使用者與權限</span></a><a data-finder-item data-section="settings" href="/admin/account/password"><strong>修改密碼</strong><span>更新目前登入帳號的密碼</span></a><a data-finder-item data-section="settings" href="/admin/email-domain"><strong>Email 寄件設定</strong><span>檢查回訪信的寄件網域</span></a><a data-finder-item data-section="settings" href="/admin/line/webhooks"><strong>LINE 連線紀錄</strong><span>排查加好友與邀請入帳問題</span></a>
      </section></div><div class="admin-finder-empty" id="admin-finder-empty" hidden>找不到。換一個簡單的關鍵字，或打開「教學」。</div></dialog>
    <% } %>
    <main class="container"><% if (typeof isAdmin !== 'undefined' && isAdmin && user) { %><div class="admin-context" id="admin-page-context" hidden><a href="/admin">工作台</a><span aria-hidden="true">›</span><span class="admin-context-current" id="admin-context-current"></span></div><% } %><%- body %></main>
    <script>(function(){
      var p=location.pathname;var items=Array.prototype.slice.call(document.querySelectorAll('[data-finder-item]'));
      function match(h){return h&&((p===h)||(p.indexOf(h+'/')===0));}
      var current=items.filter(function(a){return match(a.getAttribute('href'));}).sort(function(a,b){return b.getAttribute('href').length-a.getAttribute('href').length;})[0];
      function inferSection(){if(p==='/admin')return'home';if(/^\/admin\/(broadcast|messages|revisit-email|keyword-replies|flows|invite-reminders|richmenu)/.test(p))return'message';if(/^\/admin\/(recipient-lists|users|tag-rules|oa-contacts|restaurants)/.test(p))return'people';if(/^\/admin\/(activities|activity|mgm|coupons|booking-reg|campaign|campaigns|prizes)/.test(p))return'activity';if(/^\/admin\/(insight|reports|campaign-performance|attribution|liff-tracking|referrals|liff\/random-rice|rfm)/.test(p))return'insight';if(/^\/admin\/(accounts|account|email-domain|line\/webhooks)/.test(p))return'settings';return'';}
      var section=current&&current.dataset.section||inferSection();var nav=document.querySelector('[data-admin-section="'+section+'"]');if(nav)nav.classList.add('has-active');var guide=document.querySelector('.admin-guide-link');if(guide&&p==='/admin/guide')guide.classList.add('has-active');
      var context=document.getElementById('admin-page-context'),label=document.getElementById('admin-context-current');if(context&&p!=='/admin'){var title=p==='/admin/guide'?'操作教學':current&&current.querySelector('strong')&&current.querySelector('strong').textContent||document.querySelector('main h1')&&document.querySelector('main h1').textContent||'目前頁面';label.textContent=title;context.hidden=false;if(p!=='/admin/guide'){try{var key='admin_page_history_v2',h=JSON.parse(localStorage.getItem(key)||'[]');h=[{path:p,title:title}].concat(h.filter(function(x){return x&&x.path!==p;})).slice(0,5);localStorage.setItem(key,JSON.stringify(h));}catch(e){}}}
      var dialog=document.getElementById('admin-finder'),trigger=document.getElementById('admin-find-trigger'),close=document.getElementById('admin-finder-close'),input=document.getElementById('admin-finder-input'),empty=document.getElementById('admin-finder-empty');function openFinder(){if(!dialog)return;dialog.showModal();input.value='';filter('');setTimeout(function(){input.focus();},0);}function filter(q){q=String(q||'').trim().toLowerCase();var visible=0;document.querySelectorAll('[data-finder-group]').forEach(function(group){var groupVisible=0;group.querySelectorAll('[data-finder-item]').forEach(function(a){var ok=!q||(a.textContent+' '+group.dataset.category).toLowerCase().indexOf(q)>=0;a.hidden=!ok;if(ok){visible++;groupVisible++;}});group.hidden=groupVisible===0;});if(empty)empty.hidden=visible!==0;}
      if(trigger)trigger.addEventListener('click',openFinder);if(close)close.addEventListener('click',function(){dialog.close();});if(input)input.addEventListener('input',function(){filter(input.value);});document.addEventListener('keydown',function(e){if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();openFinder();}});
      var toggle=document.getElementById('nav-toggle-btn'),topnav=document.getElementById('topbar-nav');if(toggle&&topnav)toggle.addEventListener('click',function(){var opened=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!opened));topnav.classList.toggle('nav-open',!opened);});
    })();</script>
  </body>
</html>
