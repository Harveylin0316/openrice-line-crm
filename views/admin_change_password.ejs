<%-
  include('layout', {
    user: user,
    isAdmin: isAdmin,
    bodyClass: bodyClass,
    body: `
    <section class="card" style="max-width:460px;">
      <h1 style="margin:0 0 4px;">改密碼</h1>
      <p class="muted" style="margin-top:6px;line-height:1.7;">修改你自己（${String(user == null ? '' : user).replace(/[&<>"]/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];})}）的登入密碼。改完下次登入請用新密碼。</p>

      <div class="cp-field">
        <label>目前密碼</label>
        <input type="password" id="cp-current" autocomplete="current-password" />
      </div>
      <div class="cp-field">
        <label>新密碼（至少 8 個字）</label>
        <input type="password" id="cp-new" autocomplete="new-password" />
      </div>
      <div class="cp-field">
        <label>再輸入一次新密碼</label>
        <input type="password" id="cp-confirm" autocomplete="new-password" />
      </div>
      <div style="margin-top:16px;">
        <button type="button" class="cp-primary" id="cp-submit">更新密碼</button>
      </div>
      <div id="cp-msg" class="cp-msg"></div>
    </section>

    <style>
      .cp-field{display:flex;flex-direction:column;gap:5px;margin-top:14px;}
      .cp-field label{font-size:12px;color:#6b7280;font-weight:600;}
      .cp-field input{padding:10px 12px;border:1px solid #ECECEE;border-radius:8px;font-size:14px;font-family:inherit;}
      .cp-primary{padding:10px 20px;background:#FCC726;color:#1f2937;font-weight:700;border:0;border-radius:8px;cursor:pointer;font-size:14px;}
      .cp-primary:disabled{opacity:.5;cursor:not-allowed;}
      .cp-msg{font-size:13px;margin-top:14px;min-height:18px;}
    </style>

    <script>
      (function(){
        var $ = function(id){ return document.getElementById(id); };
        function esc(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
        function showMsg(text, ok){
          $('cp-msg').innerHTML = text ? ('<span style="color:'+(ok?'#15803d':'#b91c1c')+';font-weight:600;">'+esc(text)+'</span>') : '';
        }
        $('cp-submit').addEventListener('click', function(){
          var cur = $('cp-current').value||'';
          var np = $('cp-new').value||'';
          var cf = $('cp-confirm').value||'';
          showMsg('', true);
          if(!cur){ showMsg('請輸入目前密碼', false); return; }
          if(np.length < 8){ showMsg('新密碼至少 8 個字', false); return; }
          if(np !== cf){ showMsg('兩次輸入的新密碼不一樣', false); return; }
          $('cp-submit').disabled = true;
          fetch('/admin/account/password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({currentPassword:cur, newPassword:np})})
            .then(function(r){ return r.json(); })
            .then(function(d){
              $('cp-submit').disabled = false;
              if(!d.ok){ showMsg(d.detail||d.error||'更新失敗', false); return; }
              $('cp-current').value=''; $('cp-new').value=''; $('cp-confirm').value='';
              showMsg('密碼已更新，下次登入請用新密碼', true);
            })
            .catch(function(e){ $('cp-submit').disabled=false; showMsg('錯誤：'+e.message, false); });
        });
      })();
    </script>
    `
  })
%>
