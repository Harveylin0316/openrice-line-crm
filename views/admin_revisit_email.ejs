        $('rv-send').addEventListener('click',function(){if(!state.campaign)return;var limit=Number($('rv-send-limit').value||10);if(!confirm('這會從公司信箱真的寄給最多 '+limit+' 位客人。\\n\\n目前版本已通過測試信，請再確認收件人與內容。'))return;var b=this;b.disabled=true;setMsg('rv-send-msg','正在逐封交給公司信箱，請勿關閉這個頁面…');post('/admin/revisit-email/api/campaigns/'+state.campaign.id+'/send',{limit:limit}).then(function(d){setMsg('rv-send-msg','本次處理：公司信箱已接受 '+number(d.sent)+' 封，明確拒絕 '+number(d.failed)+' 封，結果不確定 '+number(d.needs_review)+' 封，待處理 '+number(d.pending)+' 封。');return loadData().then(function(){return openCampaign(state.campaign.id);});}).catch(function(e){setMsg('rv-send-msg','寄送停止：'+e.message,true);}).finally(updateSendGate);});
        $('rv-close-review').addEventListener('click',function(){$('rv-review').hidden=true;});
        $('rv-as-of').value=todayTaipei();$('rv-as-of').max=todayTaipei();$('rv-sync-to').value=todayTaipei();$('rv-sync-to').max=todayTaipei();$('rv-sync-from').value=shiftDate(todayTaipei(),-180);$('rv-sync-from').max=todayTaipei();loadData();
      })();
