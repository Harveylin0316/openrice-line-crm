<%-
  include('layout', {
    user: user,
    isAdmin: isAdmin,
    bodyClass: bodyClass,
    body: `
    <section class="card campaign-hero">
      <div class="campaign-hero-inner">
        <div class="campaign-hero-text">
          <h1>旅電借電券</h1>
          <p class="muted" style="margin-top:6px;">
            OpenRice × 旅電「1 小時免費借電」活動。好友在官方帳號輸入「借電券」領取序號，到旅電 APP 兌換。
          </p>
          <div class="campaign-meta">
            <span class="campaign-meta-pill" id="lu-window-pill">檔期載入中…</span>
            <span class="campaign-meta-pill" id="lu-status-pill">狀態載入中…</span>
          </div>
        </div>
      </div>
    </section>

    <section class="card">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <h2 style="margin:0;">活動成效</h2>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <a class="lu-btn-sub" href="/admin/coupons">領取明細</a>
          <a class="lu-btn-sub" id="lu-csv" href="/admin/coupons">下載對帳 CSV</a>
          <button type="button" class="lu-btn-sub" id="lu-refresh">重新整理</button>
        </div>
      </div>
      <div id="lu-qa-banner" class="lu-warn" hidden>
        <span id="lu-qa-text"></span>
        <button type="button" class="lu-btn-sub" id="lu-clear-qa" style="margin-left:10px;border-color:#DC2626;color:#DC2626;">清除測試碼</button>
      </div>
      <div class="lu-kpi-grid" id="lu-kpis">
        <div class="lu-kpi"><div class="v" id="k-claimed">—</div><div class="k">累計領取</div></div>
        <div class="lu-kpi"><div class="v" id="k-today">—</div><div class="k">今日領取</div></div>
        <div class="lu-kpi" id="k-available-card"><div class="v" id="k-available">—</div><div class="k">剩餘序號</div></div>
        <div class="lu-kpi"><div class="v" id="k-rate">—</div><div class="k">領取率</div></div>
        <div class="lu-kpi"><div class="v" id="k-newfriends">—</div><div class="k">活動期間新好友</div></div>
        <div class="lu-kpi"><div class="v" id="k-claimers-new">—</div><div class="k">領取者中的新好友</div></div>
      </div>
      <p class="muted" id="lu-forecast" style="font-size:13px;margin-top:10px;line-height:1.6;"></p>

      <h3 class="lu-h3">從卡片到兌換</h3>
      <div class="lu-funnel" id="lu-funnel">
        <div class="lu-fstep"><div class="v" id="f-cards">—</div><div class="k">收到卡片（次）</div></div>
        <div class="lu-farrow" aria-hidden="true"></div>
        <div class="lu-fstep"><div class="v" id="f-opens">—</div><div class="k">打開領取頁（人）</div></div>
        <div class="lu-farrow" aria-hidden="true"></div>
        <div class="lu-fstep"><div class="v" id="f-claims">—</div><div class="k">完成領取（人）</div></div>
        <div class="lu-farrow" aria-hidden="true"></div>
        <div class="lu-fstep"><div class="v" id="f-redeems">—</div><div class="k">點了前往兌換（人）</div></div>
      </div>
      <p class="muted" style="font-size:12px;margin-top:6px;">
        「收到卡片」與「打開領取頁」含同一人重複與內部測試；「實際領取」之後的數字已排除測試碼。「領取者中的新好友」＝領取前 24 小時內才加入官方帳號的人。
      </p>

      <h3 class="lu-h3">每日領取（近 30 天）</h3>
      <div id="lu-daily"><p class="muted">載入中…</p></div>
    </section>

    <section class="card">
      <h2 style="margin:0;">查領取紀錄（客服用）</h2>
      <p class="muted" style="margin-top:6px;">
        用戶說「我領過但找不到序號」時：輸入他的 LINE 名稱（或完整序號），查他領了哪張、什麼時候領的。
      </p>
      <div style="display:flex;gap:8px;margin-top:12px;max-width:480px;">
        <input type="text" id="lu-q" placeholder="LINE 名稱或完整序號" style="flex:1;font-family:inherit;font-size:14px;padding:9px 11px;border:1px solid #ECECEE;border-radius:8px;" />
        <button type="button" class="lu-btn-main" id="lu-q-btn">查詢</button>
      </div>
      <div id="lu-q-result" style="margin-top:12px;"></div>
    </section>

    <section class="card">
      <h2 style="margin:0;">新增優惠序號</h2>
      <p class="muted" style="margin-top:6px;line-height:1.7;">
        旅電給新一批序號時，在這裡補進碼池。<br>
        最快的方式：打開他們給的 Excel，把「兌換碼」那一整欄複製、貼到下面框框。標題列和重複的序號會自動略過，不會弄髒碼池。
      </p>
      <div style="margin-top:12px;display:grid;gap:10px;max-width:560px;">
        <textarea id="lu-codes" rows="6" placeholder="一行一組序號，直接從 Excel 整欄貼上也可以" style="font-family:inherit;font-size:14px;padding:9px 11px;border:1px solid #ECECEE;border-radius:8px;resize:vertical;line-height:1.6;"></textarea>
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
          <input type="file" id="lu-codes-file" accept=".txt,.csv,text/plain,text/csv" />
          <button type="button" class="lu-btn-main" id="lu-upload" disabled>上傳序號</button>
          <span class="muted" id="lu-upload-msg" style="font-size:13px;"></span>
        </div>
      </div>
    </section>

    <section class="card">
      <h2 style="margin:0;">素材與連結</h2>
      <p class="muted" style="margin-top:6px;">做圖文選單、發推播、對外溝通會用到的東西，都在這裡直接複製。</p>
      <div id="lu-links" style="margin-top:12px;"><p class="muted">載入中…</p></div>
    </section>

    <section class="card">
      <h2 style="margin:0;">頁面文案</h2>
      <p class="muted" style="margin-top:6px;line-height:1.7;">
        這些字會直接印在用戶手機上。改完按「儲存文案」，用戶重新整理頁面就會看到新的。<br>
        <a href="/games/claim/ludian-0901?preview=1" target="_blank" rel="noopener">先看看用戶會看到什麼</a>
      </p>
      <div id="lu-copy" style="margin-top:14px;"><p class="muted">載入中…</p></div>
      <div style="display:flex;gap:8px;align-items:center;margin-top:14px;flex-wrap:wrap;">
        <button type="button" class="lu-btn-main" id="lu-copy-save">儲存文案</button>
        <span id="lu-copy-note" class="muted" style="font-size:13px;"></span>
      </div>
    </section>

    <section class="card">
      <h2 style="margin:0;">檔期設定</h2>
      <p class="muted" style="margin-top:6px;line-height:1.7;">
        設定好時間後，時間到了會<b>自動開放、自動截止</b>，不用半夜手動按。<br>
        時間以你電腦目前的時區輸入（台灣同事直接填台灣時間即可）。
      </p>
      <div class="lu-form">
        <label class="lu-field">
          <span>開始時間</span>
          <input type="datetime-local" id="lu-start" />
        </label>
        <label class="lu-field">
          <span>結束時間</span>
          <input type="datetime-local" id="lu-end" />
        </label>
        <div>
          <button type="button" class="lu-btn-main" id="lu-save-window">儲存檔期</button>
          <span class="muted" id="lu-window-msg" style="font-size:13px;margin-left:10px;"></span>
        </div>
      </div>

      <hr style="border:0;border-top:1px solid #ECECEE;margin:20px 0;" />

      <h2 style="margin:0;">上架／下架</h2>
      <p class="muted" style="margin-top:6px;line-height:1.7;" id="lu-status-desc">載入中…</p>
      <div style="margin-top:12px;">
        <button type="button" class="lu-btn-main" id="lu-toggle" disabled>載入中…</button>
        <span class="muted" id="lu-status-msg" style="font-size:13px;margin-left:10px;"></span>
      </div>
      <p class="muted" style="font-size:12px;margin-top:10px;line-height:1.7;">
        上架 = 好友輸入「借電券」會收到領取卡片、領取頁開放發碼（實際可領時間仍以上方檔期為準）。<br>
        下架 = 卡片停止回覆、領取頁停止發碼。已領走的序號不受影響。
      </p>
    </section>

    <style>
      .lu-btn-sub{padding:6px 12px;background:#fff;border:1px solid #ECECEE;border-radius:6px;font-size:12px;cursor:pointer;color:#374151;text-decoration:none;display:inline-block;}
      .lu-btn-main{padding:10px 18px;background:#FCC726;color:#1f2937;font-weight:700;border:none;border-radius:8px;cursor:pointer;font-size:14px;}
      .lu-btn-main:disabled{opacity:.5;cursor:not-allowed;}
      .lu-btn-main.lu-danger{background:#fff;border:1.5px solid #DC2626;color:#DC2626;}
      .lu-kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-top:14px;}
      .lu-kpi{border:1px solid #ECECEE;border-radius:10px;padding:14px;background:#FAFAFA;text-align:center;}
      .lu-kpi .v{font-size:24px;font-weight:700;color:#1f2937;font-variant-numeric:tabular-nums;}
      .lu-kpi .k{font-size:12px;color:#6B6B70;margin-top:3px;}
      .lu-h3{font-size:14px;font-weight:700;color:#1f2937;margin:20px 0 8px;}
      .lu-funnel{display:flex;align-items:stretch;gap:8px;flex-wrap:wrap;}
      .lu-fstep{flex:1;min-width:110px;border:1px solid #ECECEE;border-radius:10px;padding:12px;background:#FFFBEB;text-align:center;}
      .lu-fstep .v{font-size:20px;font-weight:700;color:#1f2937;font-variant-numeric:tabular-nums;}
      .lu-fstep .k{font-size:12px;color:#6B6B70;margin-top:3px;}
      .lu-farrow{width:0;height:0;border-top:5px solid transparent;border-bottom:5px solid transparent;border-left:6px solid #c4c4c8;align-self:center;}
      .lu-warn{margin-top:12px;padding:12px 14px;border:1.5px solid #FCC726;background:#FFFBEB;border-radius:10px;font-size:13px;color:#1f2937;line-height:1.6;}
      .lu-kpi.lu-low{border-color:#DC2626;background:#FEF2F2;}
      .lu-kpi.lu-low .v{color:#DC2626;}
      .lu-link-row{display:flex;align-items:center;gap:8px;padding:9px 0;border-bottom:1px solid #F4F4F6;flex-wrap:wrap;}
      .lu-link-row .lbl{flex:0 0 110px;font-size:13px;font-weight:600;color:#1f2937;}
      .lu-link-row code{flex:1;min-width:200px;font-size:12px;color:#374151;background:#FAFAFA;border:1px solid #ECECEE;border-radius:6px;padding:6px 9px;word-break:break-all;}
      .lu-q-table{width:100%;border-collapse:collapse;font-size:12.5px;}
      .lu-q-table th{text-align:left;color:#6B6B70;font-weight:600;padding:5px 8px;border-bottom:1px solid #ECECEE;white-space:nowrap;}
      .lu-q-table td{padding:5px 8px;border-bottom:1px solid #F4F4F6;color:#1f2937;font-variant-numeric:tabular-nums;}
      .lu-daily-table{width:100%;border-collapse:collapse;font-size:12.5px;}
      .lu-daily-table td{padding:4px 8px;border-bottom:1px solid #F4F4F6;color:#1f2937;font-variant-numeric:tabular-nums;}
      .lu-bar{display:inline-block;height:10px;background:#FCC726;border-radius:3px;vertical-align:middle;margin-right:6px;}
      .lu-form{display:grid;gap:12px;max-width:420px;margin-top:14px;}
      .lu-field{display:flex;flex-direction:column;gap:5px;}
      .lu-field span{font-size:13px;font-weight:600;color:#1f2937;}
      .lu-field input{font-family:inherit;font-size:14px;padding:9px 11px;border:1px solid #ECECEE;border-radius:8px;color:#1f2937;background:#fff;}
      .campaign-meta-pill--live{background:#DCFCE7;color:#166534;border-color:#BBF7D0;}
      .campaign-meta-pill--off{background:#F4F4F6;color:#6B6B70;}
      .lu-copy-g{border:1px solid #ECECEE;border-radius:10px;margin-bottom:10px;background:#fff;}
      .lu-copy-g summary{cursor:pointer;padding:11px 14px;font-size:14px;font-weight:600;color:#1f2937;
        list-style:none;display:flex;align-items:center;gap:8px;}
      .lu-copy-g summary::-webkit-details-marker{display:none;}
      .lu-copy-g summary::before{content:'▸';color:#9CA3AF;font-size:12px;}
      .lu-copy-g[open] summary::before{content:'▾';}
      .lu-copy-g summary .n{margin-left:auto;font-size:12px;font-weight:400;color:#9CA3AF;}
      .lu-copy-g .lu-copy-grid{padding:4px 14px 16px;}
      .lu-copy-grid{display:grid;gap:14px;}
      .lu-copy-f{display:flex;flex-direction:column;gap:5px;}
      .lu-copy-f label{font-size:13px;font-weight:600;color:#1f2937;}
      .lu-copy-f .h{font-size:12px;color:#86868B;}
      .lu-copy-f input,.lu-copy-f textarea{font-family:inherit;font-size:14px;padding:9px 11px;
        border:1px solid #ECECEE;border-radius:8px;color:#1f2937;background:#fff;width:100%;box-sizing:border-box;}
      .lu-copy-f textarea{min-height:96px;line-height:1.8;resize:vertical;}
      .lu-copy-f input:focus,.lu-copy-f textarea:focus{outline:2px solid #FCC72655;border-color:#FCC726;}
      [hidden]{display:none !important;}
    </style>

    <script>
      (function(){
        var $=function(id){return document.getElementById(id);};
        var overview=null;

        function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
        function pad(n){return String(n).padStart(2,'0');}
        function toLocalDt(ts){
          if(!ts)return '';
          var d=new Date(ts);
          if(isNaN(d.getTime()))return '';
          return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T'+pad(d.getHours())+':'+pad(d.getMinutes());
        }
        function fmtDt(ts){
          if(!ts)return '未設定';
          var d=new Date(ts);
          if(isNaN(d.getTime()))return '未設定';
          return (d.getMonth()+1)+'/'+d.getDate()+' '+pad(d.getHours())+':'+pad(d.getMinutes());
        }

        function stateOf(a){
          var now=Date.now();
          if(a.status!=='active')return {key:'off',label:'未上架',desc:'活動目前是下架狀態：好友輸入「借電券」不會有回應，領取頁也不發碼。按下方「上架」即可開放。'};
          if(a.start_at&&now<new Date(a.start_at).getTime())return {key:'scheduled',label:'已排程・'+fmtDt(a.start_at)+' 自動開始',desc:'活動已上架，但還沒到開始時間。時間一到會自動開放領取，不用再操作。'};
          if(a.end_at&&now>new Date(a.end_at).getTime())return {key:'ended',label:'已結束',desc:'活動已超過結束時間，領取已自動截止。若要延長，改結束時間後儲存即可。'};
          return {key:'live',label:'進行中',desc:'活動開放中：好友輸入「借電券」會收到卡片，可以領取序號。'};
        }

        function render(){
          var a=overview.activity, pool=overview.pool, f=overview.funnel, qa=overview.qa;
          $('lu-window-pill').textContent='檔期 '+fmtDt(a.start_at)+' 到 '+fmtDt(a.end_at);
          var st=stateOf(a);
          var pill=$('lu-status-pill');
          pill.textContent=st.label;
          pill.className='campaign-meta-pill '+(st.key==='live'?'campaign-meta-pill--live':(st.key==='scheduled'?'':'campaign-meta-pill--off'));
          $('lu-status-desc').textContent=st.desc;

          $('k-claimed').textContent=Number(pool.claimed||0).toLocaleString();
          $('k-today').textContent=Number(pool.today_claims||0).toLocaleString();
          $('k-available').textContent=Number(pool.available||0).toLocaleString();
          $('k-rate').textContent=pool.total>0?Math.round(pool.claimed/pool.total*100)+'%':'—';

          $('f-cards').textContent=Number(f.card_sends||0).toLocaleString();
          $('f-opens').textContent=Number(f.opens||0).toLocaleString();
          $('f-claims').textContent=Number(f.claimers||0).toLocaleString();
          $('f-redeems').textContent=Number(f.redeem_clickers||0).toLocaleString();

          var g=overview.growth||{};
          $('k-newfriends').textContent=Number(g.new_friends||0).toLocaleString();
          var cn=Number(g.claimers_new||0), ct=Number(f.claimers||0);
          $('k-claimers-new').textContent=ct>0?(cn.toLocaleString()+'（'+Math.round(cn/ct*100)+'%）'):'—';

          // 剩餘量預警：低於 10% 整張卡變紅
          var lowStock=pool.total>0&&(pool.available/pool.total)<0.1;
          $('k-available-card').className='lu-kpi'+(lowStock?' lu-low':'');

          // 碼量預測：近 7 天平均日領取 → 推發完日或結束時剩量
          var fc=$('lu-forecast');
          var avg=(overview.forecast&&overview.forecast.last7_claims||0)/7;
          if(avg<=0){
            fc.textContent=st.key==='live'?'還沒有足夠的領取資料可以預測發完時間。':'活動開始累積領取後，這裡會顯示「照目前速度哪天發完」的預測。';
          }else{
            var daysLeft=pool.available/avg;
            var depleteMs=Date.now()+daysLeft*86400000;
            var endMs=a.end_at?new Date(a.end_at).getTime():null;
            var avgTxt=(Math.round(avg*10)/10);
            if(endMs&&depleteMs>endMs){
              var daysToEnd=Math.max(0,(endMs-Date.now())/86400000);
              var leftover=Math.max(0,Math.round(pool.available-avg*daysToEnd));
              fc.textContent='照近 7 天速度（每天約 '+avgTxt+' 張），到活動結束預計還會剩 '+leftover.toLocaleString()+' 張。';
            }else{
              var dd=new Date(depleteMs);
              fc.textContent='照近 7 天速度（每天約 '+avgTxt+' 張），預計 '+(dd.getMonth()+1)+'/'+dd.getDate()+' 就會發完。想撐到活動結束，要提早跟旅電談加碼或放慢曝光。';
            }
          }

          var banner=$('lu-qa-banner');
          if(qa&&Number(qa.total||0)>0){
            $('lu-qa-text').textContent='碼池裡還有 '+qa.total+' 張測試碼（剩 '+qa.available+' 張未領），會排在真碼前面被優先發出。正式開跑前要先清除。';
            banner.hidden=false;
          }else{
            banner.hidden=true;
          }

          var L=overview.links||{};
          var lb=$('lu-links');
          function linkRow(label,val,extra){
            if(!val)return '';
            return '<div class="lu-link-row"><span class="lbl">'+esc(label)+'</span><code>'+esc(val)+'</code>'+
              '<button type="button" class="lu-btn-sub" data-copy="'+esc(val)+'">複製</button>'+(extra||'')+'</div>';
          }
          lb.innerHTML=
            linkRow('領券頁連結',L.liff_url)+
            linkRow('觸發關鍵字',L.keyword,'<span class="muted" style="font-size:12px;">圖文選單按鈕動作設「發送文字：'+esc(L.keyword||'')+'」</span>')+
            '<div class="lu-link-row"><span class="lbl">優惠券卡片</span><code>訊息庫 #'+esc(L.template_id||'')+'「旅電借電券卡片」</code><a class="lu-btn-sub" href="/admin/messages">開啟訊息庫</a></div>'+
            linkRow('兌換網址',L.redeem_url,'<a class="lu-btn-sub" href="'+esc(L.redeem_url||'#')+'" target="_blank" rel="noopener">打開看看</a>');
          var copies=lb.querySelectorAll('[data-copy]');
          for(var ci=0;ci<copies.length;ci++){
            copies[ci].addEventListener('click',function(){
              var t=this.getAttribute('data-copy'),self=this;
              if(navigator.clipboard&&navigator.clipboard.writeText){
                navigator.clipboard.writeText(t).then(function(){self.textContent='已複製';setTimeout(function(){self.textContent='複製';},1500);});
              }
            });
          }

          if(overview.prize_id!=null){
            $('lu-csv').setAttribute('href','/admin/coupons/export.csv?activity_id='+encodeURIComponent(a.id)+'&prize_id='+encodeURIComponent(overview.prize_id));
          }

          if(!$('lu-start').value)$('lu-start').value=toLocalDt(a.start_at);
          if(!$('lu-end').value)$('lu-end').value=toLocalDt(a.end_at);

          var btn=$('lu-toggle');
          btn.disabled=false;
          if(a.status==='active'){
            btn.textContent='下架（暫停領取）';
            btn.className='lu-btn-main lu-danger';
          }else{
            btn.textContent='上架（開放領取）';
            btn.className='lu-btn-main';
          }

          var daily=overview.daily||[];
          var box=$('lu-daily');
          if(daily.length===0){
            box.innerHTML='<p class="muted" style="font-size:12.5px;">還沒有領取紀錄。</p>';
          }else{
            var max=0,i;
            for(i=0;i<daily.length;i++){if(daily[i].claims>max)max=daily[i].claims;}
            var h='<table class="lu-daily-table"><tbody>';
            for(i=0;i<daily.length;i++){
              var w=max>0?Math.max(4,Math.round(daily[i].claims/max*180)):4;
              h+='<tr><td style="white-space:nowrap;width:60px;">'+esc(daily[i].d)+'</td>'+
                 '<td><span class="lu-bar" style="width:'+w+'px;"></span>'+Number(daily[i].claims||0)+'</td></tr>';
            }
            h+='</tbody></table>';
            box.innerHTML=h;
          }
        }

        function loadOverview(){
          fetch('/admin/campaigns/ludian/api/overview').then(function(r){return r.json();}).then(function(d){
            if(!d.ok){$('lu-daily').innerHTML='<p class="muted">載入失敗：'+esc(d.detail||d.error||'')+'</p>';return;}
            overview=d;
            render();
          }).catch(function(){$('lu-daily').innerHTML='<p class="muted">載入失敗，請重新整理</p>';});
        }

        $('lu-refresh').addEventListener('click',function(){loadOverview();});

        $('lu-save-window').addEventListener('click',function(){
          var sv=$('lu-start').value, ev=$('lu-end').value, msg=$('lu-window-msg');
          if(!sv||!ev){msg.textContent='開始與結束時間都要填。';return;}
          var s=new Date(sv), e=new Date(ev);
          if(isNaN(s.getTime())||isNaN(e.getTime())){msg.textContent='時間格式不正確。';return;}
          if(e<=s){msg.textContent='結束時間必須晚於開始時間。';return;}
          msg.textContent='儲存中…';
          fetch('/admin/campaigns/ludian/api/window',{
            method:'POST',headers:{'Content-Type':'application/json'},
            body:JSON.stringify({start_at:s.toISOString(),end_at:e.toISOString()})
          }).then(function(r){return r.json();}).then(function(d){
            if(!d.ok){msg.textContent='儲存失敗：'+(d.detail||d.error||'');return;}
            msg.textContent='已儲存。';
            overview.activity=d.activity;
            render();
          }).catch(function(){msg.textContent='連線錯誤，請再試一次。';});
        });

        $('lu-toggle').addEventListener('click',function(){
          if(!overview)return;
          var a=overview.activity, msg=$('lu-status-msg');
          var goingActive=a.status!=='active';
          var confirmText=goingActive
            ?'確定要上架嗎？\\n\\n上架後：好友輸入「借電券」會收到領取卡片。\\n實際可領取的時間仍以檔期為準（'+fmtDt(a.start_at)+' 到 '+fmtDt(a.end_at)+'）。'
            :'確定要下架嗎？\\n\\n下架後：卡片停止回覆、領取頁停止發碼。\\n已領走的序號不受影響，之後可以隨時再上架。';
          if(!window.confirm(confirmText))return;
          msg.textContent='處理中…';
          fetch('/admin/campaigns/ludian/api/status',{
            method:'POST',headers:{'Content-Type':'application/json'},
            body:JSON.stringify({status:goingActive?'active':'draft'})
          }).then(function(r){return r.json();}).then(function(d){
            if(!d.ok){msg.textContent='操作失敗：'+(d.detail||d.error||'');return;}
            msg.textContent=goingActive?'已上架。':'已下架。';
            overview.activity=d.activity;
            render();
          }).catch(function(){msg.textContent='連線錯誤，請再試一次。';});
        });

        // ── 新增序號（活動/獎品自動綁定，行銷不用選） ──
        // 只收「像序號」的行：英數與 - _，4–64 字。中文標題列、空行自動略過。
        function parseCodes(){
          var raw=$('lu-codes').value||'';
          var lines=raw.split(/\\r?\\n/);
          var out=[],seen={},skipped=0;
          for(var i=0;i<lines.length;i++){
            var c=(lines[i]||'').trim();
            if(!c)continue;
            if(!/^[A-Za-z0-9_-]{4,64}$/.test(c)){skipped++;continue;}
            if(seen[c])continue;
            seen[c]=1;out.push(c);
          }
          return {codes:out,skipped:skipped};
        }
        function syncUpload(){
          var p=parseCodes();
          $('lu-upload').disabled=!(p.codes.length>0&&overview&&overview.prize_id!=null);
          if(p.codes.length>0){
            $('lu-upload-msg').textContent='偵測到 '+p.codes.length.toLocaleString()+' 組序號'+(p.skipped>0?('，另有 '+p.skipped+' 行不像序號會略過'):'');
          }else if((($('lu-codes').value)||'').trim()){
            $('lu-upload-msg').textContent='沒有偵測到序號（一行一組，只接受英數字）。';
          }else{
            $('lu-upload-msg').textContent='';
          }
        }
        $('lu-codes').addEventListener('input',syncUpload);
        $('lu-codes-file').addEventListener('change',function(){
          var f=this.files&&this.files[0];
          if(!f)return;
          var reader=new FileReader();
          reader.onload=function(){
            var existing=$('lu-codes').value.trim();
            var add=String(reader.result||'');
            $('lu-codes').value=existing?(existing+'\\n'+add):add;
            syncUpload();
          };
          reader.onerror=function(){$('lu-upload-msg').textContent='讀檔失敗。若是 Excel 檔，請開啟後複製序號欄貼上。';};
          reader.readAsText(f);
        });
        $('lu-upload').addEventListener('click',function(){
          if(!overview||overview.prize_id==null)return;
          var p=parseCodes();
          if(p.codes.length===0)return;
          var aid=overview.activity.id,pid=overview.prize_id;
          var btn=$('lu-upload'),msg=$('lu-upload-msg');
          btn.disabled=true;
          var CHUNK=1000,total=p.codes.length,done=0,ins=0,skip=0;
          function sendNext(){
            if(done>=total){
              msg.textContent='完成！新增 '+ins.toLocaleString()+' 組，略過重複 '+skip.toLocaleString()+' 組。';
              $('lu-codes').value='';
              btn.disabled=false;
              loadOverview();
              return;
            }
            var slice=p.codes.slice(done,done+CHUNK);
            fetch('/admin/coupons/api/upload-chunk',{
              method:'POST',headers:{'Content-Type':'application/json'},
              body:JSON.stringify({activity_id:aid,prize_id:pid,codes:slice,source:'hub上傳'})
            }).then(function(r){return r.json();}).then(function(d){
              if(!d.ok){msg.textContent='上傳失敗：'+(d.detail||d.error||'');btn.disabled=false;return;}
              ins+=(d.inserted||0);skip+=(d.skipped||0);done+=slice.length;
              msg.textContent='上傳中… '+done.toLocaleString()+' / '+total.toLocaleString();
              setTimeout(sendNext,30);
            }).catch(function(){msg.textContent='連線錯誤，請再試一次。';btn.disabled=false;});
          }
          msg.textContent='上傳中…';
          sendNext();
        });

        // ── 客服查詢 ──
        function runLookup(){
          var q=($('lu-q').value||'').trim(), box=$('lu-q-result');
          if(q.length<2){box.innerHTML='<p class="muted">至少輸入 2 個字。</p>';return;}
          box.innerHTML='<p class="muted">查詢中…</p>';
          fetch('/admin/campaigns/ludian/api/lookup?q='+encodeURIComponent(q))
            .then(function(r){return r.json();}).then(function(d){
              if(!d.ok){box.innerHTML='<p class="muted">查詢失敗：'+esc(d.detail||d.error||'')+'</p>';return;}
              var rs=d.results||[];
              if(rs.length===0){box.innerHTML='<p class="muted">查無資料。提醒：序號要輸入完整才查得到；名稱可以只輸入一部分。</p>';return;}
              var h='<table class="lu-q-table"><thead><tr><th>用戶</th><th>序號</th><th>領取時間</th><th>狀態</th></tr></thead><tbody>';
              for(var i=0;i<rs.length;i++){
                var r=rs[i];
                var stTxt=(r.status==='redeemed'?'已核銷':'已發出')+(r.redeem_clicked?'・點過前往兌換':'');
                h+='<tr><td>'+(r.display_name?esc(r.display_name):'<span class="muted">—</span>')+'</td>'+
                   '<td>'+esc(r.code)+'</td>'+
                   '<td style="white-space:nowrap;">'+esc(fmtDt(r.claimed_at))+'</td>'+
                   '<td>'+stTxt+'</td></tr>';
              }
              h+='</tbody></table>';
              box.innerHTML=h;
            }).catch(function(){box.innerHTML='<p class="muted">連線錯誤，請再試一次。</p>';});
        }
        $('lu-q-btn').addEventListener('click',runLookup);
        $('lu-q').addEventListener('keydown',function(e){if(e.key==='Enter')runLookup();});

        // ── 頁面文案：讀出來、改完存回去 ──
        var COPY_FIELDS=[];
        function esc2(x){return String(x==null?'':x).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
        function loadCopy(){
          fetch('/admin/campaigns/ludian/api/copy').then(function(r){return r.json();}).then(function(d){
            var box=$('lu-copy');
            if(!d.ok){box.innerHTML='<p class="muted">載入失敗，重新整理看看</p>';return;}
            COPY_FIELDS=d.fields||[];
            // 四十幾個欄位平鋪會看不下去——依用途分組，一次展開一組
            var groups=[];
            COPY_FIELDS.forEach(function(f){
              var g=f.g||'其他';
              var hit=null;
              groups.forEach(function(x){if(x.name===g)hit=x;});
              if(!hit){hit={name:g,items:[]};groups.push(hit);}
              hit.items.push(f);
            });
            box.innerHTML=groups.map(function(g,gi){
              var inner=g.items.map(function(f){
                var v=(d.values&&d.values[f.key])||'';
                var input=f.type==='list'
                  ? '<textarea id="cp-'+f.key+'" placeholder="一行一項">'+esc2(v)+'</textarea>'
                  : '<input type="text" id="cp-'+f.key+'" value="'+esc2(v)+'" maxlength="'+f.max+'">';
                return '<div class="lu-copy-f"><label for="cp-'+f.key+'">'+esc2(f.label)+'</label>'+
                       input+(f.hint?('<span class="h">'+esc2(f.hint)+'</span>'):'')+'</div>';
              }).join('');
              return '<details class="lu-copy-g"'+(gi===0?' open':'')+'>'+
                     '<summary>'+esc2(g.name)+'<span class="n">'+g.items.length+' 項</span></summary>'+
                     '<div class="lu-copy-grid">'+inner+'</div></details>';
            }).join('');
          }).catch(function(){$('lu-copy').innerHTML='<p class="muted">連線錯誤</p>';});
        }
        $('lu-copy-save').addEventListener('click',function(){
          if(!COPY_FIELDS.length)return;
          var btn=this;btn.disabled=true;
          var note=$('lu-copy-note');note.textContent='儲存中…';
          var body={};
          COPY_FIELDS.forEach(function(f){
            var el=$('cp-'+f.key); if(el)body[f.key]=el.value;
          });
          fetch('/admin/campaigns/ludian/api/copy',{method:'POST',
            headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
            .then(function(r){return r.json();}).then(function(d){
              btn.disabled=false;
              note.textContent=d.ok?'已儲存。用戶重新整理頁面就會看到新的文案。':('沒有成功：'+(d.detail||d.error||''));
            }).catch(function(){btn.disabled=false;note.textContent='連線錯誤，再試一次';});
        });
        loadCopy();

        // ── 清除測試碼（雙重確認） ──
        $('lu-clear-qa').addEventListener('click',function(){
          if(!overview)return;
          var qa=overview.qa||{};
          if(!window.confirm('確定要清除測試碼嗎？\\n\\n會刪除 '+(qa.total||0)+' 張 ORTESTQA 測試碼與測試領取紀錄。\\n清除後，用戶領到的每一張都會是旅電真碼。'))return;
          if(!window.confirm('再確認一次：清除後無法復原，正式開跑前才需要做這件事。\\n\\n現在就清除？'))return;
          fetch('/admin/campaigns/ludian/api/clear-test-codes',{method:'POST'})
            .then(function(r){return r.json();}).then(function(d){
              if(!d.ok){window.alert('清除失敗：'+(d.detail||d.error||''));return;}
              window.alert('已清除 '+d.removed_codes+' 張測試碼、'+d.removed_plays+' 筆測試領取紀錄。');
              loadOverview();
            }).catch(function(){window.alert('連線錯誤，請再試一次。');});
        });

        loadOverview();
      })();
    </script>
    `
  })
