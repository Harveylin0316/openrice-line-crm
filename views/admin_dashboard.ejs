<%- include('layout', { user:user, isAdmin:isAdmin, bodyClass:bodyClass, title:'工作台', body: `
  <section class="card db-alert" id="db-alert" hidden><div class="db-alert-head"><span class="db-alert-dot"></span><h2>需要你處理</h2></div><div id="db-alert-items"></div></section>

  <section class="card db-home">
    <h1>今天要做什麼？</h1>
    <div class="db-primary-grid">
      <a class="db-primary-task" href="/admin/broadcast"><span class="db-icon">↗</span><strong>傳訊息給顧客</strong><small>選人、預覽、測試、送出</small></a>
      <a class="db-primary-task" href="/admin/activities"><span class="db-icon">★</span><strong>管理活動</strong><small>設定活動、獎項與前台</small></a>
      <a class="db-primary-task" href="/admin/insight"><span class="db-icon">⌁</span><strong>看成效</strong><small>好友、訊息、活動與來源</small></a>
    </div>
    <div class="db-secondary"><a href="/admin/recipient-lists">顧客名單</a><a href="/admin/flows">自動傳訊</a><button type="button" id="db-all-features">全部功能</button></div>
  </section>

  <section class="card db-recent" id="db-recent" hidden><h2>繼續上次工作</h2><div id="db-recent-list"></div></section>

  <section class="card">
    <h2 class="db-overview-title">目前概況</h2>
    <div class="db-stats">
      <div class="db-stat"><div class="v" id="st-friends">—</div><div class="k">可發送好友</div></div>
      <div class="db-stat"><div class="v" id="st-friends7">—</div><div class="k">近 7 天新好友</div></div>
      <div class="db-stat"><div class="v" id="st-activities">—</div><div class="k">進行中活動</div></div>
      <div class="db-stat"><div class="v" id="st-flows">—</div><div class="k">運作中自動傳訊</div></div>
      <div class="db-stat db-stat-wide"><div class="v db-last" id="st-last">—</div><div class="k">最近一次發送</div></div>
    </div>
  </section>

  <details class="card db-more-data">
    <summary>查看其他資料</summary>
    <div class="db-more-section"><div class="db-section-head"><h2>活動頁使用情況</h2><a href="/admin/liff/random-rice">完整分析</a></div><div class="db-stats" id="db-liff-stats"><div class="db-stat"><div class="v" id="st-liff-opens">—</div><div class="k">近 7 天開啟</div></div><div class="db-stat"><div class="v" id="st-liff-users">—</div><div class="k">使用人數</div></div><div class="db-stat"><div class="v" id="st-liff-members">—</div><div class="k">其中是 LINE 好友</div></div></div><p class="db-foot" id="db-liff-foot" hidden></p></div>
    <div class="db-more-section"><div class="db-section-head"><h2>訂位來源</h2><form id="booking-range" class="db-range"><label>從 <input type="date" id="booking-from"></label><label>到 <input type="date" id="booking-to"></label><button type="submit">套用</button><button type="button" id="booking-all">全部</button></form></div><div class="db-stats" id="db-src-stats" hidden><div class="db-stat"><div class="v" id="st-src-total">—</div><div class="k">回答過的人</div></div><div class="db-stat"><div class="v" id="st-src-current">—</div><div class="k">目前仍是好友</div></div></div><div class="db-src-list" id="db-src-list" hidden></div><p class="db-foot" id="db-src-foot" hidden></p></div>
  </details>

  <style>
    .db-home h1{margin:0 0 18px;font-size:24px}.db-primary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.db-primary-task{display:grid;grid-template-columns:42px 1fr;column-gap:12px;align-items:center;min-height:104px;padding:16px;border:1px solid #e5dfdb;border-radius:13px;color:#302522;text-decoration:none;background:#fff;transition:.15s}.db-primary-task:hover{border-color:#e4b817;box-shadow:0 6px 16px rgba(50,35,20,.07);transform:translateY(-1px);text-decoration:none}.db-primary-task strong{font-size:16px}.db-primary-task small{grid-column:2;color:#7c706b;font-size:12px}.db-icon{grid-row:1/3;display:flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:12px;background:#fff5ca;color:#493a15;font-size:22px;font-weight:800}.db-secondary{display:flex;align-items:center;gap:10px;margin-top:14px;flex-wrap:wrap}.db-secondary a,.db-secondary button{padding:7px 12px;border:1px solid #ddd7d3;border-radius:999px;background:#fff;color:#4d403b;font:inherit;font-size:12px;font-weight:700;text-decoration:none;cursor:pointer}.db-secondary a:hover,.db-secondary button:hover{border-color:#b99721;background:#fffaf0;text-decoration:none}
    .db-alert{border-color:#fca5a5!important;background:#fef2f2}.db-alert[hidden]{display:none!important}.db-alert-head{display:flex;align-items:center;gap:8px}.db-alert-head h2{margin:0 0 10px;font-size:16px;color:#991b1b}.db-alert-dot{width:9px;height:9px;border-radius:50%;background:#e11d27}.db-alert-item{display:flex;justify-content:space-between;gap:12px;padding:9px 11px;margin-top:7px;border:1px solid #fecaca;border-radius:8px;background:#fff;font-size:13px}.db-alert-item a{color:#6f4a00;font-weight:700}
    .db-recent h2,.db-overview-title{margin:0 0 12px;font-size:15px;color:#51433e}.db-recent-list{display:flex;gap:8px;flex-wrap:wrap}.db-recent-list a{padding:9px 12px;border:1px solid #e5dfdb;border-radius:9px;color:#302522;font-size:13px;font-weight:650;text-decoration:none}.db-recent-list a:hover{border-color:#d4aa11;background:#fffaf0;text-decoration:none}
    .db-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px}.db-stat{border:1px solid #ececee;border-radius:10px;padding:14px;background:#fafafa}.db-stat .v{font-size:26px;font-weight:750;color:#1f2937;font-variant-numeric:tabular-nums}.db-stat .k{font-size:12px;color:#6b6b70;margin-top:4px}.db-stat-wide{grid-column:span 2}.db-stat .db-last{font-size:15px;line-height:1.5}
    .db-more-data{padding:0!important;overflow:hidden}.db-more-data>summary{padding:17px 20px;cursor:pointer;font-weight:750;color:#51433e;list-style:none}.db-more-data>summary::-webkit-details-marker{display:none}.db-more-data>summary::after{content:'＋';float:right;color:#8a7f7a}.db-more-data[open]>summary::after{content:'－'}.db-more-data[open]>summary{border-bottom:1px solid #eee9e6}.db-more-section{padding:20px}.db-more-section+.db-more-section{border-top:1px solid #eee9e6}.db-section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.db-section-head h2{margin:0;font-size:16px}.db-section-head>a{color:#6f4a00;font-size:12px;font-weight:700}.db-range{display:flex;gap:7px;align-items:center;flex-wrap:wrap;font-size:12px}.db-range input,.db-range button{padding:6px 8px;border:1px solid #d1d5db;border-radius:7px;background:#fff}.db-range button{cursor:pointer;font-weight:650}.db-range button[type=submit]{background:#fcc726;border-color:#fcc726}.db-foot{font-size:13px;color:#6b6b70;line-height:1.7;margin:14px 0 0}.db-foot[hidden],#db-liff-stats[hidden],#db-src-stats[hidden],.db-src-list[hidden]{display:none!important}.db-src-list{margin-top:14px;border-top:1px solid #ececee}.db-src-row{display:flex;align-items:center;gap:12px;padding:10px 2px;border-bottom:1px solid #ececee}.db-src-name{flex:1;min-width:0;display:flex;flex-direction:column}.db-src-name .t{font-size:13px;font-weight:650}.db-src-name .s{font-size:11px;color:#9ca3af}.db-src-n,.db-src-pct{font-size:13px;white-space:nowrap}.db-src-pct{width:44px;text-align:right;color:#6b6b70}
    @media(max-width:700px){.db-primary-grid{grid-template-columns:1fr}.db-primary-task{min-height:84px}.db-stat-wide{grid-column:auto}.db-stats{grid-template-columns:1fr 1fr}.db-section-head{align-items:flex-start;flex-direction:column}}
  </style>

  <script>(function(){
    function $(id){return document.getElementById(id)}function num(v){return Number(v||0).toLocaleString()}function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
    function renderRecent(){var box=$('db-recent'),list=$('db-recent-list');try{var h=JSON.parse(localStorage.getItem('admin_page_history_v2')||'[]');if(!Array.isArray(h)||!h.length)return;list.className='db-recent-list';list.innerHTML=h.slice(0,3).map(function(x){return '<a href="'+esc(x.path)+'">'+esc(x.title)+'</a>'}).join('');box.hidden=false}catch(e){}}
    renderRecent();var all=$('db-all-features');if(all)all.addEventListener('click',function(){var t=$('admin-find-trigger');if(t)t.click()});
    function loadDashboard(query){fetch('/admin/api/dashboard'+(query||'')).then(function(r){return r.json()}).then(function(d){if(!d.ok)return;var s=d.stats||{};$('st-friends').textContent=num(s.friends);$('st-friends7').textContent='+'+num(s.friends_7d);$('st-activities').textContent=num(s.active_activities);$('st-flows').textContent=num(s.active_flows);var lb=d.lastBroadcast;if(lb){var when=new Date(lb.created_at).toLocaleDateString('zh-TW',{month:'numeric',day:'numeric'});var map={done:'已完成',sending:'發送中',running:'發送中',scheduled:'已排程',failed:'有失敗'};$('st-last').innerHTML=when+' · '+(map[lb.status]||lb.status)+'<br>'+num(lb.recipient_ok)+' / '+num(lb.recipient_total)+' 送達'}else{$('st-last').textContent='還沒發過訊息'}renderAlerts(d.alerts||{});renderLiff(d.liff);renderBookingSource(d.booking)}).catch(function(){})}
    loadDashboard('');$('booking-range').addEventListener('submit',function(e){e.preventDefault();var f=$('booking-from').value,t=$('booking-to').value;if(!f||!t){alert('請同時選開始日與結束日');return}loadDashboard('?booking_from='+encodeURIComponent(f)+'&booking_to='+encodeURIComponent(t))});$('booking-all').addEventListener('click',function(){$('booking-from').value='';$('booking-to').value='';loadDashboard('')});
    function renderBookingSource(bs){var box=$('db-src-stats'),list=$('db-src-list'),foot=$('db-src-foot');if(!bs){box.hidden=true;list.hidden=true;foot.hidden=false;foot.textContent='目前讀不到訂位來源資料，請稍後重新整理。';return}var items=bs.items||[],total=Number(bs.total||0),current=Number(bs.current||0);if(!items.length||!total){box.hidden=true;list.hidden=true;foot.hidden=false;foot.textContent='還沒有人回答訂位來源。';return}box.hidden=false;list.hidden=false;$('st-src-total').textContent=num(total);$('st-src-current').textContent=num(current);list.innerHTML=items.map(function(it){var n=Number(it.total||0),cur=Number(it.current||0),pct=total?Math.round(n*100/total):0,sub=cur?'<span class="s">目前好友 '+num(cur)+' 人</span>':'';return '<div class="db-src-row"><div class="db-src-name"><span class="t">'+esc(it.label)+'</span>'+sub+'</div><div class="db-src-n">'+num(n)+' 人</div><div class="db-src-pct">'+pct+'%</div></div>'}).join('');if(current<total){foot.hidden=false;foot.textContent='共 '+num(total)+' 人回答，其中 '+num(current)+' 人目前仍是好友。'}else{foot.hidden=true}}
    function renderLiff(lf){var box=$('db-liff-stats'),foot=$('db-liff-foot');if(!lf){box.hidden=true;foot.hidden=false;foot.textContent='目前讀不到活動頁資料。';return}var opens=Number(lf.opens_7d||0),users=Number(lf.users_7d||0),members=Number(lf.members_7d||0),anon=Number(lf.anon_7d||0);if(!opens&&!users&&!anon){box.hidden=true;foot.hidden=false;foot.textContent='最近 7 天還沒有人打開活動頁。';return}box.hidden=false;$('st-liff-opens').textContent=num(opens);$('st-liff-users').textContent=num(users);$('st-liff-members').textContent=num(members);var notes=[];if(!members&&users)notes.push('使用者目前都不是 LINE 好友。');if(anon)notes.push('另有 '+num(anon)+' 筆無法辨識身分。');foot.hidden=!notes.length;foot.textContent=notes.join(' ')}
    function renderAlerts(al){var items=[];if((al.push_failed_24h||0)>0)items.push({n:al.push_failed_24h,label:'則推播在過去 24 小時發送失敗',href:'/admin/reports'});if((al.broadcasts_failed||0)>0)items.push({n:al.broadcasts_failed,label:'個群發批次發送失敗',href:'/admin/broadcast/history'});var box=$('db-alert'),list=$('db-alert-items');if(!items.length){box.hidden=true;return}list.innerHTML=items.map(function(x){return '<div class="db-alert-item"><span><b>'+num(x.n)+'</b> '+x.label+'</span><a href="'+x.href+'">查看</a></div>'}).join('');box.hidden=false}
  })();</script>
` }) %>
