<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#FFF9ED" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#211713" media="(prefers-color-scheme: dark)" />
  <title><%= title %></title>
  <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
  <style>
    /* ── 領取優惠券頁（claim）─────────────────────────────────────
       設計準據：openrice-line-oa-powerbank-flow-v1.png 設計板第三屏。
       乳白底、橘色緞帶標籤、白卡片、橘 CTA、虛線分隔、底部食物插畫。
       禁用：紫藍漸層 / 毛玻璃 / 光暈球 / 漸層標題 / emoji / 紙花 / 滿頁陰影。 */
    :root{
      --ink:#3E2723; --ink2:#8D6E63; --bg:#FFF9ED; --card:#FFFFFF;
      --orange:#F15A22; --orange-d:#C8481B; --yellow:#F9C73B;
      --line:#F0E2CC; --soft:#FFF4DC;
    }
    @media (prefers-color-scheme: dark){
      :root:not([data-theme="light"]){
        --ink:#F7EFE7; --ink2:#BCAAA4; --bg:#211713; --card:#30221C;
        --line:#4A3630; --soft:#3A2A22;
      }
    }
    [data-theme="dark"]{
      --ink:#F7EFE7; --ink2:#BCAAA4; --bg:#211713; --card:#30221C;
      --line:#4A3630; --soft:#3A2A22;
    }
    *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
    /* display:flex/block 會蓋掉瀏覽器預設的 [hidden]，JS 藏不掉元素 */
    [hidden]{display:none !important}
    html,body{margin:0;padding:0}
    body{
      background:var(--bg); color:var(--ink);
      font-family:"PingFang TC","Heiti TC","Microsoft JhengHei",sans-serif;
      -webkit-font-smoothing:antialiased;
      min-height:100vh;
      display:flex;flex-direction:column;
    }
    .page{
      position:relative;z-index:1;width:100%;max-width:480px;margin:0 auto;
      padding:22px 22px 8px;flex:1;
    }

    /* ── 品牌 ── */
    .logo{text-align:center;margin-bottom:14px}
    .logo img{height:52px;display:inline-block}
    /* 深色底上官方棕字看不清：墊一塊乳白圓角小底，不改動 logo 本身顏色 */
    @media (prefers-color-scheme: dark){
      :root:not([data-theme="light"]) .logo img{background:#FFF9ED;padding:8px 16px;border-radius:14px;height:60px}
    }
    [data-theme="dark"] .logo img{background:#FFF9ED;padding:8px 16px;border-radius:14px;height:60px}

    /* ── 緞帶標籤 ── */
    .ribbon-wrap{text-align:center;margin-bottom:12px}
    .ribbon{
      display:inline-block;background:var(--orange);color:#FFF;
      font-size:14px;font-weight:800;letter-spacing:.12em;
      padding:8px 22px;
      clip-path:polygon(0 0,100% 0,calc(100% - 9px) 50%,100% 100%,0 100%,9px 50%);
    }

    /* ── 標題 ── */
    .headline{text-align:center;margin-bottom:4px}
    .headline h1{margin:0;font-size:27px;line-height:1.3;font-weight:900;letter-spacing:.01em}
    .tagline{text-align:center;font-size:14px;color:var(--ink2);margin:6px 0 0;line-height:1.5}

    /* ── 白卡片 ── */
    .card{
      background:var(--card);
      border:1.5px solid var(--line);
      border-radius:20px;
      padding:20px;
      margin-top:18px;
      box-shadow:0 6px 18px -12px rgba(62,39,35,.25);
    }
    .hero-img{
      display:block;width:100%;border-radius:14px;
      border:1.5px solid var(--line);
    }

    /* 期限列（時鐘 + 文字） */
    .expiry{
      display:flex;align-items:center;justify-content:center;gap:7px;
      margin:14px 0 2px;font-size:14px;font-weight:700;color:var(--ink);
    }
    .expiry svg{flex-shrink:0}
    .expiry .hl{color:var(--orange)}

    /* CTA */
    .cta{
      display:block;width:100%;border:0;border-radius:14px;cursor:pointer;
      background:var(--orange);color:#FFF;
      font-size:19px;font-weight:900;letter-spacing:.08em;
      padding:15px 16px;margin-top:14px;
      box-shadow:0 3px 0 var(--orange-d);
      transition:transform .08s, box-shadow .08s;
    }
    .cta:active{transform:translateY(2px);box-shadow:0 1px 0 var(--orange-d)}
    .cta[disabled]{background:var(--line);color:var(--ink2);box-shadow:none;cursor:default}
    .cta[disabled]:active{transform:none}
    .helper{margin-top:11px;font-size:12.5px;color:var(--ink2);text-align:center;line-height:1.6}

    /* 序號區 */
    .code-label{
      text-align:center;font-size:14px;color:var(--ink2);font-weight:700;
      letter-spacing:.08em;margin-bottom:6px;
    }
    .code-big{
      text-align:center;font-size:34px;font-weight:900;letter-spacing:.06em;
      color:var(--ink);font-variant-numeric:tabular-nums;word-break:break-all;
      -webkit-user-select:all;user-select:all;line-height:1.2;
    }
    .copy-wrap{text-align:center;margin-top:9px}
    .copy-chip{
      display:inline-flex;align-items:center;gap:6px;
      border:1.5px solid var(--orange);border-radius:999px;background:transparent;
      color:var(--orange);font-size:13px;font-weight:800;letter-spacing:.05em;
      padding:6px 16px;cursor:pointer;
    }
    .copy-chip:active{background:rgba(241,90,34,.1)}
    .dashed{border:0;border-top:2px dashed var(--yellow);margin:16px 0 2px}

    /* 查看說明連結 */
    .info-link-wrap{text-align:center;margin-top:15px}
    .info-link{
      background:none;border:0;cursor:pointer;
      font-size:13.5px;font-weight:700;color:var(--orange);
      text-decoration:underline;text-underline-offset:3px;
      padding:4px 8px;
    }

    /* 說明區 */
    .info-card{
      margin-top:12px;padding:15px 18px;
      background:var(--card);border:1.5px solid var(--line);border-radius:16px;
    }
    .info-card h2{margin:0 0 9px;font-size:14px;font-weight:800;letter-spacing:.02em}
    .info-card h2::before{content:'';display:inline-block;width:8px;height:8px;border-radius:2px;background:var(--yellow);margin-right:7px;vertical-align:1px}
    .info-card ol,.info-card ul{margin:0;padding-left:20px}
    .info-card li{font-size:13px;line-height:1.75;color:var(--ink2)}
    .info-card li::marker{color:var(--orange);font-weight:700}

    .notice{
      font-size:14.5px;line-height:1.7;color:var(--ink);text-align:center;
      padding:6px 2px;
    }

    /* ── 載入 / 全頁狀態 ── */
    .state{padding:56px 24px;text-align:center;color:var(--ink2)}
    .state .t{font-size:15px;font-weight:700;color:var(--ink);margin-bottom:6px}
    .state .s{font-size:13px;line-height:1.6}
    .spinner{
      width:26px;height:26px;margin:0 auto 16px;border-radius:50%;
      border:3px solid var(--line);border-top-color:var(--orange);
      animation:spin .8s linear infinite;
    }
    @keyframes spin{to{transform:rotate(360deg)}}
    @media (prefers-reduced-motion: reduce){ .spinner{animation-duration:1.6s} }

    /* ── 底部食物插畫 ── */
    .foot-art{
      margin-top:22px;width:100%;height:130px;overflow:hidden;flex-shrink:0;
    }
    .foot-art img{
      width:100%;height:260px;object-fit:cover;object-position:center 78%;
      display:block;
    }
    @media (prefers-color-scheme: dark){
      :root:not([data-theme="light"]) .foot-art img{filter:brightness(.82)}
    }

    .toast{
      position:fixed;left:50%;bottom:36px;transform:translateX(-50%);
      background:var(--ink);color:var(--bg);font-size:13px;font-weight:700;
      padding:9px 18px;border-radius:999px;z-index:50;
      opacity:0;transition:opacity .2s;pointer-events:none;
    }
    .toast.on{opacity:1}
  </style>
</head>
<body>
  <%
    const pv = (prizes && prizes[0] && prizes[0].prize_value) || {};
    const prizeName = (prizes && prizes[0] && prizes[0].name) || activity.name;
    const pageTitle = pv.page_title || prizeName;
    const claimedTitle = pv.claimed_title || '你的優惠券已準備好';
    const tagline = pv.tagline || '';
    const heroImage = pv.hero_image || '';
    const listOf = v => Array.isArray(v) ? v : [];
  %>
  <div class="page">

    <header class="logo">
      <img src="/images/openrice-wordmark.png" alt="OpenRice 開飯喇" />
    </header>

    <div class="ribbon-wrap"><span class="ribbon" id="ribbon">LINE 好友限定</span></div>

    <section class="headline">
      <h1 id="main-title"><%= pageTitle %></h1>
      <p class="tagline" id="tagline"<% if (!tagline) { %> hidden<% } %>><%= tagline %></p>
    </section>

    <!-- 載入中 -->
    <div id="st-loading" class="state">
      <div class="spinner"></div>
      <div class="s">準備中⋯</div>
    </div>

    <!-- 全頁錯誤 -->
    <div id="st-error" class="state" hidden>
      <div class="t" id="err-title">無法載入</div>
      <div class="s" id="err-detail">請稍後再試</div>
    </div>

    <!-- 主卡片 -->
    <div id="ticket" class="card" hidden>

      <!-- 未領取 -->
      <div id="pane-claim" hidden>
        <% if (heroImage) { %><img class="hero-img" src="<%= heroImage %>" alt="" /><% } %>
        <div class="expiry" id="expiry-claim" hidden>
          <svg width="17" height="17" viewBox="0 0 17 17"><circle cx="8.5" cy="8.5" r="7" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8.5 4.8v4l2.6 1.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>效期至 <span id="expiry-date-claim">—</span>，剩 <span class="hl" id="expiry-days-claim">—</span> 天</span>
        </div>
        <button type="button" class="cta" id="btn-claim">領取借電券</button>
        <div class="helper" id="claim-note">每位好友限領一次，領取後序號會存在「我的優惠券」</div>
      </div>

      <!-- 已領取 -->
      <div id="pane-code" hidden>
        <div class="code-label">優惠序號</div>
        <div class="code-big" id="code-text">—</div>
        <div class="copy-wrap">
          <button type="button" class="copy-chip" id="btn-copy">複製序號</button>
        </div>
        <hr class="dashed" />
        <button type="button" class="cta" id="btn-redeem" hidden>前往兌換</button>
        <div class="helper" id="redeem-note">複製序號後，依畫面指示完成兌換</div>
        <div class="helper" id="expiry-code" hidden>效期至 <span id="expiry-date-code">—</span>（剩 <span id="expiry-days-code">—</span> 天）</div>
      </div>

      <!-- 發完 -->
      <div id="pane-oos" hidden>
        <div class="notice">
          這一波的優惠序號已全數發完。<br>之後有加碼會在官方帳號公告，請留意訊息通知。
        </div>
      </div>

    </div>

    <!-- 查看說明 -->
    <div class="info-link-wrap" id="info-link-wrap" hidden>
      <button type="button" class="info-link" id="info-link">查看使用說明與注意事項</button>
    </div>

    <div id="info-sections" hidden>
      <% if (listOf(pv.how_to_claim).length) { %>
      <section class="info-card">
        <h2>領取步驟</h2>
        <ol><% listOf(pv.how_to_claim).forEach(x => { %><li><%= x %></li><% }) %></ol>
      </section>
      <% } %>
      <% if (listOf(pv.campaign_desc).length) { %>
      <section class="info-card">
        <h2>活動說明</h2>
        <ul><% listOf(pv.campaign_desc).forEach(x => { %><li><%= x %></li><% }) %></ul>
      </section>
      <% } %>
      <% if (listOf(pv.how_to_use).length) { %>
      <section class="info-card">
        <h2>使用方式</h2>
        <ol><% listOf(pv.how_to_use).forEach(x => { %><li><%= x %></li><% }) %></ol>
      </section>
      <% } %>
      <% if (listOf(pv.tnc).length) { %>
      <section class="info-card">
        <h2>注意事項</h2>
        <ul><% listOf(pv.tnc).forEach(x => { %><li><%= x %></li><% }) %></ul>
      </section>
      <% } %>
    </div>

  </div>

  <% if (heroImage) { %>
  <div class="foot-art" id="foot-art" hidden><img src="<%= heroImage %>" alt="" /></div>
  <% } %>

  <div class="toast" id="toast">已複製</div>

  <script>
    (function () {
      var liffId   = <%- JSON.stringify(liffId || '').replace(/</g,'\\u003c') %>;
      var slug     = <%- JSON.stringify(activity.slug).replace(/</g,'\\u003c') %>;
      var gameType = <%- JSON.stringify(gameType).replace(/</g,'\\u003c') %>;
      var pageTitle    = <%- JSON.stringify(pageTitle).replace(/</g,'\\u003c') %>;
      var claimedTitle = <%- JSON.stringify(claimedTitle).replace(/</g,'\\u003c') %>;
      // 兌換連結：redeem_url 是單一落地頁（優先）；沒有就依裝置挑 iOS / Android 下載連結
      var redeemUrls = {
        base:    <%- JSON.stringify(pv.redeem_url || '').replace(/</g,'\\u003c') %>,
        ios:     <%- JSON.stringify(pv.redeem_url_ios || '').replace(/</g,'\\u003c') %>,
        android: <%- JSON.stringify(pv.redeem_url_android || '').replace(/</g,'\\u003c') %>
      };
      function pickRedeemUrl(){
        if (redeemUrls.base) return redeemUrls.base;
        var ua = navigator.userAgent || '';
        if (/iPad|iPhone|iPod/i.test(ua)) return redeemUrls.ios || redeemUrls.android;
        if (/Android/i.test(ua)) return redeemUrls.android || redeemUrls.ios;
        return redeemUrls.ios || redeemUrls.android;
      }
      var redeemUrl    = pickRedeemUrl();
      var useExpiresOn = <%- JSON.stringify(pv.use_expires_on || '').replace(/</g,'\\u003c') %>;
      var startAt  = <%- JSON.stringify(activity.start_at || null).replace(/</g,'\\u003c') %>;
      var endAt    = <%- JSON.stringify(activity.end_at || null).replace(/</g,'\\u003c') %>;

      var profile = null, idToken = null;

      function $(id){ return document.getElementById(id); }
      function show(id){ var el = $(id); if (el) el.hidden = false; }
      function hide(id){ var el = $(id); if (el) el.hidden = true; }

      function showError(title, detail){
        hide('st-loading'); hide('ticket'); hide('info-link-wrap'); hide('foot-art');
        $('err-title').textContent = title || '無法載入';
        $('err-detail').textContent = detail || '請稍後再試';
        show('st-error');
      }

      function showTicketPane(pane){
        hide('st-loading'); hide('st-error');
        show('ticket'); show('info-link-wrap');
        // 未領取的卡片裡已經有主插畫，底部插畫只在領完/發完時出現，避免重複
        if (pane === 'pane-claim') hide('foot-art'); else show('foot-art');
        ['pane-claim','pane-code','pane-oos'].forEach(function(p){
          $(p).hidden = (p !== pane);
        });
        // 標題與緞帶隨狀態切換（照設計板：領完變「OPENRICE 好友禮／你的借電券已準備好」）
        if (pane === 'pane-code') {
          $('ribbon').textContent = 'OPENRICE 好友禮';
          $('main-title').textContent = claimedTitle;
          hide('tagline');
        } else if (pane === 'pane-oos') {
          $('ribbon').textContent = 'LINE 好友限定';
          $('main-title').textContent = pageTitle;
          hide('tagline');
        } else {
          $('ribbon').textContent = 'LINE 好友限定';
          $('main-title').textContent = pageTitle;
        }
      }

      // 使用期限：靜態算天數即可（天級精度，不需要跳動的倒數）
      function renderExpiry(){
        if (!useExpiresOn) return;
        var end = new Date(useExpiresOn + 'T23:59:59+08:00');
        if (isNaN(end.getTime())) return;
        var days = Math.max(0, Math.ceil((end.getTime() - Date.now()) / 86400000));
        var dateTxt = useExpiresOn.replace(/-/g, '/');
        $('expiry-days-claim').textContent = String(days);
        $('expiry-date-claim').textContent = dateTxt;
        $('expiry-days-code').textContent = String(days);
        $('expiry-date-code').textContent = dateTxt;
        show('expiry-claim'); show('expiry-code');
      }

      function renderCode(code){
        $('code-text').textContent = code;
        if (redeemUrl) {
          show('btn-redeem');
        } else {
          $('redeem-note').textContent = '兌換連結即將開放，序號已為你保留。';
        }
        showTicketPane('pane-code');
      }

      function toast(msg){
        var t = $('toast');
        t.textContent = msg || '已複製';
        t.classList.add('on');
        setTimeout(function(){ t.classList.remove('on'); }, 1600);
      }

      function copyCode(){
        var code = ($('code-text').textContent || '').trim();
        if (!code || code === '—') return;
        function fallback(){
          var ta = document.createElement('textarea');
          ta.value = code;
          ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); toast('已複製'); }
          catch (e) { toast('複製失敗，請長按序號'); }
          document.body.removeChild(ta);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(code).then(function(){ toast('已複製'); }, fallback);
        } else fallback();
      }

      function openRedeem(){
        if (!redeemUrl) return;
        // 點擊追蹤（fire-and-forget，失敗不影響跳轉）
        try {
          if (profile && idToken) {
            fetch('/api/games/' + gameType + '/' + encodeURIComponent(slug) + '/redeem-click', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id_token: idToken }),
              keepalive: true
            }).catch(function(){});
          }
        } catch (e) { /* ignore */ }
        try {
          if (window.liff && liff.openWindow) { liff.openWindow({ url: redeemUrl, external: true }); return; }
        } catch (e) { /* fall through */ }
        window.open(redeemUrl, '_blank');
      }

      // ── 從錢包撈回本活動已領的序號（重複進入頁面時） ──
      async function loadClaimedCode(){
        try {
          var resp = await fetch('/api/games/wallet?line_user_id=' +
            encodeURIComponent(profile.userId) + '&id_token=' + encodeURIComponent(idToken || ''))
            .then(function(r){ return r.json(); });
          if (resp && resp.ok && resp.coupons) {
            var mine = resp.coupons.filter(function(c){ return c.activity_slug === slug && c.code; });
            if (mine.length > 0) { renderCode(mine[0].code); return true; }
          }
        } catch (e) { /* fall through */ }
        return false;
      }

      // ── 領取 ──
      var claiming = false;
      async function claim(){
        if (claiming) return;
        claiming = true;
        var btn = $('btn-claim');
        btn.disabled = true; btn.textContent = '領取中⋯';
        try {
          var resp = await fetch('/api/games/' + gameType + '/' + encodeURIComponent(slug) + '/play', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              line_user_id: profile.userId,
              line_display_name: profile.displayName || '',
              id_token: idToken || ''
            })
          }).then(function(r){ return r.json(); });

          if (resp && resp.ok) {
            if (resp.coupon_code) { renderCode(resp.coupon_code); return; }
            if (resp.coupon_out_of_stock) { showTicketPane('pane-oos'); return; }
            var got = await loadClaimedCode();
            if (!got) showTicketPane('pane-oos');
            return;
          }

          var code = resp && resp.error;
          if (code === 'quota_exhausted') {
            var found = await loadClaimedCode();
            if (!found) showError('已領取過', '每位好友限領一次。');
            return;
          }
          if (code === 'must_follow_oa') { showError('尚未加入好友', '請先加入 OpenRice 官方帳號好友，再回來領取。'); return; }
          if (code === 'activity_not_started') { setWindowClosed('not_started'); return; }
          if (code === 'activity_ended' || code === 'activity_not_active') { setWindowClosed('ended'); return; }
          showError('領取失敗', (resp && resp.detail) || '請關閉頁面後從 LINE 重新開啟。');
        } catch (e) {
          showError('連線錯誤', '網路不穩定，請稍後再試。');
        } finally {
          claiming = false;
          btn.disabled = false; btn.textContent = '領取借電券';
        }
      }

      // 活動期間外：留在卡片畫面，但把 CTA 換成不可按的說明
      function setWindowClosed(kind){
        showTicketPane('pane-claim');
        var btn = $('btn-claim');
        btn.disabled = true;
        if (kind === 'not_started') {
          var d = startAt ? new Date(startAt) : null;
          btn.textContent = (d && !isNaN(d.getTime()))
            ? (d.getMonth() + 1) + '/' + d.getDate() + ' 開放領取'
            : '尚未開放領取';
          $('claim-note').textContent = '活動即將開始，開放後即可領取。';
        } else {
          btn.textContent = '活動已結束';
          $('claim-note').textContent = '本活動已結束，感謝參與。';
        }
      }

      function windowState(){
        var now = Date.now();
        if (startAt && now < new Date(startAt).getTime()) return 'not_started';
        if (endAt && now > new Date(endAt).getTime()) return 'ended';
        return 'open';
      }

      // ── LIFF init（比照各 game view 骨架） ──
      async function initLiff(){
        var qs = new URLSearchParams(location.search);
        if (qs.get('demo') === '1') return 'demo';
        var devUid = qs.get('uid');
        if (devUid) { profile = { userId: devUid, displayName: qs.get('name') || 'DEV' }; return 'dev'; }
        if (qs.get('preview') === '1') { profile = { userId: 'PREVIEW', displayName: '預覽' }; return 'preview'; }
        if (!liffId) throw new Error('LIFF ID 未設定');
        // 清掉 Netlify rewrite 補回來的 liff.state，避免 liff.init() 多導一次頁
        try {
          if (location.search.indexOf('liff.state') >= 0) {
            var _u = new URL(location.href);
            _u.searchParams.delete('liff.state');
            history.replaceState({}, '', _u.pathname + _u.search + _u.hash);
          }
        } catch (e) { /* 舊 webview 沒有 URL/replaceState 就算了 */ }
        try { await liff.init({ liffId: liffId }); }
        catch (e) { throw new Error('LIFF 初始化失敗'); }
        if (!liff.isInClient()) throw new Error('請在 LINE App 內打開');
        if (!liff.isLoggedIn()) { liff.login(); return new Promise(function(){}); }
        profile = await liff.getProfile();
        try { idToken = liff.getIDToken(); } catch (e) {}
        return 'liff';
      }

      async function boot(){
        renderExpiry();
        var mode;
        try { mode = await initLiff(); }
        catch (e) { showError('無法開啟', e && e.message); return; }

        if (mode === 'demo') {
          // 純視覺展示：?demo=1 看已領取、?demo=1&pane=claim 看未領取、&pane=oos 看發完
          var qs = new URLSearchParams(location.search);
          if (qs.get('pane') === 'claim') showTicketPane('pane-claim');
          else if (qs.get('pane') === 'oos') showTicketPane('pane-oos');
          else renderCode(qs.get('code') || 'ORPOWER60');
          return;
        }

        // 取 quota，決定顯示「領取」還是「已領取的序號」
        var quota = null;
        try {
          var meta = await fetch('/api/games/' + gameType + '/' + encodeURIComponent(slug) +
            '/meta?line_user_id=' + encodeURIComponent(profile.userId) +
            '&id_token=' + encodeURIComponent(idToken || ''))
            .then(function(r){ return r.json(); });
          if (meta && meta.ok) quota = meta.quota;
        } catch (e) { /* meta 失敗不擋頁，照樣給領取鈕，由 /play 把關 */ }

        if (quota && quota.played > 0) {
          var found = await loadClaimedCode();
          if (found) return;
          // 領過但錢包查不到（例如當初碼池缺碼）→ 顯示發完狀態
          showTicketPane('pane-oos');
          return;
        }

        var ws = windowState();
        if (ws !== 'open') { setWindowClosed(ws); return; }
        showTicketPane('pane-claim');
      }

      $('btn-claim').addEventListener('click', claim);
      $('btn-copy').addEventListener('click', copyCode);
      $('btn-redeem').addEventListener('click', openRedeem);
      $('info-link').addEventListener('click', function(){
        var s = $('info-sections');
        s.hidden = !s.hidden;
        $('info-link').textContent = s.hidden ? '查看使用說明與注意事項' : '收合使用說明';
        if (!s.hidden) { try { s.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); } catch (e) {} }
      });

      boot();
    })();
  </script>
</body>
</html>
