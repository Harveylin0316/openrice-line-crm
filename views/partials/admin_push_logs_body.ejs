<style>
 .pl-head,.pl-actions,.pl-meta,.pl-pagination{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.pl-head h1{margin:0}.pl-filters{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:20px 0}.pl-filters label{display:grid;gap:6px;font-size:13px;font-weight:650}.pl-filters input,.pl-filters select{width:100%;min-width:0;min-height:42px;border:1px solid #d7d1cd;border-radius:8px;padding:8px;background:#fff;font:inherit}.pl-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:20px 0}.pl-stat{background:#f8f9fa;padding:16px;border:1px solid #e5e7eb;border-radius:12px}.pl-stat strong{display:block;font-size:28px}.pl-stat span{font-size:13px;color:#6b7280}.pl-note{background:#fff9e8;border:1px solid #f4cf72;border-radius:10px;padding:14px;line-height:1.65}.pl-error{background:#fff0f0;border-color:#f4b8b8}.pl-row{padding:20px 0;border-bottom:1px solid #e5e7eb;overflow-wrap:anywhere}.pl-row h3{margin:0 0 5px;font-size:17px}.pl-meta{font-size:12px;color:#6b7280}.pl-message{white-space:pre-wrap;color:#475569;background:#f7f8fa;padding:12px;border-radius:8px;max-height:120px;overflow:auto}.pl-diagnosis{border-left:3px solid #eb7849;padding:0 0 0 12px;line-height:1.6}.pl-diagnosis p{margin:6px 0}.pl-row details{margin-top:12px;color:#64748b;font-size:13px}.pl-row summary{cursor:pointer}.pl-row pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px}.pl-pagination{padding-top:20px}.pl-badge{padding:4px 9px;background:#fee2e2;color:#991b1b;border-radius:20px;font-weight:650}.pl-badge.success{background:#dcfce7;color:#166534}.pl-badge.skipped{background:#f1f5f9;color:#475569}.pl-empty{padding:30px 0;text-align:center;color:#64748b}.pl-id{font-size:12px;overflow-wrap:anywhere}.pl-actions a,.pl-actions button{min-height:42px}.pl-followup{color:#5a4b36;font-size:13px}@media(max-width:650px){.pl-filters{grid-template-columns:1fr 1fr}.pl-filters .pl-search{grid-column:1/-1}.pl-stats{gap:7px}.pl-stat{padding:12px 8px}.pl-stat strong{font-size:23px}.pl-stat span{font-size:11px}.pl-row{padding:18px 0}.pl-head h1{font-size:24px}}@media(max-width:360px){.pl-filters{grid-template-columns:1fr}}
</style>
<section class="card">
 <div class="pl-head"><h1>推播發送紀錄</h1><a class="btn" href="/admin">回工作台</a></div>
 <p class="muted">先看是哪位客人、哪則訊息，再依原因處理。這一頁只查紀錄，不會自動重發。</p>
 <form method="get" action="/admin/push-logs">
  <div class="pl-filters">
   <label>觀察期間<select name="range"><% for (const [v,n] of [['24h','近 24 小時'],['7d','近 7 天'],['30d','近 30 天'],['90d','近 90 天'],['all','全部期間'],['custom','自訂日期']]) { %><option value="<%= v %>" <%= filters.range===v?'selected':'' %>><%= n %></option><% } %></select></label>
   <label class="pl-search">找收件人或錯誤<input type="search" name="q" value="<%= filters.q %>" maxlength="120" placeholder="姓名、LINE User ID 或錯誤文字"></label>
   <div class="pl-apply"><button class="btn primary" type="submit">套用篩選</button> <a href="/admin/push-logs?status=failed&range=7d">查近 7 天失敗</a> · <a href="/admin/push-logs?status=failed&range=all">查全部失敗</a></div>
  </div>
  <details class="pl-more" <%= filters.range==='custom' || filters.source || filters.status!=='failed'?'open':'' %>><summary>更多篩選：來源、後續狀態與自訂日期</summary><div class="pl-filters">
   <label>發送狀態<select name="status"><% for (const [v,n] of [['failed','只看失敗'],['all','全部'],['success','LINE 已接受'],['skipped','未送出']]) { %><option value="<%= v %>" <%= filters.status===v?'selected':'' %>><%= n %></option><% } %></select></label>
   <label>訊息來源<select name="source"><option value="">全部來源</option><% for (const [v,n] of Object.entries(SOURCES)) { %><option value="<%= v %>" <%= filters.source===v?'selected':'' %>><%= n %></option><% } %><% if(filters.source && !SOURCES[filters.source]) { %><option selected value="<%= filters.source %>"><%= filters.source %></option><% } %></select></label>
   <label>失敗後的狀態（只看失敗時使用）<select name="followup"><% for (const [v,n] of [['all','全部失敗紀錄'],['pending','尚未查到同一則成功'],['recovered','同一則後續已被 LINE 接受']]) { %><option value="<%= v %>" <%= filters.followup===v?'selected':'' %>><%= n %></option><% } %></select></label>
   <label>開始日期（自訂時使用）<input type="date" name="from" value="<%= filters.from %>" min="2000-01-01" max="2100-12-31"></label>
   <label>結束日期（包含當天）<input type="date" name="to" value="<%= filters.to %>" min="2000-01-01" max="2100-12-31"></label>
  </div><button class="btn" type="submit">套用以上條件</button></details>
 </form>
 <% if(error) { %><p class="pl-note pl-error" role="alert"><%= error %></p><% } else { %>
 <div class="pl-actions"><p class="muted">目前：<%= filters.status==='failed'?'只看失敗':filters.status==='all'?'全部狀態':filters.status==='success'?'LINE 已接受':'未送出' %><%= filters.followup==='pending'?' · 尚未查到同一則後續成功':filters.followup==='recovered'?' · 同一則後續已被 LINE 接受':'' %><%= filters.source?' · '+(SOURCES[filters.source]||filters.source):'' %></p><% if(Number(stats.total)>0) { %><a class="btn" href="<%= filterUrl(filters,{export:'csv'}) %>">匯出篩選結果 CSV</a><% } %></div>
 <div class="pl-stats"><div class="pl-stat"><strong><%= Number(stats.total||0).toLocaleString('zh-TW') %></strong><span>符合篩選的嘗試次數</span></div><div class="pl-stat"><strong><%= Number(stats.people||0).toLocaleString('zh-TW') %></strong><span><%= filters.status==='failed'?'受影響人數':'可辨識收件人數' %></span></div><div class="pl-stat"><strong><%= Number(stats.recovered||0).toLocaleString('zh-TW') %></strong><span>其中後續已被 LINE 接受</span></div></div>
 <p class="muted">同一人、同一則訊息重試多次，會留下多筆紀錄，不是多位客人。時間以台灣時間計算；缺少身分的紀錄不計入人數。LINE 接受請求不代表已讀或實際送達。</p>
 <% if(Number(stats.monthly)>0) { %><div class="pl-note"><strong>這個期間有 <%= stats.monthly %> 次被 LINE 訊息額度限制擋下。</strong><br>請先檢查 LINE OA 的當月用量與方案上限。歷史錯誤不代表目前仍額度不足；若流程仍在重試，不要另外補發。 <a href="https://manager.line.biz/" target="_blank" rel="noopener noreferrer">開啟 LINE OA 後台</a></div><% } %>
 <% if(!rows.length) { %><div class="pl-empty"><strong>這個篩選沒有發送紀錄。</strong><p>較早的通知可改看「近 7 天失敗」或「全部失敗」。<% if(filters.after) { %>目前已到最後一頁，可回到篩選結果第一頁。<% } %></p></div><% } %>
 <% for(const row of rows) { %>
 <article class="pl-row">
  <div class="pl-meta"><span>紀錄 #<%= row.id %> · <%= taipeiTime(row.created_at) %></span><span class="pl-badge <%= row.status==='success'||row.recovered?'success':row.status==='skipped'?'skipped':'' %>"><%= row.recovered?'原失敗，後續已接受':row.status==='success'?'LINE 已接受':row.status==='skipped'?'未送出':'失敗' %></span></div>
  <h3><%= row.person %></h3><div class="pl-id">LINE User ID：<%= row.line_user_id || '此紀錄未保存' %><% if(row.blocked_at) { %> · 目前有封鎖紀錄<% } %><% if(row.archived_at) { %> · 舊官方帳號會員<% } %></div>
  <p class="muted"><%= row.source %><% if(row.sourceHref) { %> · <a href="<%= row.sourceHref %>">查看原<%= row.broadcast_id?'群發紀錄':'流程' %></a><% } %></p>
  <div class="pl-message"><%= row.message %></div>
  <div class="pl-diagnosis"><p><strong><%= row.cause %></strong></p><p><strong>下一步：</strong><%= row.action %></p></div>
  <% if(row.status==='failed') { %><p class="pl-followup"><%= row.followUp %><% if(row.flow_status==='active' && row.next_run_at) { %> 流程下次執行：<%= taipeiTime(row.next_run_at) %>。<% } %></p><% } %>
  <details><summary>LINE 原始回應（給管理員排查）</summary><p>HTTP：<%= row.http_status || '未收到 HTTP 回應' %></p><pre><%= row.detail || '沒有保存回應文字' %></pre></details>
 </article><% } %>
 <div class="pl-pagination"><span class="muted">每頁最多 50 筆；匯出包含全部篩選結果，最多 10,000 筆。</span><div><% if(filters.after) { %><a class="btn" href="<%= filterUrl(filters) %>">回第一頁</a><% } %> <% if(nextHref) { %><a class="btn primary" href="<%= nextHref %>">下一頁</a><% } %></div></div>
 <% } %>
</section>
<style>.pl-apply{display:flex;align-items:center;flex-wrap:wrap;gap:7px;font-size:12px}.pl-apply .btn{margin-right:5px;min-height:42px}.pl-more{margin:12px 0;color:#64748b;font-size:13px}.pl-more summary{cursor:pointer}.pl-more .pl-filters{margin:12px 0}.pl-more label{color:#334155}@media(max-width:650px){.pl-apply{grid-column:1/-1}.pl-search{grid-column:auto!important}.pl-filters{gap:12px}}</style>
<script>(function(){var form=document.querySelector('form[action="/admin/push-logs"]');if(!form)return;var range=form.querySelector('[name="range"]'),more=form.querySelector('.pl-more');function syncDates(){var custom=range.value==='custom';form.querySelectorAll('input[type="date"]').forEach(function(input){input.required=custom;input.disabled=!custom;});if(custom)more.open=true;}range.addEventListener('change',syncDates);syncDates();})();</script>
