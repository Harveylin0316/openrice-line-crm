<%-
  include('layout', {
    user: user,
    isAdmin: isAdmin,
    bodyClass: bodyClass,
    body: `
    <section class="card msq-head">
      <a href="/admin/messages" class="msq-back">← 返回訊息庫</a>
      <div>
        <h1>多段訊息編輯器</h1>
        <p class="muted">把文字、圖片、影片與做好的卡片排成一則 LINE 推播，最多 5 段。可先選擇測試人員發送確認。</p>
      </div>
    </section>

    <section class="card msq-grid">
      <div>
        <label class="msq-field"><span>訊息名稱 *</span><input id="msq-name" maxlength="200" placeholder="例：點餐廳後 30 分鐘提醒"></label>
        <label class="msq-field"><span>內部說明</span><input id="msq-desc" maxlength="500" placeholder="只有後台人員看得到"></label>

        <div class="msq-title-row"><h2>內容順序</h2><span id="msq-count" class="muted"></span></div>
        <div id="msq-items"></div>
        <div class="msq-add">
          <button type="button" data-add="text">＋文字</button>
          <button type="button" data-add="image">＋圖片</button>
          <button type="button" data-add="video">＋影片</button>
          <button type="button" data-add="card">＋既有卡片</button>
        </div>
        <p class="muted msq-note">影片需提供公開 HTTPS 的 MP4 網址；預覽圖可直接在這裡上傳。LINE 單次最多接受 5 段內容。</p>

        <div class="msq-actions">
          <label class="msq-test-recipient"><span>測試收件人</span><select id="msq-test-recipient" disabled><option value="">載入測試人員中…</option></select></label>
          <button type="button" id="msq-test" class="msq-secondary" disabled>發送測試</button>
          <a class="msq-manage-test" href="/admin/broadcast#bc-send-step">管理測試人員</a>
          <button type="button" id="msq-save" class="msq-primary">儲存到訊息庫</button>
          <span id="msq-status" class="muted"></span>
        </div>
      </div>
      <aside>
        <h2>LINE 預覽</h2>
        <p class="muted">各段會依下列順序一起送出。</p>
        <div class="msq-phone"><div id="msq-preview"></div></div>
      </aside>
    </section>

    <style>
      .msq-head{display:flex;align-items:flex-start;gap:18px}.msq-head h1{margin:0 0 5px}.msq-back{font-size:13px;color:#6b7280;text-decoration:none;white-space:nowrap;margin-top:6px}
      .msq-grid{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:28px}.msq-grid h2{font-size:16px;margin:0 0 10px}.msq-field{display:flex;flex-direction:column;gap:6px;margin-bottom:14px;font-size:13px;font-weight:700}.msq-field input,.msq-field textarea,.msq-field select{padding:10px 11px;border:1px solid #d1d5db;border-radius:8px;font:inherit;font-weight:400;width:100%;box-sizing:border-box}.msq-title-row{display:flex;justify-content:space-between;align-items:center;margin-top:24px}
      .msq-item{border:1px solid #e5e7eb;border-radius:12px;padding:13px;margin-bottom:10px;background:#fff}.msq-item-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.msq-tag{font-size:12px;font-weight:800;color:#7c2d12;background:#ffedd5;padding:3px 8px;border-radius:6px}.msq-item-ops{display:flex;gap:5px}.msq-item-ops button,.msq-add button,.msq-upload{border:1px solid #d1d5db;background:#fff;border-radius:7px;padding:7px 10px;cursor:pointer;color:#374151}.msq-add{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.msq-add button{border-style:dashed}.msq-note{font-size:12px;line-height:1.6}.msq-upload-row{display:flex;gap:8px;align-items:center}.msq-upload-row input{flex:1}.msq-actions{display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap;border-top:1px solid #e5e7eb;margin-top:22px;padding-top:16px}.msq-test-recipient{display:flex;flex-direction:column;gap:5px;font-size:12px;font-weight:700}.msq-test-recipient select{min-width:190px;padding:9px 10px;border:1px solid #d1d5db;border-radius:9px;background:#fff;color:#374151}.msq-manage-test{font-size:12px;color:#6b7280;margin-bottom:11px}.msq-primary,.msq-secondary{padding:10px 16px;border-radius:9px;font-weight:700;cursor:pointer}.msq-primary{background:#FCC726;border:1px solid #FCC726;color:#1f2937}.msq-secondary{background:#fff;border:1px solid #d1d5db;color:#374151}.msq-secondary:disabled{cursor:not-allowed;opacity:.55}
      .msq-phone{background:#e8edf3;border-radius:22px;padding:22px 15px;min-height:480px;position:sticky;top:20px}.msq-msg{max-width:280px;margin:0 0 10px auto;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.12)}.msq-text{padding:12px 14px;white-space:pre-wrap;word-break:break-word;line-height:1.5;font-size:14px}.msq-media img{display:block;width:100%}.msq-video{aspect-ratio:16/9;background:#111;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;background-size:cover;background-position:center}.msq-card{padding:16px}.msq-card strong{font-size:18px;display:block}.msq-card p{white-space:pre-wrap;color:#6b7280}.msq-card b{display:block;text-align:center;background:#FCC726;border-radius:10px;padding:10px;margin-top:10px}.msq-empty{color:#6b7280;text-align:center;padding-top:150px}
      .msq-flex-bubble{width:100%;background:#fff;overflow:hidden}.msq-flex-text{font-size:14px;line-height:1.5;word-break:break-word}.msq-flex-image{display:block;width:100%;height:auto}.msq-flex-placeholder{aspect-ratio:20/13;background:repeating-linear-gradient(45deg,#f3f4f6,#f3f4f6 10px,#e5e7eb 10px,#e5e7eb 20px);display:flex;align-items:center;justify-content:center;color:#9ca3af;font-size:12px}.msq-flex-separator{border:0;border-top:1px solid #e5e7eb;width:100%}.msq-flex-button{text-align:center;font-weight:700;border-radius:10px;padding:10px 12px;background:#FCC726;color:#1f2937}.msq-flex-carousel{display:flex;gap:8px;overflow-x:auto}.msq-flex-carousel>.msq-flex-bubble{flex:0 0 240px}
      @media(max-width:850px){.msq-grid{grid-template-columns:1fr}.msq-phone{position:static;min-height:300px}.msq-head{flex-direction:column;gap:8px}}
    </style>

    <script>
    (function(){
      var $=function(id){return document.getElementById(id)};
      var params=new URLSearchParams(location.search),editId=params.get('mid'),dup=params.get('dup')==='1';
      var items=[],cards=[];
      function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}
      function typeName(t){return {text:'文字',image:'圖片',video:'影片',card:'既有卡片'}[t]||t}
      function cardOptions(selected){var h='<option value="">請選訊息庫裡的卡片</option>';cards.forEach(function(c){if(c.message_config&&c.message_config.mode!=='sequence')h+='<option value="'+c.id+'"'+(String(selected)===String(c.id)?' selected':'')+'>'+esc(c.name)+'</option>'});return h}
      function itemHtml(it,i){
        var body='';
        if(it.type==='text')body='<label class="msq-field"><span>文字內容</span><textarea rows="4" data-f="text" data-i="'+i+'" maxlength="5000" placeholder="可使用 {暱稱} 做個人化">'+esc(it.text||'')+'</textarea></label>';
        if(it.type==='image')body='<label class="msq-field"><span>圖片網址</span><div class="msq-upload-row"><input data-f="originalContentUrl" data-i="'+i+'" value="'+esc(it.originalContentUrl||'')+'" placeholder="https://..."><input type="file" data-upload="image" data-i="'+i+'" accept="image/png,image/jpeg"></div></label><label class="msq-field"><span>預覽圖網址（留空會使用同一張）</span><input data-f="previewImageUrl" data-i="'+i+'" value="'+esc(it.previewImageUrl||'')+'" placeholder="https://..."></label>';
        if(it.type==='video')body='<label class="msq-field"><span>影片 MP4 網址</span><input data-f="originalContentUrl" data-i="'+i+'" value="'+esc(it.originalContentUrl||'')+'" placeholder="https://.../video.mp4"></label><label class="msq-field"><span>影片預覽圖 *</span><div class="msq-upload-row"><input data-f="previewImageUrl" data-i="'+i+'" value="'+esc(it.previewImageUrl||'')+'" placeholder="https://.../preview.jpg"><input type="file" data-upload="preview" data-i="'+i+'" accept="image/png,image/jpeg"></div></label>';
        if(it.type==='card')body='<label class="msq-field"><span>選一張已設計好的卡片</span><select data-card data-i="'+i+'">'+cardOptions(it.source_message_id||it.message_id)+'</select></label><p class="muted" style="font-size:12px">會複製卡片目前的內容；之後修改原卡片不會影響這則多段訊息。</p>';
        return '<div class="msq-item"><div class="msq-item-head"><span class="msq-tag">'+(i+1)+' · '+typeName(it.type)+'</span><div class="msq-item-ops">'+(i?'<button data-up="'+i+'">↑</button>':'')+(i<items.length-1?'<button data-down="'+i+'">↓</button>':'')+'<button data-remove="'+i+'">移除</button></div></div>'+body+'</div>';
      }
      function sync(){document.querySelectorAll('[data-f]').forEach(function(el){var it=items[Number(el.getAttribute('data-i'))];if(it)it[el.getAttribute('data-f')]=el.value});document.querySelectorAll('[data-card]').forEach(function(el){var it=items[Number(el.getAttribute('data-i'))],c=cards.find(function(x){return String(x.id)===String(el.value)});if(it){it.source_message_id=Number(el.value)||null;delete it.message_id;it.message_config=c?JSON.parse(JSON.stringify(c.message_config)):null}})}
      function render(){var box=$('msq-items');box.innerHTML=items.length?items.map(itemHtml).join(''):'<p class="muted">還沒有內容，請從下面新增第一段。</p>';$('msq-count').textContent=items.length+' / 5 段';document.querySelectorAll('[data-remove]').forEach(function(b){b.onclick=function(){sync();items.splice(Number(b.getAttribute('data-remove')),1);render()}});document.querySelectorAll('[data-up]').forEach(function(b){b.onclick=function(){sync();var i=Number(b.getAttribute('data-up')),x=items[i];items[i]=items[i-1];items[i-1]=x;render()}});document.querySelectorAll('[data-down]').forEach(function(b){b.onclick=function(){sync();var i=Number(b.getAttribute('data-down')),x=items[i];items[i]=items[i+1];items[i+1]=x;render()}});document.querySelectorAll('[data-f],[data-card]').forEach(function(el){el.oninput=function(){sync();preview()};el.onchange=function(){sync();preview()}});document.querySelectorAll('[data-upload]').forEach(function(el){el.onchange=function(){upload(el)}});preview()}
      function upload(input){var file=input.files&&input.files[0];if(!file)return;var fd=new FormData();fd.append('hero',file);$('msq-status').textContent='圖片上傳中…';fetch('/admin/broadcast/hero/upload',{method:'POST',body:fd}).then(function(r){return r.json()}).then(function(d){if(!d.ok||!d.url)throw new Error(d.error||'upload_failed');var i=Number(input.getAttribute('data-i')),it=items[i];if(input.getAttribute('data-upload')==='image'){it.originalContentUrl=d.url;it.previewImageUrl=d.url}else it.previewImageUrl=d.url;$('msq-status').textContent='圖片已上傳';render()}).catch(function(e){$('msq-status').textContent='圖片上傳失敗：'+e.message})}
      var flexSizes={xxs:'10px',xs:'12px',sm:'13px',md:'15px',lg:'17px',xl:'20px',xxl:'24px','3xl':'30px'};
      var flexSpaces={none:'0px',xs:'4px',sm:'8px',md:'12px',lg:'16px',xl:'20px',xxl:'24px'};
      function flexSize(v){return flexSizes[v]||(/^\\d+px$/.test(String(v||''))?v:'14px')}
      function flexSpace(v){return flexSpaces[v]!=null?flexSpaces[v]:(/^\\d+px$/.test(String(v||''))?v:'0px')}
      function flexComp(c){
        if(!c||typeof c!=='object')return null;
        if(c.type==='text'){var t=document.createElement('div');t.className='msq-flex-text';t.textContent=String(c.text==null?'':c.text);if(c.color)t.style.color=c.color;if(c.size)t.style.fontSize=flexSize(c.size);if(c.weight==='bold')t.style.fontWeight='700';if(c.align==='center')t.style.textAlign='center';if(c.align==='end')t.style.textAlign='right';if(c.margin)t.style.marginTop=flexSpace(c.margin);if(c.flex!=null)t.style.flex=String(c.flex);return t}
        if(c.type==='image'){if(c.url&&!/REPLACE_[A-Z0-9_]+/i.test(c.url)){var im=document.createElement('img');im.className='msq-flex-image';im.src=c.url;return im}var ph=document.createElement('div');ph.className='msq-flex-placeholder';ph.textContent='圖片（尚未替換）';return ph}
        if(c.type==='separator'){var hr=document.createElement('hr');hr.className='msq-flex-separator';if(c.color)hr.style.borderTopColor=c.color;if(c.margin)hr.style.marginTop=flexSpace(c.margin);return hr}
        if(c.type==='filler'){var f=document.createElement('div');f.style.flex=String(c.flex!=null?c.flex:1);return f}
        if(c.type==='button'){var btn=document.createElement('div');btn.className='msq-flex-button';btn.textContent=(c.action&&c.action.label)||'按鈕';if(c.color)btn.style.background=c.color;if(c.margin)btn.style.marginTop=flexSpace(c.margin);return btn}
        if(c.type==='box')return flexBox(c);
        return null;
      }
      function flexBox(b){var el=document.createElement('div'),horizontal=b.layout==='horizontal'||b.layout==='baseline';el.style.display='flex';el.style.flexDirection=horizontal?'row':'column';if(b.layout==='baseline')el.style.alignItems='baseline';if(b.alignItems)el.style.alignItems=b.alignItems==='center'?'center':b.alignItems;if(b.justifyContent)el.style.justifyContent=b.justifyContent;if(b.spacing)el.style.gap=flexSpace(b.spacing);if(b.backgroundColor)el.style.background=b.backgroundColor;if(b.cornerRadius)el.style.borderRadius=/px$/.test(String(b.cornerRadius||''))?b.cornerRadius:'8px';if(b.borderWidth&&b.borderColor)el.style.border=b.borderWidth+' solid '+b.borderColor;if(b.margin)el.style.marginTop=flexSpace(b.margin);if(b.flex!=null)el.style.flex=String(b.flex);if(b.paddingAll!=null)el.style.padding=flexSpace(b.paddingAll);if(b.paddingTop!=null)el.style.paddingTop=flexSpace(b.paddingTop);if(b.paddingBottom!=null)el.style.paddingBottom=flexSpace(b.paddingBottom);if(b.paddingStart!=null)el.style.paddingLeft=flexSpace(b.paddingStart);if(b.paddingEnd!=null)el.style.paddingRight=flexSpace(b.paddingEnd);(b.contents||[]).forEach(function(c){var child=flexComp(c);if(child)el.appendChild(child)});return el}
      function flexBubble(b){var el=document.createElement('div');el.className='msq-flex-bubble';if(b&&b.header)el.appendChild(flexBox(b.header));if(b&&b.hero){var hero=document.createElement('div'),hc=flexComp(b.hero);if(hc)hero.appendChild(hc);el.appendChild(hero)}if(b&&b.body)el.appendChild(flexBox(b.body));if(b&&b.footer)el.appendChild(flexBox(b.footer));return el}
      function flexMessage(flex,host){var contents=flex&&flex.contents;if(!contents){host.textContent='這張卡片沒有可預覽內容';return}if(contents.type==='carousel'&&Array.isArray(contents.contents)){var row=document.createElement('div');row.className='msq-flex-carousel';contents.contents.forEach(function(b){row.appendChild(flexBubble(b))});host.appendChild(row);return}host.appendChild(flexBubble(contents))}
      function preview(){sync();var box=$('msq-preview');box.innerHTML='';if(!items.length){box.innerHTML='<div class="msq-empty">新增內容後會在這裡預覽</div>';return}items.forEach(function(it){var msg=document.createElement('div');msg.className='msq-msg';if(it.type==='text'){msg.className+=' msq-text';msg.textContent=it.text||'（尚未填文字）'}else if(it.type==='image'){msg.className+=' msq-media';if(it.originalContentUrl){var img=document.createElement('img');img.src=it.previewImageUrl||it.originalContentUrl;msg.appendChild(img)}else msg.innerHTML='<div class="msq-text">（尚未選圖片）</div>'}else if(it.type==='video'){var vd=document.createElement('div');vd.className='msq-video';if(it.previewImageUrl)vd.style.backgroundImage='linear-gradient(rgba(0,0,0,.3),rgba(0,0,0,.3)),url('+it.previewImageUrl+')';vd.textContent='▶ 播放影片';msg.appendChild(vd)}else{var c=it.message_config||{},t=c.template||{};if(c.mode==='template'){msg.className+=' msq-card';msg.innerHTML='<strong>'+esc(t.title||'卡片標題')+'</strong><p>'+esc(t.subtitle||'')+'</p>'+(t.ctaLabel?'<b>'+esc(t.ctaLabel)+'</b>':'')}else if(c.mode==='flex_json'&&c.flex){flexMessage(c.flex,msg)}else{msg.className+=' msq-card';msg.textContent='請先選擇可用的卡片'}}box.appendChild(msg)})}
      function payload(){sync();return {name:$('msq-name').value.trim(),description:$('msq-desc').value.trim(),channel:'line',message_config:{mode:'sequence',items:items.map(function(it){var x=JSON.parse(JSON.stringify(it));delete x.message_id;return x})}}}
      function loadTestRecipients(){var select=$('msq-test-recipient'),button=$('msq-test');fetch('/admin/broadcast/test-recipients').then(function(r){return r.json()}).then(function(d){var list=d.ok&&Array.isArray(d.recipients)?d.recipients.filter(function(x){return /^U[0-9a-f]{32}$/i.test(String(x.line_user_id||''))}):[];if(!list.length){select.innerHTML='<option value="">尚未設定測試人員</option>';select.disabled=true;button.disabled=true;$('msq-status').textContent='請先到「管理測試人員」加入收件人';return}select.innerHTML=list.map(function(x){return '<option value="'+esc(x.line_user_id)+'">'+esc(x.label||'未命名測試人員')+'</option>'}).join('');select.disabled=false;button.disabled=false;$('msq-status').textContent='請選擇測試收件人'}).catch(function(){select.innerHTML='<option value="">測試人員載入失敗</option>';select.disabled=true;button.disabled=true;$('msq-status').textContent='測試人員載入失敗，請重新整理'})}
      function testError(d){var map={no_recipient:'尚未選擇測試收件人',invalid_line_user_id:'測試人員的 LINE User ID 格式錯誤',invalid_line_message:'訊息內容不符合 LINE 規格',push_failed:'LINE 發送失敗',no_line_channel_access_token:'LINE 發送功能尚未設定'};var msg=map[d&&d.error]||(d&&d.error)||'未知錯誤';if(d&&d.detail)msg+='：'+d.detail;return msg}
      function sendTest(){var recipient=$('msq-test-recipient').value,label=$('msq-test-recipient').selectedOptions[0]&&$('msq-test-recipient').selectedOptions[0].textContent;if(!recipient){$('msq-status').textContent='請先選擇測試收件人';return}var p=payload(),button=$('msq-test');button.disabled=true;$('msq-status').textContent='正在發給 '+label+'…';fetch('/admin/broadcast/test-push',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({channel:'line',test_line_user_id:recipient,message_config:p.message_config})}).then(function(r){return r.json()}).then(function(d){$('msq-status').textContent=d.ok?'已發給 '+label:'測試失敗：'+testError(d)}).catch(function(e){$('msq-status').textContent='測試失敗：'+e.message}).finally(function(){button.disabled=false})}
      function save(){var p=payload();if(!p.name){$('msq-status').textContent='請先填訊息名稱';return}var url=(!dup&&editId)?'/admin/messages/api/'+editId:'/admin/messages/api',method=(!dup&&editId)?'PUT':'POST';$('msq-status').textContent='儲存中…';fetch(url,{method:method,headers:{'Content-Type':'application/json'},body:JSON.stringify(p)}).then(function(r){return r.json()}).then(function(d){if(d.ok)location.href='/admin/messages';else $('msq-status').textContent='儲存失敗：'+(d.detail||d.error||'未知錯誤')}).catch(function(e){$('msq-status').textContent='儲存失敗：'+e.message})}
      document.querySelectorAll('[data-add]').forEach(function(b){b.onclick=function(){sync();if(items.length>=5){$('msq-status').textContent='LINE 一次最多 5 段內容';return}var t=b.getAttribute('data-add'),it={type:t};if(t==='text')it.text='';if(t==='image'||t==='video'){it.originalContentUrl='';it.previewImageUrl=''}if(t==='card'){it.source_message_id=null;it.message_config=null}items.push(it);render()}});$('msq-test').onclick=sendTest;$('msq-save').onclick=save;
      loadTestRecipients();fetch('/admin/messages/api/list').then(function(r){return r.json()}).then(function(d){cards=d.messages||[];if(editId)fetch('/admin/messages/api/'+editId).then(function(r){return r.json()}).then(function(x){if(!x.ok||!x.message||x.message.message_config.mode!=='sequence'){throw new Error('這不是多段訊息')}if(!dup)$('msq-name').value=x.message.name||'';else $('msq-name').value=(x.message.name||'')+'（副本）';$('msq-desc').value=x.message.description||'';items=JSON.parse(JSON.stringify(x.message.message_config.items||[]));render()}).catch(function(e){$('msq-status').textContent='載入失敗：'+e.message});else render()}).catch(function(){render()});
    })();
    </script>
    `
  })
%>
