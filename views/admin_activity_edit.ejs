        });
      }
      // 依遊戲類型切換畫面設定區：輪盤與刮刮樂各有自己的控制項，其他類型只保留 Logo。
      function applyGameTypeUi() {
        var scratch = isScratchActivity();
        var wheel = (currentActivity && currentActivity.game_type) === 'wheel';
        var toggle = function (id, show) { var el = $(id); if (el) el.hidden = !show; };
        toggle('ae-scratch-editor', scratch);
        toggle('ae-scratch-copy-editor', scratch);
        toggle('ae-wheel-editor', wheel);
        toggle('ae-wheel-copy-editor', wheel);
        toggle('ae-wheel-style-field', wheel);
        toggle('ae-hero-art-toggle', wheel);
        var mapPrizes = $('ae-map-prizes');
        var mapRedemption = $('ae-map-redemption');
        var mapVisual = $('ae-map-visual');
        if (scratch) {
          if (mapPrizes) mapPrizes.innerHTML = '<span><b>刮開後的獎品卡</b><small>獎名、圖片、說明、中獎機率與每個獎品的兌獎事項</small></span><em>到獎品修改</em>';
          if (mapRedemption) mapRedemption.innerHTML = '<span><b>兌獎說明</b><small>活動層級的兌獎規則，可在下方文案區修改</small></span><em>預覽</em>';
          if (mapVisual) mapVisual.innerHTML = '<span><b>Logo／刮膜／文案／分享卡</b><small>可在下方依這檔活動調整</small></span><em>到畫面設定</em>';
        }
        // 情境選單：刮刮樂沒有「我的獎項」歷史區
        var select = $('ae-preview-scenario');
        if (select) {
          Array.from(select.options).forEach(function (opt) {
            if (opt.value === 'history') opt.hidden = scratch;
            if (opt.value === 'ready') opt.textContent = scratch ? '一般可刮（還有 3 次）' : '一般可抽（還有 3 次）';
            if (opt.value === 'redemption') opt.textContent = scratch ? '刮開後展開兌獎說明' : '展開兌獎說明';
          });
          if (scratch && select.value === 'history') select.value = 'ready';
        }
        var orderNoun = $('ae-prize-order-noun');
        if (orderNoun && scratch) orderNoun.textContent = '獎項清單';
      }

      function escapeHtml(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
      }
      function toLocalDt(ts) {
        if (!ts) return '';
        var d = new Date(ts);
        if (isNaN(d.getTime())) return '';
        var pad = function (n) { return String(n).padStart(2, '0'); };
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +
               'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
      }
      function fromLocalDt(v) {
        if (!v) return null;
        var d = new Date(v);
        return isNaN(d.getTime()) ? null : d.toISOString();
      }

      function safeHex(value, fallback) {
        var v = String(value || '').toUpperCase();
        return /^#[0-9A-F]{6}$/.test(v) ? v : fallback;
      }
      function clamp(value, min, max, fallback) {
        var n = Number(value);
        return isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;
      }
      function collectWheelControls() {
        var result = {};
        Object.keys(WHEEL_COLOR_FIELDS).forEach(function (key) {
          var id = WHEEL_COLOR_FIELDS[key];
          result[key] = safeHex($(id).value, WHEEL_PRESETS.brand[key]);
        });
        result.size = clamp($('ae-wheel-size').value, 260, 360, 318);
        result.line_width = clamp($('ae-wheel-line-width').value, 1, 8, 4);
        return result;
      }
      function updateWheelOutputs() {
        Object.keys(WHEEL_COLOR_FIELDS).forEach(function (key) {
          var id = WHEEL_COLOR_FIELDS[key];
          var output = document.querySelector('output[data-for="' + id + '"]');
          if (output) output.textContent = String($(id).value || '').toUpperCase();
        });
        $('ae-wheel-size-output').textContent = $('ae-wheel-size').value + ' px';
        $('ae-wheel-line-width-output').textContent = $('ae-wheel-line-width').value + ' px';
      }
      function setWheelControls(config) {
        var c = Object.assign({}, WHEEL_PRESETS.brand, config || {});
        Object.keys(WHEEL_COLOR_FIELDS).forEach(function (key) {
          $(WHEEL_COLOR_FIELDS[key]).value = safeHex(c[key], WHEEL_PRESETS.brand[key]);
        });
        $('ae-wheel-size').value = clamp(c.size, 260, 360, 318);
        $('ae-wheel-line-width').value = clamp(c.line_width, 1, 8, 4);
        updateWheelOutputs();
      }
      function applyWheelPreset(name) {
        var preset = WHEEL_PRESETS[name] || WHEEL_PRESETS.brand;
        setWheelControls(preset);
      }
      function scheduleVisualPreview() {
        clearTimeout(visualPreviewTimer);
        visualPreviewTimer = setTimeout(updatePreview, 180);
      }
      function collectCopyControls() {
        var result = {};
        Object.keys(COPY_FIELDS).forEach(function (key) {
          var el = $(COPY_FIELDS[key]);
          var value = el ? String(el.value || '').slice(0, 220) : COPY_DEFAULTS[key];
          result[key] = value || COPY_DEFAULTS[key];
        });
        return result;
      }
      function setCopyControls(copy) {
        var saved = copy && typeof copy === 'object' ? copy : {};
        Object.keys(COPY_FIELDS).forEach(function (key) {
          var el = $(COPY_FIELDS[key]);
          if (el) el.value = typeof saved[key] === 'string' ? saved[key] : COPY_DEFAULTS[key];
        });
      }
      function defaultPrizeColor(prize, index) {
        if (prize && prize.is_grand_prize) return safeHex($('ae-wheel-grand').value, '#F9C73B');
        var ci = index % 2;
        if (index === currentPrizes.length - 1 && currentPrizes.length > 2 && ci === 0) ci = 1;
        return safeHex($(ci === 0 ? 'ae-wheel-slice-1' : 'ae-wheel-slice-2').value, ci === 0 ? '#FFFFFF' : '#FFF3C4');
      }
      function collectPrizeColorControls() {
        var colors = {};
        $$('#ae-prize-color-grid input[data-prize-color-id]').forEach(function (input) {
          colors[String(input.getAttribute('data-prize-color-id'))] = safeHex(input.value, '#FFFFFF');
        });
        return colors;
      }
      function renderPrizeColorControls(savedColors) {
        var grid = $('ae-prize-color-grid');
        if (!grid) return;
        var saved = savedColors && typeof savedColors === 'object' ? savedColors : {};
        if (!currentPrizes.length) {
          grid.innerHTML = '<span class="muted">還沒有獎項，新增獎項後就可以逐格配色。</span>';
          return;
        }
        grid.innerHTML = currentPrizes.map(function (prize, index) {
          var id = String(prize.id);
          var color = safeHex(saved[id], defaultPrizeColor(prize, index));
          return '<label class="ae-prize-color-control">' +
            '<input type="color" value="' + color + '" data-prize-color-id="' + escapeHtml(id) + '" />' +
            '<span><b>' + escapeHtml(prize.name || '未命名獎項') + '</b>' +
              '<small>' + (prize.is_grand_prize ? '大獎 · ' : '') + color + '</small></span>' +
          '</label>';
        }).join('');
        $$('#ae-prize-color-grid input[data-prize-color-id]').forEach(function (input) {
          input.addEventListener('input', function () {
            var note = input.parentElement && input.parentElement.querySelector('small');
            var prize = currentPrizes.find(function (p) { return String(p.id) === String(input.getAttribute('data-prize-color-id')); });
            var color = safeHex(input.value, '#FFFFFF');
            if (note) note.textContent = (prize && prize.is_grand_prize ? '大獎 · ' : '') + color;
            if ($('ae-wheel-style')) $('ae-wheel-style').value = 'custom';
            scheduleVisualPreview();
          });
        });
      }
      function applyDistinctPrizeColors() {
        var colors = {};
        currentPrizes.forEach(function (prize, index) {
          colors[String(prize.id)] = prize.is_grand_prize ? '#FF8A5C' : PRIZE_COLOR_PALETTE[index % PRIZE_COLOR_PALETTE.length];
        });
        renderPrizeColorControls(colors);
        if ($('ae-wheel-style')) $('ae-wheel-style').value = 'custom';
        scheduleVisualPreview();
      }

      function collectActivityForm() {
        var existingRules = currentActivity && currentActivity.rules && typeof currentActivity.rules === 'object'
          ? JSON.parse(JSON.stringify(currentActivity.rules)) : {};
        if ($('ae-show-hero-art')) {
          var existingUi = existingRules.ui && typeof existingRules.ui === 'object' ? existingRules.ui : {};
          if (isScratchActivity()) {
            // 刮刮樂：只寫自己的欄位，輪盤設定原封不動保留（同一活動改類型時不會互相蓋掉）
            existingRules.ui = Object.assign({}, existingUi, {
              logo_url: $('ae-logo-url').value.trim() || null,
              scratch: collectScratchControls(),
              copy: Object.assign({}, existingUi.copy && typeof existingUi.copy === 'object' ? existingUi.copy : {}, collectScratchCopyControls())
            });
          } else {
            existingRules.ui = Object.assign({}, existingUi, {
              show_hero_art: $('ae-show-hero-art').checked,
              logo_url: $('ae-logo-url').value.trim() || null,
              wheel_style: $('ae-wheel-style').value || 'brand',
              wheel_custom: collectWheelControls(),
              wheel_slice_colors: collectPrizeColorControls(),
              copy: Object.assign({}, existingUi.copy && typeof existingUi.copy === 'object' ? existingUi.copy : {}, collectCopyControls())
            });
          }
        }
        return {
          slug: $('ae-slug').value.trim(),
          name: $('ae-name').value.trim(),
          description: $('ae-desc').value.trim(),
          game_type: $('ae-game-type').value,
          status: $('ae-status-select').value,
          start_at: fromLocalDt($('ae-start').value),
          end_at: fromLocalDt($('ae-end').value),
          cover_image_url: $('ae-cover').value.trim() || null,
          daily_plays_per_user: $('ae-daily-limit').value ? Number($('ae-daily-limit').value) : null,
          require_follow_oa: $('ae-require-follow').checked,
          liff_id_override: $('ae-liff-override').value.trim() || null,
          base_plays_per_user: $('ae-base-plays').value === '' ? 1 : Math.max(0, Number($('ae-base-plays').value) || 0),
          referral_bonus_per: Number($('ae-ref-per').value || 0),
          referral_bonus_max: Number($('ae-ref-max').value || 0),
          referral_invites_per_bonus: Math.max(1, Number($('ae-ref-need').value || 1)),
          rules: existingRules
        };
      }

      function updateLogoPreview() {
        var wrap = $('ae-logo-preview');
        if (!wrap) return;
        var src = ($('ae-logo-url').value || '').trim() || '/images/openrice-wordmark.png';
        wrap.innerHTML = '<img src="' + escapeHtml(src) + '" alt="Logo 預覽" />' +
          '<small>' + (($('ae-logo-url').value || '').trim() ? '自訂 Logo' : '目前使用預設 OpenRice Logo') + '</small>';
      }

      function fillActivityForm(a) {
        $('ae-slug').value = a.slug || '';
        $('ae-name').value = a.name || '';
        $('ae-desc').value = a.description || '';
        $('ae-game-type').value = a.game_type || 'wheel';
        $('ae-status-select').value = a.status || 'draft';
        $('ae-start').value = toLocalDt(a.start_at);
        $('ae-end').value = toLocalDt(a.end_at);
        $('ae-cover').value = a.cover_image_url || '';
        $('ae-daily-limit').value = a.daily_plays_per_user != null ? a.daily_plays_per_user : '';
        $('ae-require-follow').checked = Boolean(a.require_follow_oa);
        $('ae-liff-override').value = a.liff_id_override || '';
        $('ae-base-plays').value = a.base_plays_per_user != null ? a.base_plays_per_user : 1;
        $('ae-ref-per').value = a.referral_bonus_per != null ? a.referral_bonus_per : 0;
        $('ae-ref-need').value = a.referral_invites_per_bonus != null ? a.referral_invites_per_bonus : 1;
        $('ae-ref-max').value = a.referral_bonus_max != null ? a.referral_bonus_max : 0;
        var ui = a.rules && typeof a.rules === 'object' && a.rules.ui && typeof a.rules.ui === 'object'
          ? a.rules.ui : {};
        if ($('ae-show-hero-art')) {
          $('ae-show-hero-art').checked = typeof ui.show_hero_art === 'boolean'
            ? ui.show_hero_art
            : a.slug !== 'share-miles';
        }
        if ($('ae-logo-url')) $('ae-logo-url').value = ui.logo_url || '';
        if ($('ae-wheel-style')) {
          var selectedStyle = ['brand', 'clean', 'bold', 'custom'].indexOf(ui.wheel_style) >= 0 ? ui.wheel_style : 'brand';
          $('ae-wheel-style').value = selectedStyle;
          setWheelControls(Object.assign({}, WHEEL_PRESETS[selectedStyle] || WHEEL_PRESETS.brand, ui.wheel_custom || {}));
        }
        renderPrizeColorControls(ui.wheel_slice_colors);
        setCopyControls(ui.copy);
        setScratchControls(ui.scratch, ui.copy);
        applyGameTypeUi();
        if (typeof renderAllSharePreviews === 'function') renderAllSharePreviews();
        updateLogoPreview();
        updateRefHint();
      }

      function loadActivity() {
        if (!activityId) return Promise.resolve();
        return fetch('/admin/activities/api/' + activityId)
          .then(function (r) { return r.json(); })
          .then(function (resp) {
            if (!resp.ok) { alert('載入失敗'); return; }
            currentActivity = resp.activity;
            currentPrizes = resp.prizes || [];
            effectiveLiffId = resp.effective_liff_id || '';
            fillActivityForm(resp.activity);
            renderPrizes();
            updateLiffLink();
            updateLinkStatusBanner();
          });
      }

      function updateLiffLink() {
        if (!currentActivity) return;
        var gt = currentActivity.game_type || 'wheel';
        var directUrl = location.origin + '/games/' + gt + '/' + encodeURIComponent(currentActivity.slug);
        // LIFF 短網址：用 effective LIFF ID + 子路徑（LIFF SDK 會 append 到 Endpoint URL）
        var liffShareUrl = effectiveLiffId
          ? 'https://liff.line.me/' + effectiveLiffId + '/' + gt + '/' + encodeURIComponent(currentActivity.slug)
          : '（活動連結還沒開通，請找系統管理員設定）';
        var liffEl = $('ae-liff-share-url');
        var directEl = $('ae-direct-url');
        var prev = $('ae-preview-link');
        if (liffEl) liffEl.textContent = liffShareUrl;
        if (directEl) directEl.textContent = directUrl;
        if (prev) prev.href = directUrl + '?preview=1';
        rebuildPreviewScenarios();
        updatePreview();
      }

      // ---- 畫面設定與安全測試工作台 ----
      function rebuildPreviewScenarios() {
        var select = $('ae-preview-scenario');
        if (!select) return;
        var keep = select.value || 'first_open';
        Array.from(select.options).forEach(function (opt) {
          if (String(opt.value).indexOf('prize:') === 0) opt.remove();
        });
        currentPrizes.forEach(function (p) {
          var opt = document.createElement('option');
          opt.value = 'prize:' + p.id;
          opt.textContent = '抽中：「' + (p.name || '未命名獎品') + '」';
          select.appendChild(opt);
        });
        if (Array.from(select.options).some(function (o) { return o.value === keep; })) select.value = keep;
      }

      function previewUrl() {
        if (!currentActivity) return '';
        var scenario = ($('ae-preview-scenario') && $('ae-preview-scenario').value) || 'first_open';
        var params = new URLSearchParams();
        params.set('preview', '1');
        params.set('preview_scenario', scenario);
        if ($('ae-show-hero-art')) {
          params.set('preview_ui', JSON.stringify(isScratchActivity() ? {
            logo_url: $('ae-logo-url').value.trim() || null,
            scratch: collectScratchControls(),
            copy: collectScratchCopyControls()
          } : {
            show_hero_art: $('ae-show-hero-art').checked,
            logo_url: $('ae-logo-url').value.trim() || null,
            wheel_style: $('ae-wheel-style').value || 'brand',
            wheel_custom: collectWheelControls(),
            wheel_slice_colors: collectPrizeColorControls(),
            copy: collectCopyControls()
          }));
        }
        return location.origin + '/games/' + (currentActivity.game_type || 'wheel') + '/' +
          encodeURIComponent(currentActivity.slug) + '?' + params.toString();
      }

