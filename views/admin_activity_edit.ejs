<%-
  include('layout', {
    user: user,
    isAdmin: isAdmin,
    bodyClass: bodyClass,
    body: `
    <section class="card">
      <div class="ae-head">
        <a href="/admin/activities" class="ae-back">← 回列表</a>
        <h1 id="ae-title">${activityId ? '編輯活動' : '新增活動'}</h1>
        ${activityId ? `<a href="/admin/activities/${activityId}/players" class="ae-secondary-btn" style="margin-left:auto;">玩家數據 ›</a>` : ''}
        <div id="ae-status" class="muted" style="font-size:12px;"></div>
      </div>

      <h2>1. 用戶畫面與活動規則</h2>
      <div class="ae-grid">
        <label class="ae-field">
          <span>活動名稱 *</span>
          <input type="text" id="ae-name" placeholder="例：夏日大轉盤" />
        </label>
        <label class="ae-field">
          <span>slug *（網址用，只接受英數字與 -）</span>
          <input type="text" id="ae-slug" placeholder="summer-wheel" />
        </label>
        <label class="ae-field">
          <span>遊戲類型</span>
          <select id="ae-game-type">
            ${gameTypes.map(t => `<option value="${t}">${({wheel:'輪盤抽獎',fortune:'每日抽籤',scratch:'刮刮樂',slot:'老虎機',claim:'領取優惠券'})[t] || t}</option>`).join('')}
          </select>
        </label>
        <label class="ae-field">
          <span>狀態</span>
          <select id="ae-status-select">
            ${statuses.map(s => `<option value="${s}">${({draft:'草稿',active:'進行中',paused:'暫停',ended:'已結束'})[s] || s}</option>`).join('')}
          </select>
        </label>
        <label class="ae-field">
          <span>開始時間（到點自動變「進行中」）</span>
          <input type="datetime-local" id="ae-start" />
        </label>
        <label class="ae-field">
          <span>結束時間（到點自動變「已結束」）</span>
          <input type="datetime-local" id="ae-end" />
        </label>
        <label class="ae-field">
          <span>每用戶每天可玩次數（空白 = 無限）</span>
          <input type="number" id="ae-daily-limit" min="0" placeholder="1" />
        </label>
        <label class="ae-field">
          <span>每用戶基礎可玩次數 *</span>
          <input type="number" id="ae-base-plays" min="1" value="1" />
        </label>
        <label class="ae-field">
          <span>要邀請幾位朋友才加一次（1 = 每邀 1 人就加）</span>
          <input type="number" id="ae-ref-need" min="1" value="1" />
        </label>
        <label class="ae-field">
          <span>湊滿之後加幾次（0 = 關閉邀請）</span>
          <input type="number" id="ae-ref-per" min="0" value="0" />
          <small class="muted" id="ae-ref-hint" style="font-size:11px;line-height:1.5;"></small>
        </label>
        <label class="ae-field">
          <span>邀請加次數上限（設 0 ＝ 完全不會加次，邀請等於白邀）</span>
          <input type="number" id="ae-ref-max" min="0" value="0" />
        </label>
        <label class="ae-field">
          <span>封面圖（可選 — 貼 URL 或直接上傳，建議 1600×900 / 16:9，最大 2MB）</span>
          <div style="display:flex;gap:6px;align-items:stretch;">
            <input type="text" id="ae-cover" placeholder="https://..." style="flex:1;" />
            <input type="file" id="ae-cover-file" accept="image/png,image/jpeg" style="display:none;" />
            <button type="button" id="ae-cover-upload" style="padding:8px 14px;background:#fff;border:1px solid #ECECEE;border-radius:6px;cursor:pointer;font-size:12px;font-family:inherit;">上傳</button>
            <button type="button" id="ae-cover-clear" hidden style="padding:8px 14px;background:#fff;border:1px solid #FCA5A5;color:#DC2626;border-radius:6px;cursor:pointer;font-size:12px;font-family:inherit;">刪除</button>
          </div>
          <div id="ae-cover-status" style="font-size:11px;color:#6B6B70;min-height:14px;"></div>
          <div id="ae-cover-preview" style="margin-top:6px;"></div>
        </label>
        <label class="ae-field ae-field-full">
          <span>活動說明</span>
          <textarea id="ae-desc" rows="3" placeholder="顯示給用戶看的活動介紹"></textarea>
        </label>
        <label class="ae-field ae-field-full">
          <input type="checkbox" id="ae-require-follow" /> 需先加入 LINE OA 好友才能玩
        </label>
        <label class="ae-field ae-field-full">
          <span>自訂活動入口（進階設定，留空就用系統預設，不確定就不要動）</span>
          <input type="text" id="ae-liff-override" placeholder="例：1234567890-abcDEF12（特殊拉新活動才需要）" />
          <span class="muted" style="font-size:11px;font-weight:400;">99% 活動留空就好。需要 Aggressive 加好友等特殊設定時才填獨立 LIFF ID。</span>
        </label>
      </div>

      <div class="ae-actions">
        <button type="button" class="ae-primary-btn" id="ae-save">${activityId ? '更新' : '儲存並繼續設定獎品'}</button>
        <span class="muted" style="margin-left:12px;font-size:12px;" id="ae-save-status"></span>
      </div>
    </section>

    ${activityId ? `
    <section class="card" id="ae-preview-studio">
      <div class="ae-head" style="margin-bottom:8px;">
        <div>
          <h2 style="margin:0;">2. 畫面設定與測試</h2>
          <p class="muted" style="font-size:12px;margin:5px 0 0;">選一個畫面就能直接查看，不必找好友，也不用真的抽獎。</p>
        </div>
        <span class="ae-safe-badge">安全測試模式</span>
      </div>

      <div class="ae-preview-grid">
        <div class="ae-preview-controls">
          <div class="ae-safe-note">
            <strong>可以放心測</strong>
            <span>不扣抽獎次數、不扣獎品庫存、不新增中獎紀錄，也不需要 LINE 好友。</span>
          </div>

          <label class="ae-field ae-scenario-field">
            <span>想看哪一個用戶畫面？</span>
            <select id="ae-preview-scenario">
              <option value="first_open">第一次開啟（首次 1 次）</option>
              <option value="ready">一般可抽（還有 3 次）</option>
              <option value="last">最後 1 次</option>
              <option value="invite">次數用完，可邀朋友</option>
              <option value="done">全部玩完</option>
              <option value="history">抽完後，獎項留在頁面</option>
              <option value="redemption">展開兌獎說明</option>
            </select>
          </label>
          <div class="ae-preview-actions">
            <button type="button" class="ae-primary-btn" id="ae-refresh-preview">更新右側預覽</button>
            <button type="button" class="ae-secondary-btn" id="ae-open-preview">另開測試畫面</button>
          </div>
          <p class="muted" style="font-size:11px;line-height:1.55;margin:0;">剛改完文字或獎品時，請先按上方「更新」存檔，再更新預覽。</p>

          <h3 class="ae-map-title">畫面位置叫什麼？在哪裡改？</h3>
          <div class="ae-ui-map">
            <button type="button" class="ae-map-row" data-ae-focus="ae-name">
              <span><b>頁首主標題</b><small>活動最上方的大字</small></span><em>到欄位修改</em>
            </button>
            <button type="button" class="ae-map-row" data-ae-focus="ae-desc">
              <span><b>標題下方介紹</b><small>主標題下面的小字說明</small></span><em>到欄位修改</em>
            </button>
            <button type="button" class="ae-map-row" data-ae-focus="ae-base-plays">
              <span><b>剩餘次數／邀請規則</b><small>「還可以轉幾次」與找朋友文案</small></span><em>到欄位修改</em>
            </button>
            <button type="button" class="ae-map-row" data-ae-scroll="ae-prizes-section">
              <span><b>轉盤格與中獎畫面</b><small>獎名、圖片、說明、排序與大獎效果</small></span><em>到獎品修改</em>
            </button>
            <button type="button" class="ae-map-row" data-ae-scenario="redemption">
              <span><b>兌獎說明</b><small>這檔活動目前使用固定版文字</small></span><em class="ae-fixed">預覽固定版</em>
            </button>
            <button type="button" class="ae-map-row" data-ae-scroll="ae-visual-settings">
              <span><b>Logo／右上插圖／轉盤樣式</b><small>可在下方依這檔活動調整</small></span><em>到視覺設定</em>
            </button>
          </div>

          <section class="ae-visual-box" id="ae-visual-settings">
            <div>
              <h3>活動視覺</h3>
              <p>只影響這檔活動；右側預覽可立即確認結果。</p>
            </div>
            <label class="ae-visual-toggle">
              <input type="checkbox" id="ae-show-hero-art" checked />
              <span><b>顯示標題右上角插圖</b><small>取消勾選即可移除目前的火鍋線稿</small></span>
            </label>
            <label class="ae-field">
              <span>頁首 Logo</span>
              <div class="ae-upload-row">
                <input type="text" id="ae-logo-url" placeholder="留空使用 OpenRice Logo，也可貼圖片網址" />
                <input type="file" id="ae-logo-file" accept="image/png,image/jpeg" hidden />
                <button type="button" class="ae-secondary-btn" id="ae-logo-upload">上傳</button>
                <button type="button" class="ae-secondary-btn" id="ae-logo-clear">恢復預設</button>
              </div>
              <span class="muted" id="ae-logo-status"></span>
              <span class="ae-logo-preview" id="ae-logo-preview"></span>
            </label>
            <label class="ae-field">
              <span>輪盤樣式</span>
              <select id="ae-wheel-style">
                <option value="brand">OpenRice 黃白</option>
                <option value="clean">白色簡約</option>
                <option value="bold">品牌黃醒目</option>
              </select>
            </label>
            <div class="ae-visual-actions">
              <button type="button" class="ae-primary-btn" id="ae-save-visual">儲存視覺並更新預覽</button>
              <span class="muted" id="ae-visual-save-status"></span>
            </div>
          </section>
        </div>

        <div class="ae-phone-area">
          <div class="ae-phone-label"><span class="ae-live-dot"></span><span id="ae-preview-label">第一次開啟（首次 1 次）</span></div>
          <div class="ae-phone-frame">
            <iframe id="ae-preview-frame" title="活動用戶畫面安全預覽"></iframe>
          </div>
        </div>
      </div>
    </section>

    <section class="card" id="ae-prizes-section">
      <div class="ae-head" style="margin-bottom:8px;">
        <h2 style="margin:0;">3. 獎品池</h2>
        <button type="button" class="ae-secondary-btn" id="ae-add-prize">＋ 新增獎品</button>
      </div>
      <p class="muted" style="font-size:12px;"><span id="ae-prize-order-noun">遊戲</span>照「位置」由小到大排。中獎機率直接填百分比，全部加起來要等於 100。「庫存」留空 = 不限量。每一列都能直接查看抽中後的畫面。</p>
      <div id="ae-pct-bar"></div>
      <div class="table-wrap">
        <table class="ae-prize-table">
          <thead>
            <tr>
              <th>位置</th>
              <th>獎品名稱</th>
              <th>類型</th>
              <th style="text-align:right;">你填的</th>
              <th style="text-align:right;">實際機率</th>
              <th style="text-align:right;">庫存</th>
              <th>大獎</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="ae-prize-tbody">
            <tr><td colspan="8" class="muted" style="text-align:center;padding:18px 0;">載入中…</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <h2>4. 活動連結</h2>

      <div id="ae-link-status-banner"></div>

      <div class="ae-link-title">給用戶用（LIFF 分享短網址）</div>
      <p class="muted" style="font-size:12px;margin:4px 0 8px;">
        把這個貼到 LINE OA 圖文選單、推播訊息或 QR Code。用戶在 LINE 內點開會自動 login 進活動頁。
      </p>
      <div class="ae-link-box">
        <code id="ae-liff-share-url">—</code>
        <button type="button" class="ae-secondary-btn" id="ae-copy-liff">複製</button>
      </div>

      <div class="ae-link-title" style="margin-top:16px;">桌機預覽用（直連）</div>
      <p class="muted" style="font-size:12px;margin:4px 0 8px;">
        在電腦瀏覽器看 UI，<strong>不能真抽</strong>（避免汙染資料）。
      </p>
      <div class="ae-link-box">
        <code id="ae-direct-url">—</code>
        <button type="button" class="ae-secondary-btn" id="ae-copy-direct">複製</button>
        <a href="#" target="_blank" rel="noopener" id="ae-preview-link" class="ae-secondary-btn">在新視窗開啟</a>
      </div>
    </section>
    ` : `
    <section class="card" style="background:#f9fafb;text-align:center;padding:32px 16px;">
      <div class="muted">儲存基本資訊後，會進入獎品池編輯</div>
    </section>
    `}

    <!-- 獎品編輯 modal -->
    <div id="prize-modal" class="ae-modal" hidden>
      <div class="ae-modal-inner">
        <div class="ae-modal-head">
          <h3 id="prize-modal-title">新增獎品</h3>
          <button type="button" class="ae-modal-close" id="prize-modal-close">×</button>
        </div>
        <div class="ae-grid">
          <label class="ae-field ae-field-full">
            <span>獎品名稱 *（顯示在轉盤格與中獎結果大字）</span>
            <input type="text" id="pm-name" placeholder="例：Rice Dollar $100" />
          </label>
          <label class="ae-field">
            <span>獎品類型</span>
            <select id="pm-type">
              <option value="rice_dollar">Rice Dollar</option>
              <option value="coupon_code">優惠券碼</option>
              <option value="badge">徽章 / 虛擬</option>
              <option value="physical">實體獎品</option>
              <option value="none">銘謝惠顧</option>
            </select>
          </label>
          <label class="ae-field">
            <span>位置（顯示順序）</span>
            <input type="number" id="pm-position" min="0" value="0" />
          </label>
          <label class="ae-field">
            <span>中獎機率（%）</span>
            <input type="number" id="pm-weight" min="0" step="0.01" value="1" />
            <small class="muted" id="pm-weight-hint" style="font-size:11px;line-height:1.5;"></small>
          </label>
          <label class="ae-field">
            <span>庫存（空白 = 無限）</span>
            <input type="number" id="pm-stock" min="0" placeholder="" />
          </label>
          <label class="ae-field">
            <span>中獎結果圖片 URL（可選）</span>
            <input type="text" id="pm-image" placeholder="https://..." />
          </label>
          <label class="ae-field ae-field-full">
            <span>中獎結果說明（顯示在獎名下方）</span>
            <textarea id="pm-desc" rows="2"></textarea>
          </label>
          <label class="ae-field ae-field-full" id="pm-value-field">
            <span id="pm-value-label">獎勵金額 / 內容</span>
            <input type="text" id="pm-value" placeholder="100" />
            <small class="muted" id="pm-extra-note" style="font-size:11px;line-height:1.5;" hidden></small>
          </label>
          <label class="ae-field ae-field-full">
            <span>這個獎品等於幾哩（可留空）</span>
            <input type="number" id="pm-miles" min="0" placeholder="例：500" />
            <small class="muted" style="font-size:11px;line-height:1.5;">填了之後，中到這個獎的人會出現在「活動成效 → 誰中了什麼獎」的要發哩數名單裡，你照名單人工入帳。沒有要發哩數就留空。</small>
          </label>
          <label class="ae-field ae-field-full">
            <input type="checkbox" id="pm-grand" /> 標記為大獎（UI 動畫加強）
          </label>
        </div>
        <div class="ae-actions">
          <button type="button" class="ae-primary-btn" id="pm-save">儲存獎品</button>
          <button type="button" class="ae-secondary-btn" id="pm-cancel">取消</button>
        </div>
      </div>
    </div>

    <script>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var $$ = function (sel, ctx) { return Array.from((ctx || document).querySelectorAll(sel)); };
      var activityId = ${activityId || 'null'};
      var currentActivity = null;
      var currentPrizes = [];
      var editingPrizeId = null;
      var effectiveLiffId = '';

      function escapeHtml(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
      }
      function toLocalDt(ts) {
        if (!ts) return '';
        var d = new Date(ts);
        if (isNaN(d.getTime())) return '';
        var pad = function (n) { return String(n).padStart(2, '0'); };
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +
               'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
      }
      function fromLocalDt(v) {
        if (!v) return null;
        var d = new Date(v);
        return isNaN(d.getTime()) ? null : d.toISOString();
      }

      function collectActivityForm() {
        var existingRules = currentActivity && currentActivity.rules && typeof currentActivity.rules === 'object'
          ? JSON.parse(JSON.stringify(currentActivity.rules)) : {};
        if ($('ae-show-hero-art')) {
          var existingUi = existingRules.ui && typeof existingRules.ui === 'object' ? existingRules.ui : {};
          existingRules.ui = Object.assign({}, existingUi, {
            show_hero_art: $('ae-show-hero-art').checked,
            logo_url: $('ae-logo-url').value.trim() || null,
            wheel_style: $('ae-wheel-style').value || 'brand'
          });
        }
        return {
          slug: $('ae-slug').value.trim(),
          name: $('ae-name').value.trim(),
          description: $('ae-desc').value.trim(),
          game_type: $('ae-game-type').value,
          status: $('ae-status-select').value,
          start_at: fromLocalDt($('ae-start').value),
          end_at: fromLocalDt($('ae-end').value),
          cover_image_url: $('ae-cover').value.trim() || null,
          daily_plays_per_user: $('ae-daily-limit').value ? Number($('ae-daily-limit').value) : null,
          require_follow_oa: $('ae-require-follow').checked,
          liff_id_override: $('ae-liff-override').value.trim() || null,
          base_plays_per_user: Number($('ae-base-plays').value || 1),
          referral_bonus_per: Number($('ae-ref-per').value || 0),
          referral_bonus_max: Number($('ae-ref-max').value || 0),
          referral_invites_per_bonus: Math.max(1, Number($('ae-ref-need').value || 1)),
          rules: existingRules
        };
      }

      function updateLogoPreview() {
        var wrap = $('ae-logo-preview');
        if (!wrap) return;
        var src = ($('ae-logo-url').value || '').trim() || '/images/openrice-wordmark.png';
        wrap.innerHTML = '<img src="' + escapeHtml(src) + '" alt="Logo 預覽" />' +
          '<small>' + (($('ae-logo-url').value || '').trim() ? '自訂 Logo' : '目前使用預設 OpenRice Logo') + '</small>';
      }

      function fillActivityForm(a) {
        $('ae-slug').value = a.slug || '';
        $('ae-name').value = a.name || '';
        $('ae-desc').value = a.description || '';
        $('ae-game-type').value = a.game_type || 'wheel';
        $('ae-status-select').value = a.status || 'draft';
        $('ae-start').value = toLocalDt(a.start_at);
        $('ae-end').value = toLocalDt(a.end_at);
        $('ae-cover').value = a.cover_image_url || '';
        $('ae-daily-limit').value = a.daily_plays_per_user != null ? a.daily_plays_per_user : '';
        $('ae-require-follow').checked = Boolean(a.require_follow_oa);
        $('ae-liff-override').value = a.liff_id_override || '';
        $('ae-base-plays').value = a.base_plays_per_user != null ? a.base_plays_per_user : 1;
        $('ae-ref-per').value = a.referral_bonus_per != null ? a.referral_bonus_per : 0;
        $('ae-ref-need').value = a.referral_invites_per_bonus != null ? a.referral_invites_per_bonus : 1;
        $('ae-ref-max').value = a.referral_bonus_max != null ? a.referral_bonus_max : 0;
        var ui = a.rules && typeof a.rules === 'object' && a.rules.ui && typeof a.rules.ui === 'object'
          ? a.rules.ui : {};
        if ($('ae-show-hero-art')) {
          $('ae-show-hero-art').checked = typeof ui.show_hero_art === 'boolean'
            ? ui.show_hero_art
            : a.slug !== 'share-miles';
        }
        if ($('ae-logo-url')) $('ae-logo-url').value = ui.logo_url || '';
        if ($('ae-wheel-style')) {
          $('ae-wheel-style').value = ['brand', 'clean', 'bold'].indexOf(ui.wheel_style) >= 0 ? ui.wheel_style : 'brand';
        }
        updateLogoPreview();
        updateRefHint();
      }

      function loadActivity() {
        if (!activityId) return Promise.resolve();
        return fetch('/admin/activities/api/' + activityId)
          .then(function (r) { return r.json(); })
          .then(function (resp) {
            if (!resp.ok) { alert('載入失敗'); return; }
            currentActivity = resp.activity;
            currentPrizes = resp.prizes || [];
            effectiveLiffId = resp.effective_liff_id || '';
            fillActivityForm(resp.activity);
            renderPrizes();
            updateLiffLink();
            updateLinkStatusBanner();
          });
      }

      function updateLiffLink() {
        if (!currentActivity) return;
        var gt = currentActivity.game_type || 'wheel';
        var directUrl = location.origin + '/games/' + gt + '/' + encodeURIComponent(currentActivity.slug);
        // LIFF 短網址：用 effective LIFF ID + 子路徑（LIFF SDK 會 append 到 Endpoint URL）
        var liffShareUrl = effectiveLiffId
          ? 'https://liff.line.me/' + effectiveLiffId + '/' + gt + '/' + encodeURIComponent(currentActivity.slug)
          : '（活動連結還沒開通，請找系統管理員設定）';
        var liffEl = $('ae-liff-share-url');
        var directEl = $('ae-direct-url');
        var prev = $('ae-preview-link');
        if (liffEl) liffEl.textContent = liffShareUrl;
        if (directEl) directEl.textContent = directUrl;
        if (prev) prev.href = directUrl + '?preview=1';
        rebuildPreviewScenarios();
        updatePreview();
      }

      // ---- 畫面設定與安全測試工作台 ----
      function rebuildPreviewScenarios() {
        var select = $('ae-preview-scenario');
        if (!select) return;
        var keep = select.value || 'first_open';
        Array.from(select.options).forEach(function (opt) {
          if (String(opt.value).indexOf('prize:') === 0) opt.remove();
        });
        currentPrizes.forEach(function (p) {
          var opt = document.createElement('option');
          opt.value = 'prize:' + p.id;
          opt.textContent = '抽中：「' + (p.name || '未命名獎品') + '」';
          select.appendChild(opt);
        });
        if (Array.from(select.options).some(function (o) { return o.value === keep; })) select.value = keep;
      }

      function previewUrl() {
        if (!currentActivity) return '';
        var scenario = ($('ae-preview-scenario') && $('ae-preview-scenario').value) || 'first_open';
        return location.origin + '/games/' + (currentActivity.game_type || 'wheel') + '/' +
          encodeURIComponent(currentActivity.slug) + '?preview=1&preview_scenario=' + encodeURIComponent(scenario);
      }

      function updatePreview() {
        var frame = $('ae-preview-frame');
        var select = $('ae-preview-scenario');
        if (!frame || !select || !currentActivity) return;
        var url = previewUrl();
        // 加時間戳，確保剛存檔的文字與圖片不會被 iframe 快取住。
        frame.src = url + '&preview_refresh=' + Date.now();
        var selected = select.options[select.selectedIndex];
        var label = $('ae-preview-label');
        if (label) label.textContent = selected ? selected.textContent : '活動畫面';
      }

      var previewSelect = $('ae-preview-scenario');
      if (previewSelect) previewSelect.addEventListener('change', updatePreview);
      var refreshPreviewBtn = $('ae-refresh-preview');
      if (refreshPreviewBtn) refreshPreviewBtn.addEventListener('click', updatePreview);
      var openPreviewBtn = $('ae-open-preview');
      if (openPreviewBtn) openPreviewBtn.addEventListener('click', function () {
        var url = previewUrl();
        if (url) window.open(url, '_blank', 'noopener');
      });

      $$('.ae-map-row[data-ae-focus]').forEach(function (row) {
        row.addEventListener('click', function () {
          var el = $(row.getAttribute('data-ae-focus'));
          if (!el) return;
          el.scrollIntoView({ behavior: 'smooth', block: 'center' });
          el.focus();
          el.classList.remove('ae-field-flash');
          void el.offsetWidth;
          el.classList.add('ae-field-flash');
        });
      });
      $$('.ae-map-row[data-ae-scroll]').forEach(function (row) {
        row.addEventListener('click', function () {
          var el = $(row.getAttribute('data-ae-scroll'));
          if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
      $$('.ae-map-row[data-ae-scenario]').forEach(function (row) {
        row.addEventListener('click', function () {
          if (!previewSelect) return;
          previewSelect.value = row.getAttribute('data-ae-scenario');
          updatePreview();
          $('ae-preview-studio').scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      function updateLinkStatusBanner() {
        var banner = $('ae-link-status-banner');
        if (!banner) return;
        var s = $('ae-status-select').value;
        var startVal = $('ae-start') ? $('ae-start').value : '';
        var endVal = $('ae-end') ? $('ae-end').value : '';
        var startFuture = startVal && new Date(startVal).getTime() > Date.now();
        var when = function (v) {
          var d = new Date(v);
          return (d.getMonth() + 1) + '/' + d.getDate() + ' ' +
                 String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
        };
        if (s === 'active') {
          banner.setAttribute('style', 'margin:4px 0 12px;font-size:13px;color:#15803d;');
          banner.textContent = '活動進行中，連結可正常使用。' +
            (endVal ? ('到 ' + when(endVal) + ' 會自動結束。') : '');
        } else if (s === 'draft' && startFuture) {
          // 排定上線：不是忘了開，是刻意排的——講清楚免得有人手動提前打開
          banner.setAttribute('style', 'margin:4px 0 12px;padding:10px 12px;background:#F0FDF4;border:1px solid #BBF7D0;border-radius:6px;font-size:13px;color:#166534;');
          banner.textContent = '已排定 ' + when(startVal) + ' 自動上線' +
            (endVal ? ('、' + when(endVal) + ' 自動結束') : '') +
            '，不用自己回來開。在那之前用戶點連結看不到活動。';
        } else {
          var label = ({draft:'草稿',paused:'暫停',ended:'已結束'})[s] || s;
          banner.setAttribute('style', 'margin:4px 0 12px;padding:10px 12px;background:#FFFBEB;border:1px solid #FDE68A;border-radius:6px;font-size:13px;color:#92400E;');
          banner.textContent = '目前狀態是『' + label + '』，用戶點這個連結會看不到活動。' +
            (s === 'draft' ? '想排定時間自動上線，就把上面的開始時間填成未來的時間；要現在就開，把狀態改成『進行中』。'
                           : '請把上方狀態改成『進行中』再按更新。');
        }
      }
      $('ae-status-select').addEventListener('change', updateLinkStatusBanner);
      ['ae-start', 'ae-end'].forEach(function (id) {
        var el = $(id); if (el) el.addEventListener('change', updateLinkStatusBanner);
      });

      // ---- save activity ----
      function saveActivity(statusEl, button) {
        var data = collectActivityForm();
        updateRefHint();
        if (data.referral_bonus_per > 0 && data.referral_bonus_max === 0) {
          if (!confirm('邀請上限目前是 0，用戶邀了朋友也不會增加次數（等於白邀）。\\n\\n要自動把上限設成 10 再儲存嗎？')) {
            return;
          }
          $('ae-ref-max').value = 10;
          data.referral_bonus_max = 10;
        }
        statusEl.textContent = '儲存中…';
        if (button) button.disabled = true;
        var url = activityId ? '/admin/activities/api/' + activityId : '/admin/activities/api';
        var method = activityId ? 'PUT' : 'POST';
        fetch(url, {
          method: method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        })
          .then(function (r) { return r.json(); })
          .then(function (resp) {
            if (!resp.ok) {
              statusEl.textContent = '失敗：' + (resp.detail || resp.error);
              return;
            }
            statusEl.textContent = '已儲存 ' + new Date().toLocaleTimeString();
            if (!activityId) {
              // 新建後跳到編輯頁
              location.href = '/admin/activities/' + resp.activity.id;
            } else {
              currentActivity = resp.activity;
              updateLiffLink();
            }
          })
          .catch(function (e) { statusEl.textContent = '錯誤：' + e.message; })
          .finally(function () { if (button) button.disabled = false; });
      }
      $('ae-save').addEventListener('click', function () {
        saveActivity($('ae-save-status'), $('ae-save'));
      });

      var logoUrlInput = $('ae-logo-url');
      if (logoUrlInput) logoUrlInput.addEventListener('input', updateLogoPreview);
      var logoClearBtn = $('ae-logo-clear');
      if (logoClearBtn) logoClearBtn.addEventListener('click', function () {
        $('ae-logo-url').value = '';
        $('ae-logo-status').textContent = '已恢復預設，按下儲存後生效。';
        updateLogoPreview();
      });
      var logoUploadBtn = $('ae-logo-upload');
      if (logoUploadBtn) logoUploadBtn.addEventListener('click', function () { $('ae-logo-file').click(); });
      var logoFileInput = $('ae-logo-file');
      if (logoFileInput) logoFileInput.addEventListener('change', function () {
        var file = logoFileInput.files && logoFileInput.files[0];
        if (!file) return;
        var statusEl = $('ae-logo-status');
        if (file.size > 2 * 1024 * 1024) {
          statusEl.textContent = '圖片超過 2MB，請壓縮後再上傳。';
          logoFileInput.value = '';
          return;
        }
        statusEl.textContent = '上傳中…';
        logoUploadBtn.disabled = true;
        var form = new FormData();
        form.append('hero', file);
        fetch('/admin/broadcast/hero/upload', { method: 'POST', body: form })
          .then(function (r) { return r.json(); })
          .then(function (resp) {
            if (!resp.ok || !resp.url) throw new Error(resp.error || '上傳失敗');
            $('ae-logo-url').value = resp.url;
            statusEl.textContent = '已上傳，按下儲存後生效。';
            updateLogoPreview();
          })
          .catch(function (e) { statusEl.textContent = '上傳失敗：' + e.message; })
          .finally(function () { logoUploadBtn.disabled = false; logoFileInput.value = ''; });
      });
      var saveVisualBtn = $('ae-save-visual');
      if (saveVisualBtn) saveVisualBtn.addEventListener('click', function () {
        saveActivity($('ae-visual-save-status'), saveVisualBtn);
      });

      // ---- copy link helpers ----
      function bindCopyBtn(btnId, sourceElId) {
        var btn = $(btnId);
        if (!btn) return;
        btn.addEventListener('click', function () {
          var t = $(sourceElId).textContent;
          if (!t || t.startsWith('（')) return;
          navigator.clipboard.writeText(t).then(function () {
            var orig = btn.textContent;
            btn.textContent = '已複製';
            setTimeout(function () { btn.textContent = orig; }, 1200);
          }).catch(function () { alert(t); });
        });
      }
      bindCopyBtn('ae-copy-liff', 'ae-liff-share-url');
      bindCopyBtn('ae-copy-direct', 'ae-direct-url');

      // ---- prizes ----
      // 機率是相對值，加起來不一定是 100。這條就是講白話：
      // 「你填的」跟「實際機率」什麼時候會一樣、不一樣的話怎麼一鍵修好。
      function renderPctBar(totalWeight) {
        var bar = $('ae-pct-bar');
        if (!bar) return;
        if (!currentPrizes.length) { bar.innerHTML = ''; return; }
        var t = Math.round(totalWeight * 100) / 100;
        if (Math.abs(t - 100) < 0.01) {
          bar.innerHTML = '<p class="muted" style="font-size:12px;margin:4px 0 0;">' +
            '全部加起來 100%，你填的數字就是實際機率。</p>';
          return;
        }
        bar.innerHTML = '<p style="font-size:12px;margin:6px 0 0;line-height:1.7;">' +
          '目前全部加起來是 <strong>' + t + '</strong>，不是 100。遊戲照比例分配，所以還是抽得動，' +
          '但你填的數字不等於實際機率（要看右邊那欄）。' +
          '<button type="button" class="ae-link-btn" id="ae-normalize">按比例調成 100</button></p>';
        var btn = $('ae-normalize');
        if (btn) btn.addEventListener('click', function () { normalizeToHundred(totalWeight); });
      }

      // 按比例縮放到總和 100，實際機率完全不變，只是把數字換成看得懂的百分比
      function normalizeToHundred(totalWeight) {
        if (!(totalWeight > 0)) return;
        var preview = currentPrizes.map(function (p) {
          return { p: p, next: Math.round(Number(p.probability_weight || 0) / totalWeight * 10000) / 100 };
        });
        var NL = String.fromCharCode(10);
        var msg = '每個獎品的實際中獎機率完全不變，只是把數字換算成百分比：' + NL + NL +
          preview.map(function (x) { return '  ' + x.p.name + '：' + x.p.probability_weight + ' → ' + x.next; }).join(NL) +
          NL + NL + '要改嗎？';
        if (!confirm(msg)) return;
        var btn = $('ae-normalize');
        if (btn) { btn.disabled = true; btn.textContent = '處理中…'; }
        Promise.all(preview.map(function (x) {
          var v = x.p.prize_value || {};
          return fetch('/admin/activities/api/prizes/' + x.p.id, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: x.p.name, description: x.p.description, image_url: x.p.image_url,
              probability_weight: x.next, stock_total: x.p.stock_total,
              prize_type: x.p.prize_type, prize_value: v,
              position: x.p.position, is_grand_prize: x.p.is_grand_prize
            })
          }).then(function (r) { return r.json(); });
        })).then(function (results) {
          var bad = results.filter(function (r) { return !r || !r.ok; });
          if (bad.length) alert('有 ' + bad.length + ' 個獎品沒改成功，請重新整理後再試一次。');
          loadActivity();
        }).catch(function () {
          alert('連線錯誤，請重新整理後再試一次。');
          loadActivity();
        });
      }

      // modal 裡即時換算：你填的數字，在目前這組獎品裡實際會是多少
      function updateRefHint() {
        var el = document.getElementById('ae-ref-hint');
        if (!el) return;
        var need = Math.max(1, Number($('ae-ref-need').value || 1));
        var per = Number($('ae-ref-per').value || 0);
        var mx = Number($('ae-ref-max').value || 0);
        el.textContent = per <= 0 ? '邀請目前是關的'
          : '現在的規則：每邀 ' + need + ' 位朋友，多 ' + per + ' 次，最多加 ' + mx + ' 次';
      }
      ['ae-ref-need','ae-ref-per','ae-ref-max'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('input', updateRefHint);
      });

      function updateWeightHint() {
        var hint = $('pm-weight-hint');
        if (!hint) return;
        var mine = Number($('pm-weight').value || 0);
        var others = currentPrizes.reduce(function (sum, p) {
          return sum + (String(p.id) === String(editingPrizeId) ? 0 : Number(p.probability_weight || 0));
        }, 0);
        var total = others + mine;
        if (!(total > 0)) { hint.textContent = ''; return; }
        var pct = Math.round(mine / total * 10000) / 100;
        hint.textContent = Math.abs(total - 100) < 0.01
          ? '這個活動加起來剛好 100%'
          : '這個活動加起來會是 ' + (Math.round(total * 100) / 100) + '，所以這一項實際機率是 ' + pct + '%';
      }

      function renderPrizes() {
        var tbody = $('ae-prize-tbody');
        if (!tbody) return;
        if (!currentPrizes.length) {
          tbody.innerHTML = '<tr><td colspan="8" class="muted" style="text-align:center;padding:24px 0;">尚無獎品，點右上「＋ 新增獎品」加第一個</td></tr>';
          return;
        }
        var totalWeight = currentPrizes.reduce(function (sum, p) { return sum + Number(p.probability_weight || 0); }, 0);
        tbody.innerHTML = currentPrizes.map(function (p) {
          var pct = totalWeight > 0 ? (Number(p.probability_weight || 0) / totalWeight * 100).toFixed(2) + '%' : '—';
          var stock = (p.stock_total == null)
            ? '<span class="muted">∞</span>'
            : (p.stock_remaining + ' / ' + p.stock_total);
          var typeLabel = ({rice_dollar:'Rice Dollar',coupon_code:'優惠券',badge:'虛擬',physical:'實體',none:'謝謝惠顧'})[p.prize_type] || p.prize_type;
          return '<tr>' +
            '<td>' + p.position + '</td>' +
            '<td><div style="font-weight:600;">' + escapeHtml(p.name) + '</div>' +
              (p.description ? '<div class="muted" style="font-size:11px;">' + escapeHtml(p.description) + '</div>' : '') +
            '</td>' +
            '<td>' + typeLabel + '</td>' +
            '<td style="text-align:right;" class="muted">' + p.probability_weight + '</td>' +
            '<td style="text-align:right;font-weight:600;">' + pct + '</td>' +
            '<td style="text-align:right;">' + stock + '</td>' +
            '<td>' + (p.is_grand_prize ? '<span class="ae-grand-badge">大獎</span>' : '—') + '</td>' +
            '<td>' +
              '<button type="button" class="ae-link-btn ae-preview-prize" data-id="' + p.id + '">看中獎畫面</button>' +
              '<button type="button" class="ae-link-btn ae-edit-prize" data-id="' + p.id + '">編輯</button>' +
              '<button type="button" class="ae-link-btn ae-del-prize" data-id="' + p.id + '" data-name="' + escapeHtml(p.name) + '">刪</button>' +
            '</td>' +
          '</tr>';
        }).join('');
        renderPctBar(totalWeight);

        rebuildPreviewScenarios();
        $$('.ae-preview-prize', tbody).forEach(function (btn) {
          btn.addEventListener('click', function () {
            var select = $('ae-preview-scenario');
            if (!select) return;
            select.value = 'prize:' + btn.getAttribute('data-id');
            updatePreview();
            $('ae-preview-studio').scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        });

        $$('.ae-edit-prize', tbody).forEach(function (btn) {
          btn.addEventListener('click', function () { openPrizeModal(btn.getAttribute('data-id')); });
        });
        $$('.ae-del-prize', tbody).forEach(function (btn) {
          btn.addEventListener('click', function () {
            var id = btn.getAttribute('data-id');
            var name = btn.getAttribute('data-name');
            if (!confirm('刪除獎品「' + name + '」？')) return;
            fetch('/admin/activities/api/prizes/' + id, { method: 'DELETE' })
              .then(function (r) { return r.json(); })
              .then(function (d) {
                if (!d.ok) { alert('刪除失敗'); return; }
                loadActivity();
              });
          });
        });
      }

      function openPrizeModal(prizeId) {
        editingPrizeId = prizeId || null;
        var wIn = $('pm-weight');
        if (wIn && !wIn.__hintBound) { wIn.__hintBound = true; wIn.addEventListener('input', updateWeightHint); }
        $('prize-modal-title').textContent = editingPrizeId ? '編輯獎品' : '新增獎品';
        if (editingPrizeId) {
          var p = currentPrizes.find(function (x) { return String(x.id) === String(editingPrizeId); });
          if (!p) return;
          $('pm-name').value = p.name || '';
          $('pm-type').value = p.prize_type || 'badge';
          $('pm-position').value = p.position || 0;
          $('pm-weight').value = p.probability_weight || 1;
          $('pm-stock').value = p.stock_total == null ? '' : p.stock_total;
          $('pm-image').value = p.image_url || '';
          $('pm-desc').value = p.description || '';
          $('pm-grand').checked = Boolean(p.is_grand_prize);
          var v = p.prize_value || {};
          $('pm-value').value = v.amount || v.code || v.label || v.note || '';
          $('pm-miles').value = (v.miles != null ? v.miles : '');
          showExtraValueNote(v);
        } else {
          $('pm-name').value = '';
          $('pm-type').value = 'badge';
          $('pm-position').value = currentPrizes.length;
          $('pm-weight').value = 1;
          $('pm-stock').value = '';
          $('pm-image').value = '';
          $('pm-desc').value = '';
          $('pm-grand').checked = false;
          $('pm-value').value = '';
          $('pm-miles').value = '';
          showExtraValueNote(null);
        }
        updatePrizeValueLabel();
        updateWeightHint();
        $('prize-modal').hidden = false;
      }
      // 這筆獎品有沒有「畫面上看不到但程式在用」的設定？有就講出來，讓人知道存檔不會弄丟
      function showExtraValueNote(v) {
        var note = $('pm-extra-note');
        if (!note) return;
        var shown = { amount: 1, code: 1, label: 1, note: 1, miles: 1 };
        var extras = v && typeof v === 'object'
          ? Object.keys(v).filter(function (k) { return !shown[k]; })
          : [];
        if (!extras.length) { note.hidden = true; note.textContent = ''; return; }
        note.hidden = false;
        note.textContent = '這個獎品另外存了進階設定（' + extras.join('、') + '），存檔時會原封不動保留。';
      }

      function closePrizeModal() {
        $('prize-modal').hidden = true;
        editingPrizeId = null;
      }
      function updatePrizeValueLabel() {
        var t = $('pm-type').value;
        var labelMap = {
          rice_dollar: 'Rice Dollar 金額',
          coupon_code: '優惠券代碼（例：SUMMER2026）',
          badge: '徽章 / 顯示文字',
          physical: '備註（給後台兌獎用）',
          none: '不需填寫'
        };
        $('pm-value-label').textContent = labelMap[t] || '獎勵內容';
        $('pm-value').disabled = (t === 'none');
        $('pm-value').placeholder = labelMap[t] === '不需填寫' ? '—' : (labelMap[t] || '');
      }

      var addBtn = $('ae-add-prize');
      if (addBtn) addBtn.addEventListener('click', function () { openPrizeModal(null); });
      $('prize-modal-close').addEventListener('click', closePrizeModal);
      $('pm-cancel').addEventListener('click', closePrizeModal);
      $('pm-type').addEventListener('change', updatePrizeValueLabel);

      $('pm-save').addEventListener('click', function () {
        var pt = $('pm-type').value;
        var valStr = $('pm-value').value.trim();
        // 先把這筆獎品原本存的內容整包接住（里數、券的注意事項、兌換連結…畫面上沒有欄位，
        // 但後台程式會用；不接住的話一按儲存就被清空，獎品會發不出去）
        var prizeValue = {};
        if (editingPrizeId) {
          var origPrize = currentPrizes.find(function (x) { return String(x.id) === String(editingPrizeId); });
          if (origPrize && origPrize.prize_value && typeof origPrize.prize_value === 'object') {
            try { prizeValue = JSON.parse(JSON.stringify(origPrize.prize_value)); } catch (e) { prizeValue = {}; }
          }
        }
        var milesStr = ($('pm-miles').value || '').trim();
        if (milesStr && Number(milesStr) > 0) prizeValue.miles = Number(milesStr);
        else delete prizeValue.miles;
        var valueKey = ({ rice_dollar: 'amount', coupon_code: 'code', badge: 'label', physical: 'note' })[pt];
        if (valueKey) {
          if (valStr) prizeValue[valueKey] = (pt === 'rice_dollar') ? Number(valStr) : valStr;
          else delete prizeValue[valueKey];
        }

        var data = {
          name: $('pm-name').value.trim(),
          description: $('pm-desc').value.trim(),
          image_url: $('pm-image').value.trim() || null,
          probability_weight: Number($('pm-weight').value || 0),
          stock_total: $('pm-stock').value ? Number($('pm-stock').value) : null,
          prize_type: pt,
          prize_value: prizeValue,
          position: Number($('pm-position').value || 0),
          is_grand_prize: $('pm-grand').checked
        };
        var url = editingPrizeId
          ? '/admin/activities/api/prizes/' + editingPrizeId
          : '/admin/activities/api/' + activityId + '/prizes';
        var method = editingPrizeId ? 'PUT' : 'POST';
        fetch(url, {
          method: method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (!d.ok) { alert('儲存失敗：' + (d.detail || d.error)); return; }
            closePrizeModal();
            loadActivity();
          });
      });

      // ---- cover image upload + preview + clear ----
      var coverInput = $('ae-cover');
      var coverFile = $('ae-cover-file');
      var coverUploadBtn = $('ae-cover-upload');
      var coverClearBtn = $('ae-cover-clear');
      var coverStatus = $('ae-cover-status');
      var coverPreview = $('ae-cover-preview');
      function updateCoverPreview() {
        var url = (coverInput.value || '').trim();
        if (!url) {
          coverPreview.innerHTML = '';
          coverClearBtn.hidden = true;  // 沒圖就藏刪除按鈕
          return;
        }
        coverPreview.innerHTML = '<img src="' + url.replace(/"/g, '&quot;') +
          '" alt="cover" style="max-width:200px;max-height:120px;border:1px solid #ECECEE;border-radius:6px;object-fit:cover;" />';
        coverClearBtn.hidden = false;
      }
      coverInput.addEventListener('input', updateCoverPreview);
      coverUploadBtn.addEventListener('click', function () { coverFile.click(); });
      // 刪除：清空 input + preview + status（save 時 cover_image_url 會被設成 null）
      coverClearBtn.addEventListener('click', function () {
        if (!confirm('確定移除封面圖？儲存後就回到沒有封面的樣子。')) return;
        coverInput.value = '';
        coverStatus.textContent = '已移除（記得按下方更新存檔）';
        updateCoverPreview();
      });
      coverFile.addEventListener('change', function () {
        var f = coverFile.files && coverFile.files[0];
        if (!f) return;
        if (f.size > 2 * 1024 * 1024) { coverStatus.textContent = '檔案 > 2MB'; return; }
        coverStatus.textContent = '上傳中⋯';
        coverUploadBtn.disabled = true;
        var fd = new FormData();
        fd.append('hero', f);
        // 沿用既有的 broadcast hero upload endpoint（內部存 line_push_media，回公開 URL）
        fetch('/admin/broadcast/hero/upload', { method: 'POST', body: fd })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (!data || !data.ok || !data.url) {
              coverStatus.textContent = '失敗：' + (data && (data.error || '上傳錯誤') || '未知');
            } else {
              coverInput.value = data.url;
              coverStatus.textContent = '已上傳';
              updateCoverPreview();
            }
          })
          .catch(function (e) { coverStatus.textContent = '錯誤：' + e.message; })
          .finally(function () {
            coverUploadBtn.disabled = false;
            coverFile.value = '';  // 讓同檔可再上傳
          });
      });

      // bootstrap
      loadActivity();
      updateLinkStatusBanner();
      // 載入時也 render 預覽
      setTimeout(updateCoverPreview, 100);
    })();
    </script>

