<%-
  include('layout', {
    user: user,
    isAdmin: isAdmin,
    bodyClass: bodyClass,
    body: `
    <section class="card">
      <div class="ae-head">
        <a href="/admin/activities" class="ae-back">← 回列表</a>
        <h1 id="ae-title">${activityId ? '編輯活動' : '新增活動'}</h1>
        ${activityId ? `<a href="/admin/activities/${activityId}/players" class="ae-secondary-btn" style="margin-left:auto;">玩家數據 ›</a>` : ''}
        <div id="ae-status" class="muted" style="font-size:12px;"></div>
      </div>

      <h2>1. 用戶畫面與活動規則</h2>
      <div class="ae-grid">
        <label class="ae-field">
          <span>活動名稱 *</span>
          <input type="text" id="ae-name" placeholder="例：夏日大轉盤" />
        </label>
        <label class="ae-field">
          <span>slug *（網址用，只接受英數字與 -）</span>
          <input type="text" id="ae-slug" placeholder="summer-wheel" />
        </label>
        <label class="ae-field">
          <span>遊戲類型</span>
          <select id="ae-game-type">
            ${gameTypes.map(t => `<option value="${t}">${({wheel:'輪盤抽獎',fortune:'每日抽籤',scratch:'刮刮樂',slot:'老虎機',claim:'領取優惠券'})[t] || t}</option>`).join('')}
          </select>
        </label>
        <label class="ae-field">
          <span>狀態</span>
          <select id="ae-status-select">
            ${statuses.map(s => `<option value="${s}">${({draft:'草稿',active:'進行中',paused:'暫停',ended:'已結束'})[s] || s}</option>`).join('')}
          </select>
        </label>
        <label class="ae-field">
          <span>開始時間（到點自動變「進行中」）</span>
          <input type="datetime-local" id="ae-start" />
        </label>
        <label class="ae-field">
          <span>結束時間（到點自動變「已結束」）</span>
          <input type="datetime-local" id="ae-end" />
        </label>
        <label class="ae-field">
          <span>每用戶每天可玩次數（空白 = 無限）</span>
          <input type="number" id="ae-daily-limit" min="0" placeholder="1" />
        </label>
        <label class="ae-field">
          <span>每用戶基礎可玩次數 *（0 = 只有收到群發派送次數的人才能玩）</span>
          <input type="number" id="ae-base-plays" min="0" value="1" />
        </label>
        <label class="ae-field">
          <span>要邀請幾位朋友才加一次（1 = 每邀 1 人就加）</span>
          <input type="number" id="ae-ref-need" min="1" value="1" />
        </label>
        <label class="ae-field">
          <span>湊滿之後加幾次（0 = 關閉邀請）</span>
          <input type="number" id="ae-ref-per" min="0" value="0" />
          <small class="muted" id="ae-ref-hint" style="font-size:11px;line-height:1.5;"></small>
        </label>
        <label class="ae-field">
          <span>邀請加次數上限（設 0 ＝ 完全不會加次，邀請等於白邀）</span>
          <input type="number" id="ae-ref-max" min="0" value="0" />
        </label>
        <label class="ae-field">
          <span>封面圖（可選 — 貼 URL 或直接上傳，建議 1600×900 / 16:9，最大 2MB）</span>
          <div style="display:flex;gap:6px;align-items:stretch;">
            <input type="text" id="ae-cover" placeholder="https://..." style="flex:1;" />
            <input type="file" id="ae-cover-file" accept="image/png,image/jpeg" style="display:none;" />
            <button type="button" id="ae-cover-upload" style="padding:8px 14px;background:#fff;border:1px solid #ECECEE;border-radius:6px;cursor:pointer;font-size:12px;font-family:inherit;">上傳</button>
            <button type="button" id="ae-cover-clear" hidden style="padding:8px 14px;background:#fff;border:1px solid #FCA5A5;color:#DC2626;border-radius:6px;cursor:pointer;font-size:12px;font-family:inherit;">刪除</button>
          </div>
          <div id="ae-cover-status" style="font-size:11px;color:#6B6B70;min-height:14px;"></div>
          <div id="ae-cover-preview" style="margin-top:6px;"></div>
        </label>
        <label class="ae-field ae-field-full">
          <span>活動說明</span>
          <textarea id="ae-desc" rows="3" placeholder="顯示給用戶看的活動介紹"></textarea>
        </label>
        <label class="ae-field ae-field-full">
          <input type="checkbox" id="ae-require-follow" /> 需先加入 LINE OA 好友才能玩
        </label>
        <label class="ae-field ae-field-full">
          <span>自訂活動入口（進階設定，留空就用系統預設，不確定就不要動）</span>
          <input type="text" id="ae-liff-override" placeholder="例：1234567890-abcDEF12（特殊拉新活動才需要）" />
          <span class="muted" style="font-size:11px;font-weight:400;">99% 活動留空就好。需要 Aggressive 加好友等特殊設定時才填獨立 LIFF ID。</span>
        </label>
      </div>

      <div class="ae-actions">
        <button type="button" class="ae-primary-btn" id="ae-save">${activityId ? '更新' : '儲存並繼續設定獎品'}</button>
        <span class="muted" style="margin-left:12px;font-size:12px;" id="ae-save-status"></span>
      </div>
    </section>

    ${activityId ? `
    <section class="card" id="ae-preview-studio">
      <div class="ae-head" style="margin-bottom:8px;">
        <div>
          <h2 style="margin:0;">2. 畫面設定與測試</h2>
          <p class="muted" style="font-size:12px;margin:5px 0 0;">選一個畫面就能直接查看，不必找好友，也不用真的抽獎。</p>
        </div>
        <span class="ae-safe-badge">安全測試模式</span>
      </div>

      <div class="ae-preview-grid">
        <div class="ae-preview-controls">
          <div class="ae-safe-note">
            <strong>可以放心測</strong>
            <span>不扣抽獎次數、不扣獎品庫存、不新增中獎紀錄，也不需要 LINE 好友。</span>
          </div>

          <label class="ae-field ae-scenario-field">
            <span>想看哪一個用戶畫面？</span>
            <select id="ae-preview-scenario">
              <option value="first_open">第一次開啟（首次 1 次）</option>
              <option value="ready">一般可抽（還有 3 次）</option>
              <option value="last">最後 1 次</option>
              <option value="invite">次數用完，可邀朋友</option>
              <option value="done">全部玩完</option>
              <option value="history">抽完後，獎項留在頁面</option>
              <option value="redemption">展開兌獎說明</option>
            </select>
          </label>
          <div class="ae-preview-actions">
            <button type="button" class="ae-primary-btn" id="ae-refresh-preview">更新右側預覽</button>
            <button type="button" class="ae-secondary-btn" id="ae-open-preview">另開測試畫面</button>
          </div>
          <p class="muted" style="font-size:11px;line-height:1.55;margin:0;">剛改完文字或獎品時，請先按上方「更新」存檔，再更新預覽。</p>

          <h3 class="ae-map-title">畫面位置叫什麼？在哪裡改？</h3>
          <div class="ae-ui-map">
            <button type="button" class="ae-map-row" data-ae-focus="ae-name">
              <span><b>頁首主標題</b><small>活動最上方的大字</small></span><em>到欄位修改</em>
            </button>
            <button type="button" class="ae-map-row" data-ae-focus="ae-desc">
              <span><b>標題下方介紹</b><small>主標題下面的小字說明</small></span><em>到欄位修改</em>
            </button>
            <button type="button" class="ae-map-row" data-ae-focus="ae-base-plays">
              <span><b>剩餘次數／邀請規則</b><small>「還可以轉幾次」與找朋友文案</small></span><em>到欄位修改</em>
            </button>
            <button type="button" class="ae-map-row" data-ae-scroll="ae-prizes-section" id="ae-map-prizes">
              <span><b>轉盤格與中獎畫面</b><small>獎名、圖片、說明、排序與大獎效果</small></span><em>到獎品修改</em>
            </button>
            <button type="button" class="ae-map-row" data-ae-scenario="redemption" id="ae-map-redemption">
              <span><b>兌獎說明</b><small>這檔活動目前使用固定版文字</small></span><em class="ae-fixed">預覽固定版</em>
            </button>
            <button type="button" class="ae-map-row" data-ae-scroll="ae-visual-settings" id="ae-map-visual">
              <span><b>Logo／輪盤／提示文案</b><small>可在下方依這檔活動調整</small></span><em>到畫面設定</em>
            </button>
          </div>

          <section class="ae-visual-box" id="ae-visual-settings">
            <div>
              <h3>活動視覺</h3>
              <p>只影響這檔活動；右側預覽可立即確認結果。</p>
            </div>
            <label class="ae-visual-toggle" id="ae-hero-art-toggle">
              <input type="checkbox" id="ae-show-hero-art" checked />
              <span><b>顯示標題右上角插圖</b><small>取消勾選即可移除目前的火鍋線稿</small></span>
            </label>
            <label class="ae-field">
              <span>頁首 Logo</span>
              <div class="ae-upload-row">
                <input type="text" id="ae-logo-url" placeholder="留空使用 OpenRice Logo，也可貼圖片網址" />
                <input type="file" id="ae-logo-file" accept="image/png,image/jpeg" hidden />
                <button type="button" class="ae-secondary-btn" id="ae-logo-upload">上傳</button>
                <button type="button" class="ae-secondary-btn" id="ae-logo-clear">恢復預設</button>
              </div>
              <span class="muted" id="ae-logo-status"></span>
              <span class="ae-logo-preview" id="ae-logo-preview"></span>
            </label>
            <label class="ae-field" id="ae-wheel-style-field">
              <span>快速套用風格</span>
              <div class="ae-preset-row">
                <select id="ae-wheel-style">
                  <option value="brand">OpenRice 黃白</option>
                  <option value="clean">白色簡約</option>
                  <option value="bold">品牌黃醒目</option>
                  <option value="custom">自訂設定</option>
                </select>
                <button type="button" class="ae-secondary-btn" id="ae-reset-wheel">重新套用</button>
              </div>
            </label>
            <div class="ae-wheel-editor" id="ae-wheel-editor">
              <div class="ae-editor-title">
                <b>自訂輪盤</b>
                <small>每一項都能自己調，改動會直接出現在右側測試畫面。</small>
              </div>
              <div class="ae-color-grid">
                <label class="ae-color-control"><span>扇形色 1</span><input type="color" id="ae-wheel-slice-1" value="#FFFFFF" /><output data-for="ae-wheel-slice-1">#FFFFFF</output></label>
                <label class="ae-color-control"><span>扇形色 2</span><input type="color" id="ae-wheel-slice-2" value="#FFF3C4" /><output data-for="ae-wheel-slice-2">#FFF3C4</output></label>
                <label class="ae-color-control"><span>大獎扇形</span><input type="color" id="ae-wheel-grand" value="#F9C73B" /><output data-for="ae-wheel-grand">#F9C73B</output></label>
                <label class="ae-color-control"><span>文字顏色</span><input type="color" id="ae-wheel-text" value="#4E342E" /><output data-for="ae-wheel-text">#4E342E</output></label>
                <label class="ae-color-control"><span>格線／外框</span><input type="color" id="ae-wheel-line" value="#4E342E" /><output data-for="ae-wheel-line">#4E342E</output></label>
                <label class="ae-color-control"><span>中獎格外框色</span><input type="color" id="ae-wheel-highlight" value="#F9C73B" /><output data-for="ae-wheel-highlight">#F9C73B</output></label>
                <label class="ae-color-control"><span>指針顏色</span><input type="color" id="ae-wheel-pointer" value="#E8491D" /><output data-for="ae-wheel-pointer">#E8491D</output></label>
                <label class="ae-color-control"><span>指針圓點</span><input type="color" id="ae-wheel-pointer-dot" value="#FBC02D" /><output data-for="ae-wheel-pointer-dot">#FBC02D</output></label>
                <label class="ae-color-control"><span>中心底色</span><input type="color" id="ae-wheel-hub" value="#FFFFFF" /><output data-for="ae-wheel-hub">#FFFFFF</output></label>
              </div>
              <div class="ae-highlight-preview-row">
                <button type="button" class="ae-secondary-btn" id="ae-preview-highlight">看中獎高亮效果</button>
                <small>只有抽中後才會出現；按這裡會用第一個獎項安全預覽。</small>
              </div>
              <div class="ae-prize-colors">
                <div class="ae-editor-title">
                  <b>每個獎項的扇形顏色</b>
                  <small>每一格都可以單獨選色，不再只靠兩個扇形色與一個大獎色輪替。</small>
                </div>
                <div class="ae-prize-color-actions">
                  <button type="button" class="ae-secondary-btn" id="ae-auto-prize-colors">套用區隔配色</button>
                  <button type="button" class="ae-secondary-btn" id="ae-reset-prize-colors">改回上方三色</button>
                </div>
                <div class="ae-prize-color-grid" id="ae-prize-color-grid">
                  <span class="muted">獎項載入後會顯示在這裡。</span>
                </div>
              </div>
              <div class="ae-range-grid">
                <label class="ae-range-control">
                  <span><b>輪盤尺寸</b><output id="ae-wheel-size-output">318 px</output></span>
                  <input type="range" id="ae-wheel-size" min="260" max="360" step="2" value="318" />
                </label>
                <label class="ae-range-control">
                  <span><b>外框／格線粗細</b><output id="ae-wheel-line-width-output">4 px</output></span>
                  <input type="range" id="ae-wheel-line-width" min="1" max="8" step="0.5" value="4" />
                </label>
              </div>
            </div>
            <div class="ae-scratch-editor" id="ae-scratch-editor" hidden>
              <div class="ae-editor-title">
                <b>刮刮樂卡片</b>
                <small>刮膜、卡片配色、比例與刮開門檻都能自己調；改動會直接出現在右側測試畫面。</small>
              </div>
              <label class="ae-field">
                <span>快速套用風格</span>
                <div class="ae-preset-row">
                  <select id="ae-scratch-style">
                    <option value="silver">銀色刮膜</option>
                    <option value="gold">金色刮膜</option>
                    <option value="brand">OpenRice 黃</option>
                    <option value="night">深色刮膜</option>
                    <option value="custom">自訂設定</option>
                  </select>
                  <button type="button" class="ae-secondary-btn" id="ae-reset-scratch">重新套用</button>
                </div>
              </label>
              <div class="ae-color-grid">
                <label class="ae-color-control"><span>刮膜色 1</span><input type="color" id="ae-scratch-foil-1" value="#D5D9E0" /><output data-for="ae-scratch-foil-1">#D5D9E0</output></label>
                <label class="ae-color-control"><span>刮膜色 2</span><input type="color" id="ae-scratch-foil-2" value="#9CA3AD" /><output data-for="ae-scratch-foil-2">#9CA3AD</output></label>
                <label class="ae-color-control"><span>刮膜色 3</span><input type="color" id="ae-scratch-foil-3" value="#7B8290" /><output data-for="ae-scratch-foil-3">#7B8290</output></label>
                <label class="ae-color-control"><span>刮膜提示字</span><input type="color" id="ae-scratch-foil-text" value="#FFFFFF" /><output data-for="ae-scratch-foil-text">#FFFFFF</output></label>
                <label class="ae-color-control"><span>卡片底色 1</span><input type="color" id="ae-scratch-card-bg-1" value="#FFFDF0" /><output data-for="ae-scratch-card-bg-1">#FFFDF0</output></label>
                <label class="ae-color-control"><span>卡片底色 2</span><input type="color" id="ae-scratch-card-bg-2" value="#FFF7DA" /><output data-for="ae-scratch-card-bg-2">#FFF7DA</output></label>
                <label class="ae-color-control"><span>卡片文字</span><input type="color" id="ae-scratch-card-text" value="#0F0F10" /><output data-for="ae-scratch-card-text">#0F0F10</output></label>
                <label class="ae-color-control"><span>標籤強調色</span><input type="color" id="ae-scratch-accent" value="#E11D27" /><output data-for="ae-scratch-accent">#E11D27</output></label>
                <label class="ae-color-control"><span>獎品圖示底</span><input type="color" id="ae-scratch-glyph-bg" value="#FCC726" /><output data-for="ae-scratch-glyph-bg">#FCC726</output></label>
                <label class="ae-color-control"><span>頭獎底色 1</span><input type="color" id="ae-scratch-grand-1" value="#E11D27" /><output data-for="ae-scratch-grand-1">#E11D27</output></label>
                <label class="ae-color-control"><span>頭獎底色 2</span><input type="color" id="ae-scratch-grand-2" value="#B61118" /><output data-for="ae-scratch-grand-2">#B61118</output></label>
                <label class="ae-color-control"><span>頭獎文字</span><input type="color" id="ae-scratch-grand-text" value="#FFFFFF" /><output data-for="ae-scratch-grand-text">#FFFFFF</output></label>
              </div>
              <div class="ae-range-grid">
                <label class="ae-field">
                  <span>卡片比例</span>
                  <select id="ae-scratch-ratio">
                    <option value="4:3">4:3（預設）</option>
                    <option value="16:9">16:9 橫幅</option>
                    <option value="1:1">1:1 正方</option>
                    <option value="3:4">3:4 直式</option>
                  </select>
                </label>
                <label class="ae-range-control">
                  <span><b>刮開幾成自動揭曉</b><output id="ae-scratch-threshold-output">35%</output></span>
                  <input type="range" id="ae-scratch-threshold" min="20" max="70" step="5" value="35" />
                </label>
              </div>
              <label class="ae-field" style="margin-top:12px;">
                <span>自訂刮膜圖（可選，會蓋在刮膜色上；建議與卡片比例相同，最大 2MB）</span>
                <div class="ae-upload-row">
                  <input type="text" id="ae-scratch-cover-url" placeholder="留空用刮膜色，也可貼圖片網址" />
                  <input type="file" id="ae-scratch-cover-file" accept="image/png,image/jpeg" hidden />
                  <button type="button" class="ae-secondary-btn" id="ae-scratch-cover-upload">上傳</button>
                  <button type="button" class="ae-secondary-btn" id="ae-scratch-cover-clear">清除</button>
                </div>
                <span class="muted" id="ae-scratch-cover-status"></span>
              </label>
              <div class="ae-scratch-toggles">
                <label class="ae-visual-toggle"><input type="checkbox" id="ae-scratch-show-hero-cover" checked /><span><b>顯示活動封面圖</b><small>頁首介紹下方的大圖</small></span></label>
                <label class="ae-visual-toggle"><input type="checkbox" id="ae-scratch-show-stats" checked /><span><b>顯示次數／邀請統計列</b><small>剩餘次數、已邀請、獎品種數</small></span></label>
                <label class="ae-visual-toggle"><input type="checkbox" id="ae-scratch-show-share" checked /><span><b>顯示分享／邀請卡</b><small>取消後用戶無法從這頁分享活動</small></span></label>
                <label class="ae-visual-toggle"><input type="checkbox" id="ae-scratch-show-prize-list" checked /><span><b>顯示「本次獎項」清單</b><small>刮獎區下方的獎項總覽</small></span></label>
              </div>
            </div>
            <div class="ae-copy-editor" id="ae-scratch-copy-editor" hidden>
              <div class="ae-editor-title">
                <b>刮刮樂文案與兌獎說明</b>
                <small>直接改用戶看得到的文字；雙大括號是自動帶入的名字或獎名，請保留需要的變數。</small>
              </div>
              <details class="ae-copy-group" open>
                <summary>主畫面</summary>
                <div class="ae-copy-grid">
                  <label class="ae-field"><span>右上角狀態小標</span><input type="text" id="ae-scopy-chip" /></label>
                  <label class="ae-field"><span>標題上方小標</span><input type="text" id="ae-scopy-hero-tag" /></label>
                  <label class="ae-field"><span>刮獎區標籤</span><input type="text" id="ae-scopy-stage-label" /></label>
                  <label class="ae-field"><span>刮膜上的提示字</span><input type="text" id="ae-scopy-cover-text" maxlength="20" /></label>
                  <label class="ae-field"><span>拿到卡片時的提示</span><input type="text" id="ae-scopy-ready-hint" /></label>
                  <label class="ae-field"><span>揭曉按鈕</span><input type="text" id="ae-scopy-reveal-button" /></label>
                  <label class="ae-field"><span>再來一張按鈕</span><input type="text" id="ae-scopy-new-card-button" /></label>
                  <label class="ae-field"><span>獎項清單標題</span><input type="text" id="ae-scopy-prize-list-title" /></label>
                </div>
              </details>
              <details class="ae-copy-group" open>
                <summary>中獎與兌獎</summary>
                <div class="ae-copy-grid">
                  <label class="ae-field"><span>中獎提示 <code>{{prize}}</code></span><input type="text" id="ae-scopy-winner-status" /></label>
                  <label class="ae-field"><span>未中獎提示</span><input type="text" id="ae-scopy-no-prize-status" /></label>
