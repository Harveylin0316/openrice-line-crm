      .ae-copy-editor { margin-top: 16px; padding-top: 14px; border-top: 1px solid #eadfca; }
      .ae-copy-group { margin-top: 8px; border: 1px solid #eadfca; border-radius: 9px; background: #fff; overflow: hidden; }
      .ae-copy-group summary {
        padding: 10px 12px;
        color: #51443e;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        background: #fffaf0;
      }
      .ae-copy-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 12px; padding: 12px; }
      .ae-copy-grid .ae-field { margin: 0; }
      .ae-copy-wide { grid-column: 1 / -1; }
      .ae-copy-grid code {
        margin-left: 4px;
        padding: 1px 4px;
        border-radius: 4px;
        background: #f4efe5;
        color: #a34a17;
        font-size: 9px;
        white-space: normal;
      }
      .ae-visual-actions { display: flex; align-items: center; gap: 9px; margin-top: 13px; }
      .ae-visual-actions .muted, #ae-logo-status { font-size: 11px; line-height: 1.4; }
      .ae-phone-area { position: sticky; top: 12px; }
      .ae-phone-label {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 7px;
        margin: 0 0 7px;
        color: #5f514b;
        font-size: 11px;
        font-weight: 700;
      }
      .ae-live-dot { width: 7px; height: 7px; border-radius: 50%; background: #10b981; box-shadow: 0 0 0 3px #d1fae5; }
      .ae-phone-frame {
        width: 390px;
        height: 690px;
        padding: 10px 6px;
        overflow: hidden;
        border: 3px solid #3f2c25;
        border-radius: 30px;
        background: #3f2c25;
        box-shadow: 0 12px 28px rgba(63,44,37,.16);
      }
      .ae-phone-frame iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
        border-radius: 21px;
        background: #fff;
      }
      @keyframes aeFieldFlash {
        0%,100% { box-shadow: none; border-color: #e5e7eb; }
        35% { box-shadow: 0 0 0 4px rgba(252,199,38,.28); border-color: #e2a800; }
      }
      .ae-field-flash { animation: aeFieldFlash 1.4s ease; }

      .ae-prize-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
      }
      .ae-prize-table th, .ae-prize-table td {
        padding: 8px 12px;
        border-bottom: 1px solid #f3f4f6;
        vertical-align: middle;
      }
      .ae-prize-table th {
        background: #fafafa;
        text-align: left;
        font-size: 12px;
        color: #6b7280;
        font-weight: 600;
      }
      .ae-link-btn {
        padding: 3px 8px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 4px;
        font-size: 11px;
        cursor: pointer;
        color: #374151;
        margin-right: 4px;
      }
      .ae-link-btn:hover { background: #fffbeb; border-color: #FCC726; }
      .ae-del-prize { color: #dc2626; }
      .ae-grand-badge {
        background: #FCC726;
        color: #1f2937;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
      }

      .ae-link-title {
        font-weight: 600;
        font-size: 13px;
        color: #1f2937;
        margin-top: 4px;
      }
      .ae-link-box {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        background: #f9fafb;
        border-radius: 6px;
        font-family: ui-monospace, Menlo, monospace;
        font-size: 12px;
        flex-wrap: wrap;
      }
      .ae-link-box code { color: #1f2937; flex: 1; word-break: break-all; min-width: 0; }

      .ae-modal {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 100;
        padding: 16px;
      }
      .ae-modal[hidden] { display: none !important; }
      /* 畫面設定區依遊戲類型隱藏的欄位，flex/grid 不可蓋掉 hidden */
      #ae-preview-studio [hidden], #ae-preview-studio option[hidden] { display: none !important; }
      .ae-modal-inner {
        background: #fff;
        border-radius: 12px;
        max-width: 640px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        padding: 20px;
      }
      .ae-modal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
      .ae-modal-head h3 { margin: 0; }
      .ae-modal-close {
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
        color: #6b7280;
        line-height: 1;
      }

      .table-wrap { overflow-x: auto; }
      @media (max-width: 980px) {
        .ae-preview-grid { grid-template-columns: 1fr; }
        .ae-phone-area { position: static; }
        .ae-phone-frame { width: min(390px, 100%); margin: 0 auto; }
      }
      @media (max-width: 480px) {
        .ae-phone-frame { height: 650px; border-radius: 24px; }
        .ae-safe-badge { margin-left: 0; }
        .ae-color-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .ae-prize-color-grid { grid-template-columns: 1fr; }
        .ae-highlight-preview-row { align-items: flex-start; flex-direction: column; }
        .ae-range-grid { grid-template-columns: 1fr; }
        .ae-copy-grid { grid-template-columns: 1fr; }
        .ae-copy-wide { grid-column: auto; }
      }
    </style>
    `
  })
%>
