      // ---- 分享給朋友的 LINE 卡片：即時預覽＋圖片上傳（輪盤 ae-copy-*、刮刮樂 ae-scopy-* 共用）----
      function renderSharePreview(prefix) {
        var box = document.querySelector('[data-share-preview="' + prefix + '"]');
        if (!box) return;
        var nameEl = $('ae-name'), descEl = $('ae-desc'), coverEl = $('ae-cover');
        var title = ($(prefix + '-share-card-title').value || '').trim() || (nameEl && nameEl.value.trim()) || '活動名稱';
        var desc = ($(prefix + '-share-card-desc').value || '').trim() || (descEl && descEl.value.trim()) || '打開活動，一起試試好運！';
        var cta = ($(prefix + '-share-cta').value || '').trim() || '馬上玩';
        var img = ($(prefix + '-share-card-image').value || '').trim();
        var isHttps = function (u) { return String(u || '').toLowerCase().indexOf('https://') === 0; };
        if (!isHttps(img)) img = coverEl ? coverEl.value.trim() : '';
        box.querySelector('[data-share-preview-title]').textContent = title.slice(0, 80);
        box.querySelector('[data-share-preview-desc]').textContent = desc.slice(0, 300);
        box.querySelector('[data-share-preview-cta]').textContent = cta.slice(0, 20);
        var hero = box.querySelector('[data-share-preview-hero]');
        hero.hidden = !isHttps(img);
        // 樣板字串頁面不能用反斜線：用 split/join 拿掉會破壞 CSS url() 的字元
        hero.style.backgroundImage = hero.hidden ? '' : 'url("' + img.split('"').join('').split(String.fromCharCode(92)).join('') + '")';
      }
      function renderAllSharePreviews() { renderSharePreview('ae-copy'); renderSharePreview('ae-scopy'); }
      ['ae-copy', 'ae-scopy'].forEach(function (prefix) {
        ['-share-card-title', '-share-card-desc', '-share-card-image', '-share-cta'].forEach(function (suffix) {
          var el = $(prefix + suffix);
          if (el) el.addEventListener('input', function () { renderSharePreview(prefix); });
        });
        var fileInput = $(prefix + '-share-card-image-file');
        var btn = document.querySelector('[data-share-image-upload="' + prefix + '"]');
        if (!fileInput || !btn) return;
        btn.addEventListener('click', function () { fileInput.click(); });
        fileInput.addEventListener('change', function () {
          var file = fileInput.files && fileInput.files[0];
          if (!file) return;
          if (file.size > 2 * 1024 * 1024) { alert('圖片超過 2MB，請壓縮後再上傳。'); fileInput.value = ''; return; }
          btn.disabled = true; btn.textContent = '上傳中…';
          var form = new FormData();
          form.append('hero', file);
          fetch('/admin/broadcast/hero/upload', { method: 'POST', body: form })
            .then(function (r) { return r.json(); })
