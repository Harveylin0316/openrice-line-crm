              $(prefix + '-share-card-image').value = resp.url;
              renderSharePreview(prefix);
              scheduleVisualPreview();
            })
            .catch(function (e) { alert('上傳失敗：' + e.message); })
            .finally(function () { btn.disabled = false; btn.textContent = '上傳'; fileInput.value = ''; });
        });
      });
