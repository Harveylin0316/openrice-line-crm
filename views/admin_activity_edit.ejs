        Object.keys(SCRATCH_COLOR_FIELDS).forEach(function (key) {
          custom[key] = safeHex($(SCRATCH_COLOR_FIELDS[key]).value, SCRATCH_PRESETS.silver[key]);
        });
        return {
          style: SCRATCH_PRESETS[style] ? style : 'custom',
          custom: custom,
          ratio: $('ae-scratch-ratio').value || '4:3',
          reveal_threshold: clamp($('ae-scratch-threshold').value, 20, 70, 35),
          cover_image_url: ($('ae-scratch-cover-url').value || '').trim() || null,
