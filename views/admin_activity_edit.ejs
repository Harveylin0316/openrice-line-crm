        $('ae-scratch-show-share').checked = s.show_share !== false;
        $('ae-scratch-show-prize-list').checked = s.show_prize_list !== false;
        var saved = copy && typeof copy === 'object' ? copy : {};
        Object.keys(SCRATCH_COPY_FIELDS).forEach(function (key) {
          var el = $(SCRATCH_COPY_FIELDS[key]);
