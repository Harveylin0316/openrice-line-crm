          show_prize_list: $('ae-scratch-show-prize-list').checked
        };
      }
      function collectScratchCopyControls() {
        var result = {};
        Object.keys(SCRATCH_COPY_FIELDS).forEach(function (key) {
          var el = $(SCRATCH_COPY_FIELDS[key]);
          var max = key === 'redemption_text' ? 2000 : 300;
          result[key] = el ? String(el.value || '').slice(0, max) : SCRATCH_COPY_DEFAULTS[key];
        });
        return result;
      }
      function setScratchColorControls(colors) {
        Object.keys(SCRATCH_COLOR_FIELDS).forEach(function (key) {
          var input = $(SCRATCH_COLOR_FIELDS[key]);
          if (!input) return;
          input.value = safeHex(colors[key], SCRATCH_PRESETS.silver[key]);
          var output = document.querySelector('output[data-for="' + SCRATCH_COLOR_FIELDS[key] + '"]');
          if (output) output.textContent = input.value.toUpperCase();
        });
      }
      function setScratchControls(scratch, copy) {
        if (!$('ae-scratch-style')) return;
        var s = scratch && typeof scratch === 'object' ? scratch : {};
        var style = SCRATCH_PRESETS[s.style] ? s.style : (s.style === 'custom' ? 'custom' : 'silver');
        $('ae-scratch-style').value = style;
        setScratchColorControls(Object.assign({}, SCRATCH_PRESETS[style === 'custom' ? 'silver' : style], s.custom || {}));
        $('ae-scratch-ratio').value = ['4:3', '16:9', '1:1', '3:4'].indexOf(s.ratio) >= 0 ? s.ratio : '4:3';
        $('ae-scratch-threshold').value = clamp(s.reveal_threshold, 20, 70, 35);
        $('ae-scratch-threshold-output').textContent = $('ae-scratch-threshold').value + '%';
        $('ae-scratch-cover-url').value = s.cover_image_url || '';
