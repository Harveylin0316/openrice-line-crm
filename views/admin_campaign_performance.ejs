<%- include('layout', { user:user, isAdmin:isAdmin, bodyClass:bodyClass, body:`
<section class="card cp-head"><div><h1>群發訊息成效</h1><p class="muted">從目標名單一路看到點擊、LIFF、註冊與訂位。只呈現系統真的有收到的事件。</p></div>
<form id="cp-range"><label>從 <input type="date" id="cp-from"></label><label>到 <input type="date" id="cp-to"></label><button>套用</button></form></section>
<section class="card"><div id="cp-summary" class="cp-summary"></div><div class="table-wrap"><table class="cp-table"><thead><tr><th>Campaign</th><th>Audience</th><th>Target</th><th>Sent</th><th>Delivered</th><th>Open</th><th>Click</th><th>LIFF</th><th>活動手機登記</th><th>Booking</th><th>Confirmed</th><th>Cancel</th><th>Attendance</th><th>Block</th></tr></thead><tbody id="cp-body"><tr><td colspan="14">載入中…</td></tr></tbody></table></div></section>
<section class="card"><h2>A/B/C Creative 比較</h2><div id="cp-variants" class="cp-variants"></div></section>
<section class="card"><h2>數字口徑</h2><div id="cp-notes" class="cp-notes"></div></section>
<style>.cp-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap}.cp-head h1{margin:0 0 5px}.cp-head form{display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:13px}.cp-head input,.cp-head button{padding:8px;border:1px solid #d1d5db;border-radius:8px;background:#fff}.cp-head button{background:#FCC726;border-color:#FCC726;font-weight:700;cursor:pointer}.cp-table{width:100%;border-collapse:collapse;font-size:12px}.cp-table th,.cp-table td{padding:10px 8px;border-bottom:1px solid #eee;text-align:right;white-space:nowrap}.cp-table th:first-child,.cp-table td:first-child{text-align:left}.cp-name{font-weight:700;font-size:13px}.cp-sub{color:#86868b;margin-top:3px}.cp-na{color:#9ca3af}.cp-summary{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}.cp-pill{padding:7px 11px;border-radius:999px;background:#fffbeb;border:1px solid #fde68a;font-size:12px}.cp-variants{display:grid;gap:8px}.cp-var{display:grid;grid-template-columns:100px 1fr repeat(4,100px);gap:8px;padding:10px;border-bottom:1px solid #eee;font-size:13px}.cp-notes{font-size:13px;line-height:1.8;color:#4b5563}@media(max-width:800px){.cp-var{grid-template-columns:1fr 1fr}.cp-table{min-width:1000px}}</style>
<script>(function(){var $=function(i){return document.getElementById(i)},DATA=null;function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}function n(v){return v==null?'<span class="cp-na">無資料</span>':Number(v).toLocaleString()}function rate(v){return v==null?'—':(Number(v)*100).toFixed(1)+'%'}function ymd(d){var p=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Taipei',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(d),o={};p.forEach(function(x){o[x.type]=x.value});return o.year+'-'+o.month+'-'+o.day}function dateDefaults(){var t=new Date(),to=ymd(t),mid=new Date(to+'T00:00:00+08:00'),f=new Date(mid.getTime()-29*86400000);$('cp-to').value=to;$('cp-from').value=ymd(f)}function load(){var q='?from='+encodeURIComponent($('cp-from').value)+'&to='+encodeURIComponent($('cp-to').value);fetch('/admin/campaign-performance/api'+q).then(function(r){return r.json()}).then(function(d){if(!d.ok)throw new Error(d.detail||d.error);DATA=d;render()}).catch(function(e){$('cp-body').innerHTML='<tr><td colspan="14">載入失敗：'+esc(e.message)+'</td></tr>'})}function render(){var rows=DATA.campaigns||[];$('cp-summary').innerHTML='<span class="cp-pill">共 '+rows.length+' 個 Campaign</span><span class="cp-pill">歸因窗：'+esc(DATA.definitions.window)+'</span>';$('cp-body').innerHTML=rows.length?rows.map(function(r){return '<tr><td><div class="cp-name">'+esc(r.name)+'</div><div class="cp-sub">#'+r.id+' · '+esc(r.channel||'line')+' · '+new Date(r.created_at).toLocaleDateString('zh-TW')+'</div></td><td>'+esc(r.audience_name||'條件篩選')+'</td><td>'+n(r.recipient_total)+'</td><td>'+n(r.sent)+'</td><td>'+n(r.delivered)+'<div class="cp-sub">'+rate(r.delivery_rate)+'</div></td><td>'+n(r.opened)+'<div class="cp-sub">'+rate(r.open_rate)+'</div></td><td>'+n(r.clicked)+'<div class="cp-sub">CTR '+rate(r.ctr)+'</div></td><td>'+n(r.liff)+'</td><td>'+n(r.registrations)+'</td><td>'+n(r.bookings)+'<div class="cp-sub">'+rate(r.conversion_rate)+'</div></td><td>'+n(r.booking_confirmed)+'</td><td>'+n(r.booking_cancelled)+'</td><td>'+n(r.attendance)+'</td><td>'+n(r.blocks)+'<div class="cp-sub">'+rate(r.block_rate)+'</div></td></tr>'}).join(''):'<tr><td colspan="14">此期間沒有 Campaign</td></tr>';var names={};rows.forEach(function(r){names[r.id]=r.name});$('cp-variants').innerHTML=(DATA.variants||[]).map(function(v){return '<div class="cp-var"><b>#'+v.broadcast_id+' / '+esc((v.variant||'a').toUpperCase())+'</b><span>'+esc(names[v.broadcast_id]||'')+'</span><span>Target '+n(v.target)+'</span><span>Sent '+n(v.sent)+'</span><span>Open '+rate(Number(v.sent)?Number(v.opened)/Number(v.sent):null)+'</span><span>CTR '+rate(Number(v.sent)?Number(v.clicked)/Number(v.sent):null)+'</span></div>'}).join('')||'<p class="muted">沒有測試資料</p>';$('cp-notes').innerHTML=Object.keys(DATA.definitions).map(function(k){return '<div><b>'+esc(k)+'</b>：'+esc(DATA.definitions[k])+'</div>'}).join('')}dateDefaults();$('cp-range').addEventListener('submit',function(e){e.preventDefault();load()});load()})();</script>` }) %>
