<%-
  include('layout', {
    user: user,
    isAdmin: isAdmin,
    bodyClass: bodyClass,
    body: `
    <section class="card rl-hero">
      <div class="rl-hero-inner">
        <div>
          <h1>名單庫</h1>
          <p class="muted" style="margin-top:6px;">
            集中管理推播 / 活動用的用戶名單。建立後在「群發訊息」可選用，未來活動 hub 也會接這裡。
          </p>
        </div>
        <button type="button" class="rl-primary-btn" id="btn-new-list">＋ 新增名單</button>
      </div>
    </section>

    <section class="card">
      <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:10px;">
        <h2 style="margin:0;">名單清單</h2>
        <input type="search" id="rl-search" placeholder="搜尋名稱或描述..." class="rl-search" />
      </div>
      <div class="table-wrap">
        <table class="rl-table">
          <thead>
            <tr>
              <th>名稱</th>
              <th style="text-align:right;">成員數 / LINE 可發</th>
              <th>建立者</th>
              <th>建立時間</th>
              <th>更新時間</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="rl-tbody">
            <tr><td colspan="6" class="muted" style="text-align:center;padding:18px 0;">載入中…</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 新增名單 modal -->
    <div id="new-list-modal" class="rl-modal" hidden>
      <div class="rl-modal-inner">
        <div class="rl-modal-head">
          <h3 style="margin:0;" id="nl-modal-title">新增名單</h3>
          <button type="button" class="rl-modal-close" id="new-list-close">×</button>
        </div>
        <div class="rl-grid">
          <label class="rl-field rl-field-full">
            <span>名稱 *</span>
            <input type="text" id="nl-name" placeholder="例：5月中過 $100 Rice Dollar 名單" maxlength="200" />
          </label>
          <label class="rl-field rl-field-full">
            <span>描述（可選）</span>
            <input type="text" id="nl-desc" placeholder="用途備註" maxlength="500" />
          </label>
          <div class="rl-field rl-field-full">
            <span>名單類型</span>
            <div class="aud-type-switch" id="nl-type-switch">
              <label><input type="radio" name="nl-type" value="static" checked /> 靜態名單（手動加入）</label>
              <label><input type="radio" name="nl-type" value="dynamic" /> 動態受眾（條件符合就自動加入／移除）</label>
            </div>
          </div>
          <label class="rl-field rl-field-full" id="static-inputs">
            <span>LINE 用戶編號（每位好友的專屬編號）（可選，建立後也能再加入成員，一行一個 / 逗號 / 空格 都行）</span>
            <textarea id="nl-uids" rows="8" placeholder="U3eca22d67d352c4db1428decf3ebcf14&#10;U4eca22d67d352c4db1428decf3ebcf15&#10;..." style="font-family:ui-monospace,Menlo,monospace;font-size:12px;"></textarea>
            <div id="nl-counter" class="muted" style="font-size:11px;">已輸入 0 位用戶</div>
            <div class="muted" style="font-size:12px;">不知道編號？到『用戶檔案』頁點任一用戶即可複製，或切到 Email 分頁直接貼信箱。<a href="/admin/users" target="_blank" rel="noopener" style="color:#374151;text-decoration:underline;">前往用戶檔案</a></div>
          </label>
          <div class="rl-field rl-field-full" id="dynamic-inputs" hidden>
            <div class="aud-builder-head">
              <label>條件間關係
                <select id="aud-operator"><option value="and">全部符合（AND）</option><option value="or">任一符合（OR）</option></select>
              </label>
              <label><input type="checkbox" id="aud-auto" checked /> 每 5 分鐘自動更新</label>
            </div>
            <div id="aud-conditions"></div>
            <button type="button" class="rl-secondary-btn" id="aud-add">＋ 新增條件</button>
            <button type="button" class="rl-secondary-btn" id="aud-preview">試算人數</button>
            <div id="aud-preview-result" class="aud-preview-result">請先新增條件</div>
            <p class="muted" style="font-size:12px;">排除已發送／測試／轉換可指定既有群發。轉換目前以可驗證的 CTA 點擊為準；一般訂位尚未能與 LINE ID 完整串接時，不會假算。</p>
          </div>
        </div>
        <div class="rl-modal-actions">
          <button type="button" class="rl-primary-btn" id="nl-save">建立名單</button>
          <button type="button" class="rl-secondary-btn" id="nl-cancel">取消</button>
        </div>
        <div id="nl-status" class="muted" style="font-size:12px;min-height:18px;margin-top:8px;"></div>
      </div>
    </div>

    <script>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var allLists = [];
      var catalog = { tags:[], activities:[], menus:[], broadcasts:[] };
      var breakdowns = {}; // { [listId]: { line_sendable, email_only, unknown } }
      var editingDynamicId = null;

      // 名單列表頁的「實際可發」拆解：以非同步補上，未到時顯示計算中
      function renderSendable(listId) {
        var bd = breakdowns[listId];
        if (!bd) {
          return '<div class="rl-sendable rl-sendable-loading">計算中…</div>';
        }
        var s = '<div class="rl-sendable">LINE 可發 <b>' + bd.line_sendable + '</b> 人';
        if (bd.email_only > 0) { s += '<span class="muted"> · 僅 Email ' + bd.email_only + '</span>'; }
        s += '</div>';
        return s;
      }
      function loadBreakdowns() {
        fetch('/admin/recipient-lists/api/breakdowns')
          .then(function (r) { return r.json(); })
          .then(function (resp) {
            if (!resp.ok) return;
            breakdowns = resp.breakdowns || {};
            // 重繪目前顯示的清單（沿用搜尋過濾結果）
            var q = $('rl-search').value.trim().toLowerCase();
            if (q) {
              render(allLists.filter(function (l) {
                return (l.name || '').toLowerCase().indexOf(q) >= 0 || (l.description || '').toLowerCase().indexOf(q) >= 0;
              }));
            } else {
              render(allLists);
            }
          })
          .catch(function () {});
      }

      function esc(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
      }
      function fmtTime(ts) {
        if (!ts) return '—';
        var d = new Date(ts);
        if (isNaN(d.getTime())) return '—';
        return d.toLocaleString('sv-SE', { timeZone: 'Asia/Taipei' }).slice(0, 16);
      }

      function parseUids(text) {
        if (!text) return [];
        return text.split(/[\\s,;]+/).map(function (s) { return s.trim(); }).filter(Boolean);
      }

      function load() {
        return fetch('/admin/broadcast/recipient-lists')
          .then(function (r) { return r.json(); })
          .then(function (resp) {
            if (!resp.ok) {
              $('rl-tbody').innerHTML = '<tr><td colspan="6" class="muted">載入失敗</td></tr>';
              return;
            }
            allLists = resp.lists || [];
            render(allLists);
            loadBreakdowns();
          })
          .catch(function () {
            $('rl-tbody').innerHTML = '<tr><td colspan="6" class="muted">載入失敗</td></tr>';
          });
      }

      function render(list) {
        var tbody = $('rl-tbody');
        if (!list.length) {
          tbody.innerHTML = '<tr><td colspan="6" class="muted" style="text-align:center;padding:24px 0;">尚無名單。點「＋ 新增名單」建立第一個。</td></tr>';
          return;
        }
        tbody.innerHTML = list.map(function (l) {
          return '<tr data-id="' + l.id + '">' +
            '<td>' +
              '<div class="rl-name">' + esc(l.name) + '</div>' +
              '<span class="aud-kind ' + (l.list_type === 'dynamic' ? 'dynamic' : '') + '">' + (l.list_type === 'dynamic' ? '動態' : '靜態') + '</span>' +
              (l.description ? '<div class="rl-desc">' + esc(l.description) + '</div>' : '') +
            '</td>' +
            '<td style="text-align:right;font-variant-numeric:tabular-nums;">' +
              '<div style="font-weight:600;">' + (l.total || 0) + ' <span class="muted" style="font-size:11px;">人</span></div>' +
              renderSendable(l.id) +
            '</td>' +
            '<td><span class="muted">' + esc(l.created_by || '') + '</span></td>' +
            '<td style="font-size:12px;color:#6B6B70;">' + fmtTime(l.created_at) + '</td>' +
            '<td style="font-size:12px;color:#6B6B70;">' + fmtTime(l.updated_at) + '</td>' +
            '<td>' +
              '<a href="/admin/recipient-lists/' + l.id + '" class="rl-link-btn">檢視 / 編輯</a>' +
              (l.list_type === 'dynamic' ? '<button type="button" class="rl-link-btn rl-edit-dynamic" data-id="' + l.id + '">修改條件</button>' : '') +
              '<button type="button" class="rl-del-btn" data-id="' + l.id + '" data-name="' + esc(l.name) + '" data-total="' + (l.total || 0) + '">刪除</button>' +
            '</td>' +
          '</tr>';
        }).join('');
        // delete handler
        tbody.querySelectorAll('.rl-del-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var id = btn.getAttribute('data-id');
            var name = btn.getAttribute('data-name');
            var total = btn.getAttribute('data-total');
            var msg = '確定刪除名單『' + name + '』' +
              (total != null && total !== '' ? '（' + total + ' 位成員）' : '') +
              '？\\n\\n若有排程群發或自動規則正在使用此名單，將會失效。';
            if (!confirm(msg)) return;
            fetch('/admin/broadcast/recipient-lists/' + id, { method: 'DELETE' })
              .then(function (r) { return r.json(); })
              .then(function (d) {
                if (!d.ok) { alert('刪除失敗：' + (d.detail || d.error)); return; }
                load();
              });
          });
        });
        tbody.querySelectorAll('.rl-edit-dynamic').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var id = Number(btn.getAttribute('data-id'));
            var item = allLists.find(function (list) { return Number(list.id) === id; });
            if (item) openDynamicEditor(item);
          });
        });
      }

      // search
      $('rl-search').addEventListener('input', function () {
        var q = $('rl-search').value.trim().toLowerCase();
        if (!q) { render(allLists); return; }
        var filtered = allLists.filter(function (l) {
          var name = (l.name || '').toLowerCase();
          var desc = (l.description || '').toLowerCase();
          return name.indexOf(q) >= 0 || desc.indexOf(q) >= 0;
        });
        render(filtered);
      });

      // ---- 新增 modal ----
      var modal = $('new-list-modal');
      function openModal() {
        editingDynamicId = null;
        $('nl-modal-title').textContent = '新增名單';
        $('nl-save').textContent = '建立名單';
        $('nl-type-switch').hidden = false;
        document.querySelectorAll('input[name="nl-type"]').forEach(function (el) { el.disabled = false; });
        $('nl-name').value = '';
        $('nl-desc').value = '';
        $('nl-uids').value = '';
        $('nl-counter').textContent = '已輸入 0 位用戶';
        $('nl-status').textContent = '';
        document.querySelector('input[name="nl-type"][value="static"]').checked = true;
        switchType();
        $('aud-conditions').innerHTML = '';
        addCondition();
        modal.hidden = false;
        setTimeout(function () { $('nl-name').focus(); }, 50);
      }
      function openDynamicEditor(list) {
        editingDynamicId = Number(list.id);
        $('nl-modal-title').textContent = '修改動態名單條件';
        $('nl-save').textContent = '儲存並立即同步';
        $('nl-type-switch').hidden = true;
        document.querySelector('input[name="nl-type"][value="dynamic"]').checked = true;
        document.querySelectorAll('input[name="nl-type"]').forEach(function (el) { el.disabled = true; });
        $('nl-name').value = list.name || '';
        $('nl-desc').value = list.description || '';
        $('nl-status').textContent = '';
        switchType();
        $('aud-operator').value = list.definition && list.definition.operator === 'or' ? 'or' : 'and';
        $('aud-auto').checked = list.auto_refresh !== false;
        $('aud-conditions').innerHTML = '';
        var conditions = list.definition && Array.isArray(list.definition.conditions) ? list.definition.conditions : [];
        conditions.forEach(function (condition) { addCondition(condition); });
        if (!conditions.length) addCondition();
        modal.hidden = false;
        previewDynamicAudience();
      }
      function closeModal() { modal.hidden = true; }
      $('btn-new-list').addEventListener('click', openModal);
      $('new-list-close').addEventListener('click', closeModal);
      $('nl-cancel').addEventListener('click', closeModal);

      $('nl-uids').addEventListener('input', function () {
        var uids = parseUids($('nl-uids').value);
        $('nl-counter').textContent = '已輸入 ' + uids.length + ' 位用戶';
      });

      function typeValue() {
        var checked = document.querySelector('input[name="nl-type"]:checked');
        return checked ? checked.value : 'static';
      }
      function switchType() {
        var dynamic = typeValue() === 'dynamic';
        $('static-inputs').hidden = dynamic;
        $('dynamic-inputs').hidden = !dynamic;
      }
      document.querySelectorAll('input[name="nl-type"]').forEach(function (el) { el.addEventListener('change', switchType); });

      var conditionLabels = {
        joined_after:'加入日期在此日之後', joined_before:'加入日期在此日之前', is_friend:'目前仍是好友',
        is_blocked:'目前已封鎖', tag:'會員標籤', rich_menu:'點過指定圖文選單', rich_menu_button:'點過指定圖文選單按鈕', liff_event:'LIFF 指定行為',
        activity:'玩過指定活動', activity_enter:'進入指定活動', activity_start:'開始指定活動', activity_complete:'完成指定活動', activity_share:'分享指定活動', successful_invite:'指定活動成功邀請', invite_count:'全部活動成功邀請合計至少幾人', reward_status:'獎勵狀態',
        follow_event:'曾加入好友', block_event:'曾封鎖', unblock_event:'封鎖後曾重新加入',
        line_login:'已有 LINE Login 身分', app_registration:'完成活動手機登記（非 OpenRice App 註冊）', booking_confirmed:'已確認金豬食堂訂位', booking_cancelled:'已取消／申請取消金豬食堂訂位',
        broadcast_sent:'指定群發已發送', broadcast_delivered:'指定群發已送達（Email）', broadcast_opened:'指定群發已開啟', broadcast_clicked:'指定群發已點擊', broadcast_tested:'指定群發已進測試組', broadcast_converted:'指定群發已轉換（CTA 點擊）'
      };
      function options(items) { return (items || []).map(function (x) { return '<option value="' + x.id + '">' + esc(x.name || ('#' + x.id)) + '</option>'; }).join(''); }
      function valueInput(type, value) {
        if (type === 'is_friend' || type === 'is_blocked' || type === 'line_login' || type === 'app_registration' || type === 'follow_event' || type === 'block_event' || type === 'unblock_event' || type === 'booking_confirmed' || type === 'booking_cancelled') return '<span class="muted aud-no-value">不需設定</span>';
        if (type === 'joined_after' || type === 'joined_before') return '<input class="aud-value" type="date" value="' + esc(value || '') + '" />';
        if (type === 'tag') return '<select class="aud-value">' + options(catalog.tags) + '</select>';
        if (type === 'activity' || type.indexOf('activity_') === 0 || type === 'successful_invite') return '<select class="aud-value">' + options(catalog.activities) + '</select>';
        if (type === 'rich_menu') return '<select class="aud-value">' + options(catalog.menus) + '</select>';
        if (type === 'rich_menu_button') return '<input class="aud-value" type="text" maxlength="40" placeholder="選單編號:分頁:格子，例如 3:0:2" value="' + esc(value || '') + '" />';
        if (type.indexOf('broadcast_') === 0) return '<select class="aud-value">' + options(catalog.broadcasts) + '</select>';
        if (type === 'reward_status') return '<select class="aud-value"><option value="obtained">獲得過</option><option value="unclaimed">有尚未兌換的獎項</option><option value="claimed">有已兌換的獎項</option></select>';
        if (type === 'invite_count') return '<input class="aud-value" type="number" min="1" max="10000" value="' + esc(value || '1') + '" />';
        return '<input class="aud-value" type="text" maxlength="80" placeholder="例：app_open 或 map_booking_click" value="' + esc(value || '') + '" />';
      }
      function addCondition(initial) {
        initial = initial || { mode:'include', type:'is_friend', value:null };
        var row = document.createElement('div'); row.className = 'aud-condition';
        var typeOpts = Object.keys(conditionLabels).map(function (k) { return '<option value="' + k + '"' + (k === initial.type ? ' selected' : '') + '>' + conditionLabels[k] + '</option>'; }).join('');
        row.innerHTML = '<select class="aud-mode"><option value="include">包含</option><option value="exclude">排除</option></select>' +
          '<select class="aud-type">' + typeOpts + '</select><span class="aud-value-wrap">' + valueInput(initial.type, initial.value) + '</span>' +
          '<button type="button" class="aud-remove" aria-label="移除條件">×</button>';
        row.querySelector('.aud-mode').value = initial.mode || 'include';
        row.querySelector('.aud-type').addEventListener('change', function () { row.querySelector('.aud-value-wrap').innerHTML = valueInput(this.value, null); scheduleAudiencePreview(); });
        row.querySelector('.aud-remove').addEventListener('click', function () { row.remove(); scheduleAudiencePreview(); });
        $('aud-conditions').appendChild(row);
        var valueEl = row.querySelector('.aud-value');
        if (valueEl && initial.value != null) valueEl.value = String(initial.value);
        scheduleAudiencePreview();
      }
      function audienceDefinition() {
        return { operator:$('aud-operator').value, conditions:Array.from(document.querySelectorAll('.aud-condition')).map(function (row) {
          var input = row.querySelector('.aud-value');
          return { mode:row.querySelector('.aud-mode').value, type:row.querySelector('.aud-type').value, value:input ? input.value : null };
        }) };
      }
      var previewTimer = null, previewSeq = 0;
      function previewDynamicAudience() {
        if (!document.querySelector('.aud-condition')) { $('aud-preview-result').textContent = '請先新增條件'; return; }
        var seq = ++previewSeq;
        $('aud-preview-result').textContent = '試算中…';
        fetch('/admin/recipient-lists/api/dynamic/preview', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({definition:audienceDefinition()}) })
          .then(function (r) { return r.json(); }).then(function (d) {
            if (seq !== previewSeq) return;
            $('aud-preview-result').innerHTML = d.ok ? ('符合 <strong>' + d.total + '</strong> 人') : ('試算失敗：' + esc(d.detail || d.error));
          }).catch(function (e) { if (seq === previewSeq) $('aud-preview-result').textContent = '試算失敗：' + e.message; });
      }
      function scheduleAudiencePreview() {
        clearTimeout(previewTimer);
        previewTimer = setTimeout(previewDynamicAudience, 350);
      }
      $('aud-add').addEventListener('click', function () { addCondition(); });
      $('aud-preview').addEventListener('click', previewDynamicAudience);
      $('aud-operator').addEventListener('change', scheduleAudiencePreview);
      $('aud-conditions').addEventListener('change', scheduleAudiencePreview);
      $('aud-conditions').addEventListener('input', scheduleAudiencePreview);

      $('nl-save').addEventListener('click', function () {
        var name = $('nl-name').value.trim();
        var desc = $('nl-desc').value.trim();
        var uids = parseUids($('nl-uids').value);
        if (!name) { $('nl-status').textContent = '請填寫名稱'; return; }
        $('nl-status').textContent = editingDynamicId ? '儲存並同步中⋯' : '建立中⋯';
        $('nl-save').disabled = true;
        var dynamic = typeValue() === 'dynamic';
        var endpoint = editingDynamicId
          ? '/admin/recipient-lists/api/' + editingDynamicId
          : (dynamic ? '/admin/recipient-lists/api/dynamic' : '/admin/broadcast/recipient-lists');
        fetch(endpoint, {
          method: editingDynamicId ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(dynamic
            ? { name:name, description:desc, definition:audienceDefinition(), auto_refresh:$('aud-auto').checked }
            : { name:name, description:desc, lineUserIds:uids })
        })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            $('nl-save').disabled = false;
            if (!d.ok) {
              $('nl-status').textContent = '失敗：' + (d.detail || d.error || '未知');
              return;
            }
            closeModal();
            load();
          })
          .catch(function (e) {
            $('nl-save').disabled = false;
            $('nl-status').textContent = '錯誤：' + e.message;
          });
      });

      fetch('/admin/recipient-lists/api/catalog').then(function (r) { return r.json(); }).then(function (d) { if (d.ok) catalog = d; }).catch(function () {}).then(function () {
        return load();
      }).then(function () {
        var editId = Number(new URLSearchParams(location.search).get('edit'));
        if (!editId) return;
        var item = allLists.find(function (list) { return Number(list.id) === editId && list.list_type === 'dynamic'; });
        if (item) openDynamicEditor(item);
      });
    })();
    </script>

    <style>
      .rl-hero { background: linear-gradient(135deg, #fffbeb 0%, #fff 100%); border: 1px solid #fde68a; }
      .rl-hero-inner { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
      .rl-primary-btn { padding: 10px 18px; background: #FCC726; color: #1f2937; font-weight: 600; border-radius: 8px; border: none; cursor: pointer; font-size: 14px; }
      .rl-primary-btn:hover { background: #f5b800; }
      .rl-primary-btn:disabled { opacity: 0.6; cursor: not-allowed; }
      .aud-type-switch,.aud-builder-head{display:flex;gap:18px;align-items:center;flex-wrap:wrap}.aud-type-switch label{font-weight:500}.aud-builder-head{justify-content:space-between;margin-bottom:10px}.aud-condition{display:grid;grid-template-columns:92px minmax(190px,1fr) minmax(170px,1fr) 36px;gap:8px;margin:8px 0}.aud-condition select,.aud-condition input,.aud-builder-head select{width:100%;padding:9px;border:1px solid #d1d5db;border-radius:8px;background:#fff}.aud-remove{border:0;background:#fff1f2;color:#be123c;border-radius:8px;font-size:20px;cursor:pointer}.aud-no-value{display:block;padding:10px}.aud-preview-result{display:inline-block;margin-left:10px;padding:8px 10px;border-radius:8px;background:#fffbeb}.aud-kind{display:inline-block;margin-top:5px;padding:2px 7px;border-radius:999px;font-size:11px;background:#f3f4f6;color:#4b5563}.aud-kind.dynamic{background:#ecfdf5;color:#047857}@media(max-width:700px){.aud-condition{grid-template-columns:1fr}.aud-remove{height:36px}}
      .rl-secondary-btn { padding: 9px 16px; background: #fff; color: #374151; border: 1px solid #e5e7eb; border-radius: 8px; cursor: pointer; font-size: 13px; }

      .rl-search { padding: 6px 12px; border: 1px solid #ECECEE; border-radius: 6px; font-size: 13px; width: 240px; max-width: 100%; }

      .table-wrap { overflow-x: auto; }
      .rl-table { width: 100%; border-collapse: collapse; font-size: 13px; }
      .rl-table th, .rl-table td { padding: 10px 12px; border-bottom: 1px solid #F3F4F6; vertical-align: middle; }
      .rl-table th { background: #FAFAFA; text-align: left; font-size: 11px; color: #6B6B70; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
      .rl-sendable { font-size: 11px; color: #16a34a; font-weight: 600; margin-top: 2px; }
      .rl-sendable b { font-variant-numeric: tabular-nums; }
      .rl-sendable .muted { font-weight: 400; }
      .rl-sendable-loading { color: #9CA3AF; font-weight: 400; }
      .rl-name { font-weight: 600; color: #1f2937; font-size: 14px; }
      .rl-desc { font-size: 11px; color: #6B6B70; margin-top: 2px; }
      .rl-link-btn { display: inline-block; padding: 4px 10px; background: #fff; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 12px; cursor: pointer; color: #374151; margin-right: 4px; text-decoration: none; }
      .rl-link-btn:hover { background: #fffbeb; border-color: #FCC726; }
      .rl-del-btn { padding: 4px 10px; background: #fff; border: 1px solid #fca5a5; border-radius: 6px; font-size: 12px; cursor: pointer; color: #dc2626; font-family: inherit; }
      .rl-del-btn:hover { background: #fee2e2; }

      .rl-modal { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 16px; }
      .rl-modal[hidden] { display: none !important; }
      .rl-modal-inner { background: #fff; border-radius: 12px; max-width: 580px; width: 100%; max-height: 90vh; overflow-y: auto; padding: 20px; }
      .rl-modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
      .rl-modal-close { background: none; border: none; font-size: 24px; cursor: pointer; color: #6b7280; line-height: 1; }
      .rl-grid { display: flex; flex-direction: column; gap: 12px; }
      .rl-field { display: flex; flex-direction: column; gap: 4px; font-size: 13px; }
      .rl-field span { color: #6B6B70; font-size: 12px; }
      .rl-field input, .rl-field textarea { padding: 8px 10px; border: 1px solid #ECECEE; border-radius: 6px; font-size: 13px; font-family: inherit; }
      .rl-field-full { width: 100%; }
      .rl-modal-actions { margin-top: 14px; display: flex; gap: 8px; }
    </style>
