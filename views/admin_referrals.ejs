<%-
  include('layout', {
    user: user,
    isAdmin: isAdmin,
    bodyClass: bodyClass,
    body: `
    <section class="card">
      <h1>邀請成效</h1>
      <p class="muted" style="margin-top:6px;line-height:1.7;">看誰成功邀到朋友，不用再請工程師撈資料。<br>
      「成功」＝被邀請的人現在是你的官方帳號好友（以實際好友狀態為準）。</p>
    </section>

    <section class="card">
      <h2 style="margin:0 0 4px;">春日活動（邀好友加刮次）</h2>
      <p class="muted" style="font-size:13px;margin-bottom:14px;">舊版的邀請機制。</p>
      <div id="rf-summary" class="rf-stats"><p class="muted">載入中…</p></div>
      <div id="rf-legacy" style="margin-top:16px;"></div>
    </section>

    <section class="card">
      <h2 style="margin:0 0 4px;">活動邀請（新版 MGM）</h2>
      <p class="muted" style="font-size:13px;margin-bottom:14px;">之後開新的邀請活動，成效都會自動出現在這裡。</p>
      <div id="rf-activity"><p class="muted">載入中…</p></div>
    </section>

    <section class="card">
      <h2 style="margin:0 0 4px;">誰被邀請（逐筆）</h2>
      <p class="muted" style="font-size:13px;margin-bottom:10px;">用戶問「我朋友到底有沒有算到」的時候查這張表。玩遊戲的逐筆紀錄在各活動的「玩家明細」頁。</p>
      <div id="rf-invitees"><p class="muted">載入中…</p></div>
    </section>

    <section class="card">
      <h2 style="margin:0 0 4px;">沒成功的邀請</h2>
      <p class="muted" style="font-size:13px;margin-bottom:10px;">被邀請的人有點開連結、但邀請還沒算成的紀錄（同一個人後來成功了就不會出現在這裡）。用戶抱怨沒拿到次數時，先看這裡就知道卡在哪。</p>
      <div id="rf-attempts"><p class="muted">載入中…</p></div>
    </section>

    <style>
      .rf-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;}
      .rf-stat{border:1px solid #ECECEE;border-radius:10px;padding:14px;background:#FAFAFA;}
      .rf-stat .v{font-size:24px;font-weight:700;color:#1f2937;font-variant-numeric:tabular-nums;}
      .rf-stat .k{font-size:12px;color:#6B6B70;margin-top:4px;}
      .rf-stat.warn{background:#FEF2F2;border-color:#FCA5A5;}
      .rf-stat.warn .v{color:#b91c1c;}
      .rf-callout{background:#FFFBEB;border:1px solid #FCC726;border-radius:10px;padding:12px 14px;font-size:13px;color:#92400e;line-height:1.7;margin-top:14px;}
      .rf-toggle{margin-top:14px;padding:8px 14px;background:#fff;border:1px solid #ECECEE;border-radius:8px;font-size:13px;font-weight:600;color:#374151;cursor:pointer;}
      .rf-toggle:hover{border-color:#1f2937;}
      .rf-table{width:100%;border-collapse:collapse;font-size:13px;margin-top:8px;}
      .rf-table th,.rf-table td{padding:9px 12px;border-bottom:1px solid #F3F4F6;text-align:left;}
      .rf-table th{background:#FAFAFA;font-size:11px;color:#6B6B70;font-weight:600;text-transform:uppercase;letter-spacing:.04em;}
      .rf-table td.num{text-align:right;font-variant-numeric:tabular-nums;}
      .rf-rank{color:#9ca3af;width:30px;}
      .rf-act-block{border:1px solid #ECECEE;border-radius:10px;padding:14px;margin-bottom:12px;}
      .rf-act-head{font-weight:700;color:#1f2937;font-size:14px;margin-bottom:6px;}
    </style>

    <script>
      (function(){
        var $=function(id){return document.getElementById(id);};
        function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
        function shortUid(u){return u?(u.slice(0,7)+'…'+u.slice(-4)):'—';}
        function twT(ts){try{return new Date(ts).toLocaleString('zh-TW',{timeZone:'Asia/Taipei',month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'});}catch(e){return String(ts||'');}}
        function stat(v,k,warn){return '<div class="rf-stat'+(warn?' warn':'')+'"><div class="v">'+(Number(v||0)).toLocaleString()+'</div><div class="k">'+k+'</div></div>';}

        function render(d){
          var s=d.summary||{};
          $('rf-summary').innerHTML=
            stat(s.total,'總邀請紀錄')+
            stat(s.success,'真實加入（被邀者已是好友）')+
            stat(s.rewarded,'系統已發獎勵')+
            stat(s.success_unrewarded,'加入了卻沒發到獎勵',true);
          var legacyHtml='';
          if(s.success_unrewarded>0){
            legacyHtml+='<div class="rf-callout"><strong>注意：</strong>有 '+s.success_unrewarded+' 個被邀請的人其實已經加了官方帳號，但舊機制沒把獎勵發給邀請人（獎勵卡在「等待中」沒發出去）。也就是這檔邀請活動其實成功帶進了 '+s.success+' 個好友，只是發獎流程漏掉了大部分。</div>';
          }
          if(d.legacy&&d.legacy.length){
            legacyHtml+='<button type="button" id="rf-legacy-toggle" class="rf-toggle">展開排行榜（'+d.legacy.length+' 位邀請人）</button>'+
              '<div id="rf-legacy-table" hidden><table class="rf-table"><thead><tr><th></th><th>邀請人</th><th style="text-align:right;">邀請數</th><th style="text-align:right;">真實成功</th><th style="text-align:right;">已發獎勵</th></tr></thead><tbody>'+
              d.legacy.map(function(r,i){
                return '<tr><td class="rf-rank">'+(i+1)+'</td>'+
                  '<td>'+esc(r.inviter_name)+'<br><span class="muted" style="font-size:11px;">'+esc(shortUid(r.inviter_line))+'</span></td>'+
                  '<td class="num">'+r.invites+'</td>'+
                  '<td class="num"><strong>'+r.success+'</strong></td>'+
                  '<td class="num">'+r.rewarded+'</td></tr>';
              }).join('')+'</tbody></table></div>';
          }else{legacyHtml+='<p class="muted" style="font-size:13px;">尚無邀請紀錄。</p>';}
          $('rf-legacy').innerHTML=legacyHtml;
          var lt=document.getElementById('rf-legacy-toggle');
          if(lt)lt.addEventListener('click',function(){
            var t=document.getElementById('rf-legacy-table');
            if(!t)return;
            t.hidden=!t.hidden;
            lt.textContent=(t.hidden?'展開':'收合')+'排行榜（'+d.legacy.length+' 位邀請人）';
          });

          // 活動邀請：先列有開 MGM 的活動，再放各自排行
          var box=$('rf-activity');var h='';
          if(d.mgmActivities&&d.mgmActivities.length){
            h+='<p class="muted" style="font-size:13px;margin-bottom:10px;">已開啟邀請的活動：'+d.mgmActivities.map(function(a){
              var per=Number(a.referral_invites_per_bonus||1);
              var rule=per>1?('每邀 '+per+' 位 +'+a.referral_bonus_per+' 次'):('+'+a.referral_bonus_per+' 次/人');
              return esc(a.name)+'（'+rule+'，上限 +'+a.referral_bonus_max+' 次）';
            }).join('、')+'</p>';
          }
          if(d.activity&&d.activity.length){
            // group by activity
            var byAct={};d.activity.forEach(function(r){(byAct[r.activity_id]=byAct[r.activity_id]||{name:r.activity_name,rows:[]}).rows.push(r);});
            Object.keys(byAct).forEach(function(aid){
              var g=byAct[aid];
              h+='<div class="rf-act-block"><div class="rf-act-head">'+esc(g.name)+'</div>'+
                '<table class="rf-table"><thead><tr><th></th><th>邀請人</th><th style="text-align:right;">成功邀請</th><th style="text-align:right;">其中新加入</th></tr></thead><tbody>'+
                g.rows.map(function(r,i){var nm=(r.new_members==null?'—':r.new_members);return '<tr><td class="rf-rank">'+(i+1)+'</td><td>'+esc(r.inviter_name)+'<br><span class="muted" style="font-size:11px;">'+esc(shortUid(r.inviter_line))+'</span></td><td class="num"><strong>'+r.referrals+'</strong></td><td class="num">'+nm+'</td></tr>';}).join('')+
                '</tbody></table></div>';
            });
          }else{
            h+='<p class="muted" style="font-size:13px;">還沒有活動邀請資料。到「活動管理」開一個活動、把「每邀請 1 人 +N 次」設大於 0，就會啟用邀請；之後成效會出現在這裡。</p>';
          }
          box.innerHTML=h;

          // 誰被邀請（逐筆）
          var iv=$('rf-invitees');
          if(d.inviteeDetail&&d.inviteeDetail.length){
            iv.innerHTML='<table class="rf-table"><thead><tr><th>時間</th><th>活動</th><th>邀請人</th><th>被邀請的人</th><th>身分</th></tr></thead><tbody>'+
              d.inviteeDetail.map(function(r){
                var tag=r.invitee_was_existing===true?'<span style="color:#6B6B70;">本來就是好友</span>'
                       :r.invitee_was_existing===false?'<strong style="color:#047857;">新加入的好友</strong>':'—';
                return '<tr><td>'+twT(r.created_at)+'</td><td>'+esc(r.activity_name)+'</td>'+
                  '<td>'+esc(r.inviter_name)+'<br><span class="muted" style="font-size:11px;">'+esc(shortUid(r.inviter_line))+'</span></td>'+
                  '<td>'+esc(r.invitee_name)+'<br><span class="muted" style="font-size:11px;">'+esc(shortUid(r.invitee_line))+'</span></td>'+
                  '<td>'+tag+'</td></tr>';
              }).join('')+'</tbody></table>';
          }else{iv.innerHTML='<p class="muted" style="font-size:13px;">還沒有邀請成功的紀錄。</p>';}

          // 沒成功的邀請（人話原因）
          var reasonMap={
            invitee_not_follower:'被邀請的人還沒加官方帳號好友',
            follow_check_unavailable:'查好友狀態時剛好連不上，系統會自動重試',
            activity_not_active:'活動還沒開始或已結束',
            activity_not_started:'活動還沒開始',
            activity_ended:'活動已結束',
            inviter_not_member:'邀請人不是官方帳號好友',
            self_referral:'自己邀請自己',
            bad_inviter:'邀請連結壞掉或被改過',
            mgm_disabled:'這個活動沒開邀請機制',
            token_required:'被邀請的人登入憑證遺失',
            token_invalid:'被邀請的人身分驗證失敗',
            identity_mismatch:'身分不符（可能換過帳號）',
            server_error:'系統錯誤，工程師要看',
            activity_not_found:'活動不存在'
          };
          var at=$('rf-attempts');
          if(d.failedAttempts&&d.failedAttempts.length){
            at.innerHTML='<table class="rf-table"><thead><tr><th>時間</th><th>活動</th><th>邀請人</th><th>被邀請的人</th><th>卡在哪</th></tr></thead><tbody>'+
              d.failedAttempts.map(function(r){
                return '<tr><td>'+twT(r.created_at)+'</td><td>'+esc(r.activity_slug)+'</td>'+
                  '<td>'+esc(r.inviter_name)+'<br><span class="muted" style="font-size:11px;">'+esc(shortUid(r.inviter_line))+'</span></td>'+
                  '<td>'+esc(r.invitee_name)+'<br><span class="muted" style="font-size:11px;">'+esc(shortUid(r.invitee_line))+'</span></td>'+
                  '<td>'+esc(reasonMap[r.outcome]||r.outcome)+'</td></tr>';
              }).join('')+'</tbody></table>';
          }else{at.innerHTML='<p class="muted" style="font-size:13px;">目前沒有卡住的邀請。</p>';}
        }

        fetch('/admin/referrals/api/data').then(function(r){return r.json();}).then(function(d){
          if(!d.ok){$('rf-summary').innerHTML='<p class="muted">載入失敗：'+esc(d.error||'')+'</p>';return;}
          render(d);
        }).catch(function(e){$('rf-summary').innerHTML='<p class="muted">載入失敗，請重新整理</p>';});
      })();
    </script>
    `
  })
%>
