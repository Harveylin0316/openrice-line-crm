<%-
  include('layout', {
    user: user,
    isAdmin: isAdmin,
    bodyClass: bodyClass,
    body: `
    <section class="card liff-hero">
      <div class="liff-hero-inner">
        <h1>今天吃什麼 — 用戶行為分析</h1>
        <p class="muted" style="margin-top:6px;">
          好康地圖活動頁的即時概覽、轉換漏斗與每日趨勢。看的是同一批人從點進活動頁，一路到按下訂位的整段過程。
        </p>
        <div class="liff-hero-meta">
          <span class="liff-meta-pill">即時更新</span>
          <span class="liff-meta-pill liff-meta-pill--muted" id="liff-last-updated">載入中…</span>
          <button type="button" class="liff-refresh-btn" id="btn-liff-refresh">重新整理</button>
        </div>
      </div>
    </section>

    <section class="card">
      <h2>今日即時概覽</h2>
      <div class="muted" style="font-size:12px;margin-bottom:12px;">以台灣時間 00:00 為起點計算。</div>
      <div class="liff-kpi-grid">
        <div class="liff-kpi-card">
          <div class="liff-kpi-title">開啟活動頁</div>
          <div class="liff-kpi-split">
            <div class="liff-kpi-half">
              <div class="liff-kpi-sublabel">次</div>
              <div class="liff-kpi-value" id="kpi-open-events">—</div>
            </div>
            <div class="liff-kpi-divider"></div>
            <div class="liff-kpi-half">
              <div class="liff-kpi-sublabel">人</div>
              <div class="liff-kpi-value" id="kpi-open-users">—</div>
            </div>
          </div>
          <div class="liff-kpi-hint">從 LINE 或連結點進活動頁就算一次</div>
        </div>

        <div class="liff-kpi-card">
          <div class="liff-kpi-title">打開地圖</div>
          <div class="liff-kpi-split">
            <div class="liff-kpi-half">
              <div class="liff-kpi-sublabel">次</div>
              <div class="liff-kpi-value" id="kpi-map-events">—</div>
            </div>
            <div class="liff-kpi-divider"></div>
            <div class="liff-kpi-half">
              <div class="liff-kpi-sublabel">人</div>
              <div class="liff-kpi-value" id="kpi-map-users">—</div>
            </div>
          </div>
          <div class="liff-kpi-hint">真的進到地圖畫面開始找店</div>
        </div>

        <div class="liff-kpi-card">
          <div class="liff-kpi-title">看餐廳</div>
          <div class="liff-kpi-split">
            <div class="liff-kpi-half">
              <div class="liff-kpi-sublabel">次</div>
              <div class="liff-kpi-value" id="kpi-view-events">—</div>
            </div>
            <div class="liff-kpi-divider"></div>
            <div class="liff-kpi-half">
              <div class="liff-kpi-sublabel">人</div>
              <div class="liff-kpi-value" id="kpi-view-users">—</div>
            </div>
          </div>
          <div class="liff-kpi-hint">點地圖上的餐廳、點清單裡的餐廳、看餐廳詳情都算</div>
        </div>

        <div class="liff-kpi-card">
          <div class="liff-kpi-title">點訂位</div>
          <div class="liff-kpi-split">
            <div class="liff-kpi-half">
              <div class="liff-kpi-sublabel">次</div>
              <div class="liff-kpi-value" id="kpi-booking-events">—</div>
            </div>
            <div class="liff-kpi-divider"></div>
            <div class="liff-kpi-half">
              <div class="liff-kpi-sublabel">人</div>
              <div class="liff-kpi-value" id="kpi-booking-users">—</div>
            </div>
          </div>
          <div class="liff-kpi-hint">按下訂位按鈕，最接近真的上門吃飯</div>
        </div>

        <div class="liff-kpi-card liff-kpi-card--highlight">
          <div class="liff-kpi-title">看餐廳 → 點訂位</div>
          <div class="liff-kpi-split">
            <div class="liff-kpi-half">
              <div class="liff-kpi-sublabel">次</div>
              <div class="liff-kpi-value" id="kpi-conv-event">—</div>
            </div>
            <div class="liff-kpi-divider"></div>
            <div class="liff-kpi-half">
              <div class="liff-kpi-sublabel">人</div>
              <div class="liff-kpi-value" id="kpi-conv-user">—</div>
            </div>
          </div>
          <div class="liff-kpi-hint">看了餐廳之後，有多少比例真的按下訂位</div>
        </div>
      </div>
      <p class="liff-note" id="kpi-note">載入中…</p>
      <p class="liff-note liff-note--dim">
        「人」只算得出有留下身分的人。不是從 LINE 裡面打開活動頁的人算不出是誰，所以「人」一定會比「次」保守很多，兩個一起看比較準。
      </p>
    </section>

    <section class="card">
      <div class="liff-section-head">
        <h2>玩的人裡面，有幾個是你的會員</h2>
        <div class="liff-range-toggle">
          <label><input type="radio" name="aud-days" value="7" checked /> 近 7 天</label>
          <label><input type="radio" name="aud-days" value="30" /> 近 30 天</label>
          <label><input type="radio" name="aud-days" value="3650" /> 全部</label>
        </div>
      </div>
      <p class="liff-aud-lead" id="aud-lead">載入中…</p>
      <div class="liff-aud-grid" id="aud-grid" hidden>
        <div class="liff-aud-item">
          <div class="liff-aud-k">你現在的 LINE 好友</div>
          <div class="liff-aud-v" id="aud-member-people">—</div>
          <div class="liff-aud-sub" id="aud-member-events">—</div>
          <div class="liff-aud-note">加了現在這個官方帳號、你發訊息找得到的人。</div>
        </div>
        <div class="liff-aud-item">
          <div class="liff-aud-k">舊官方帳號時期的人</div>
          <div class="liff-aud-v" id="aud-old-people">—</div>
          <div class="liff-aud-sub" id="aud-old-events">—</div>
          <div class="liff-aud-note">看得出是誰，但他加的是換掉的那個舊帳號，現在發訊息找不到他。</div>
        </div>
        <div class="liff-aud-item">
          <div class="liff-aud-k">還不認識的人</div>
          <div class="liff-aud-v" id="aud-unknown-people">—</div>
          <div class="liff-aud-sub" id="aud-unknown-events">—</div>
          <div class="liff-aud-note">有玩過，但對不到你名單裡的任何一個人。</div>
        </div>
      </div>
      <p class="liff-aud-foot" id="aud-foot" hidden></p>
      <div class="liff-aud-actions" id="aud-actions" hidden></div>
      <div class="table-wrap" id="aud-table-wrap" hidden>
        <table class="liff-users-table liff-aud-table">
          <thead>
            <tr>
              <th>會員</th>
              <th style="text-align:right;">開啟過活動頁</th>
              <th style="text-align:right;">看過餐廳</th>
              <th style="text-align:right;">點過訂位</th>
              <th>最後一次來</th>
            </tr>
          </thead>
          <tbody id="aud-tbody"></tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <div class="liff-section-head">
        <h2>核心轉換漏斗</h2>
        <div class="liff-range-toggle">
          <label><input type="radio" name="funnel-metric" value="sessions" checked /> 以來訪</label>
          <label><input type="radio" name="funnel-metric" value="users" /> 以人數</label>
          <label><input type="radio" name="funnel-metric" value="events" /> 以次數</label>
        </div>
        <div class="liff-range-toggle">
          <label><input type="radio" name="funnel-days" value="7" checked /> 7 天</label>
          <label><input type="radio" name="funnel-days" value="30" /> 30 天</label>
        </div>
      </div>
      <div class="muted" style="font-size:12px;margin-bottom:12px;">
        開啟活動頁 → 打開地圖 → 看餐廳 → 點訂位。最後一步「點訂位」才是真正想看的成果，其他都是過程。
        「來訪」＝來一趟算一次，中間點幾下不重複算；「人」＝認得出身分的人數；「次數」＝每個動作各算一次。
        沒從 LINE 裡面開的人算不出身分，所以看「來訪」最穩。
      </div>
      <p class="liff-empty" id="funnel-empty" hidden></p>
      <div class="liff-funnel-wrap" id="funnel-wrap">
        <canvas id="funnel-chart"></canvas>
      </div>
      <div class="table-wrap" id="funnel-table-wrap">
        <table class="liff-funnel-table">
          <thead>
            <tr>
              <th>步驟</th>
              <th style="text-align:right;">來訪</th>
              <th style="text-align:right;">人</th>
              <th style="text-align:right;">次數</th>
              <th style="text-align:right;" id="funnel-th-prev">比上一步</th>
              <th style="text-align:right;" id="funnel-th-first">比第一步</th>
            </tr>
          </thead>
          <tbody id="funnel-tbody">
            <tr><td colspan="6" class="muted" style="text-align:center;padding:18px 0;">載入中…</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <div class="liff-section-head">
        <h2>最多人看的餐廳</h2>
        <div class="liff-range-toggle">
          <label><input type="radio" name="rest-days" value="7" /> 7 天</label>
          <label><input type="radio" name="rest-days" value="30" checked /> 30 天</label>
          <label><input type="radio" name="rest-days" value="3650" /> 全部</label>
        </div>
      </div>
      <div class="muted" style="font-size:12px;margin-bottom:12px;">
        大家在地圖上點開哪幾間看。被看很多次但沒人按訂位，跟被看不多卻一直有人訂位，是兩種完全不同的合作對象，談約前值得先看這張表。
      </div>
      <div class="table-wrap">
        <table class="liff-users-table liff-rest-table">
          <thead>
            <tr>
              <th>餐廳</th>
              <th style="text-align:right;">被看次數</th>
              <th style="text-align:right;">幾個人看</th>
              <th style="text-align:right;">點訂位</th>
            </tr>
          </thead>
          <tbody id="rest-tbody">
            <tr><td colspan="4" class="muted" style="text-align:center;padding:18px 0;">載入中…</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <div class="liff-section-head">
        <h2>用過的人</h2>
        <div class="liff-range-toggle">
          <label><input type="radio" name="users-days" value="1" /> 今日</label>
          <label><input type="radio" name="users-days" value="7" checked /> 7 天</label>
          <label><input type="radio" name="users-days" value="30" /> 30 天</label>
        </div>
      </div>
      <div class="muted" style="font-size:12px;margin-bottom:12px;">
        有打開過活動頁、而且留得下身分的人。「已在名單」表示這個人在你的會員名單裡對得到名字；「不在名單」可能是新客人，也可能是同事自己測試。點下面那串代碼可以複製。
      </div>
      <div class="table-wrap">
        <table class="liff-users-table">
          <thead>
            <tr>
              <th>用戶</th>
              <th style="text-align:right;">來過幾次</th>
              <th style="text-align:right;">看餐廳</th>
              <th style="text-align:right;">點訂位</th>
              <th style="text-align:right;">看了會訂位的比例</th>
              <th>最後活動</th>
            </tr>
          </thead>
          <tbody id="users-tbody">
            <tr><td colspan="6" class="muted" style="text-align:center;padding:18px 0;">載入中…</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <div class="liff-section-head">
        <h2>每日趨勢</h2>
        <div class="liff-range-toggle">
          <label><input type="radio" name="trend-days" value="7" /> 7 天</label>
          <label><input type="radio" name="trend-days" value="30" checked /> 30 天</label>
        </div>
      </div>
      <div class="muted" style="font-size:12px;margin-bottom:12px;">
        來訪、看餐廳、點訂位看左邊的刻度；轉換率（%）看右邊。轉換率＝當天點訂位次數 ÷ 當天看餐廳次數。
      </div>
      <p class="liff-empty" id="trend-empty" hidden></p>
      <div class="liff-trend-wrap" id="trend-wrap">
        <canvas id="trend-chart"></canvas>
      </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
    <script>
    (function () {
      var $ = function (id) { return document.getElementById(id); };

      var funnelChart = null;
      var trendChart = null;

      var INK = '#1f2937';
      var GRAY = '#9ca3af';
      var GRAY_LIGHT = '#cbd5e1';
      var GRAY_MID = '#6b7280';
      var BRAND = '#FCC726';

      function fmt(n) {
        if (n == null) return '—';
        return Number(n).toLocaleString('zh-Hant-TW');
      }
      function fmtPct(p) {
        if (p == null) return '—';
        return Number(p).toFixed(2) + '%';
      }
      function nowLabel() {
        var d = new Date();
        var hh = String(d.getHours()).padStart(2, '0');
        var mm = String(d.getMinutes()).padStart(2, '0');
        return d.getFullYear() + '-' +
          String(d.getMonth() + 1).padStart(2, '0') + '-' +
          String(d.getDate()).padStart(2, '0') + ' ' +
          hh + ':' + mm;
      }
      function escapeHtml(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
      }
      function fmtTime(ts) {
        if (!ts) return '—';
        var d = new Date(ts);
        if (isNaN(d.getTime())) return String(ts);
        var pad = function (n) { return String(n).padStart(2, '0'); };
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +
               ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
      }
      function shortUid(uid) {
        if (!uid) return '';
        return uid.slice(0, 6) + '…' + uid.slice(-4);
      }

      // ---------------- 今日即時概覽 ----------------
      var overviewIds = [
        'kpi-open-events',    'kpi-open-users',
        'kpi-map-events',     'kpi-map-users',
        'kpi-view-events',    'kpi-view-users',
        'kpi-booking-events', 'kpi-booking-users',
        'kpi-conv-event',     'kpi-conv-user'
      ];
      function loadOverview() {
        return fetch('/admin/liff/random-rice/api/overview')
          .then(function (r) { return r.json(); })
          .then(function (resp) {
            if (!resp.ok) throw new Error(resp.detail || 'overview failed');
            var d = resp.data || {};
            var open = d.open || {}, map = d.map || {}, view = d.view || {};
            var booking = d.booking || {}, conv = d.conv || {}, decide = d.decide || {};
            $('kpi-open-events').textContent    = fmt(open.events);
            $('kpi-open-users').textContent     = fmt(open.users);
            $('kpi-map-events').textContent     = fmt(map.events);
            $('kpi-map-users').textContent      = fmt(map.users);
            $('kpi-view-events').textContent    = fmt(view.events);
            $('kpi-view-users').textContent     = fmt(view.users);
            $('kpi-booking-events').textContent = fmt(booking.events);
            $('kpi-booking-users').textContent  = fmt(booking.users);
            $('kpi-conv-event').textContent     = fmtPct(conv.by_event_pct);
            $('kpi-conv-user').textContent      = fmtPct(conv.by_user_pct);
            renderOverviewNote(open, decide);
          })
          .catch(function (e) {
            console.error('overview load failed:', e);
            overviewIds.forEach(function (id) { $(id).textContent = '—'; });
            $('kpi-note').textContent = '今天的數字讀不到，按右上角的重新整理再試一次。';
          });
      }

      function renderOverviewNote(open, decide) {
        var visits = Number(open.visits || 0);
        var click = Number(decide.click || 0);
        var result = Number(decide.result || 0);
        var redraw = Number(decide.redraw || 0);
        var parts = [];
        if (visits > 0) {
          parts.push('今天共 ' + fmt(visits) + ' 趟來訪。');
        } else {
          parts.push('今天還沒有人打開活動頁。');
        }
        if (click > 0 || result > 0) {
          parts.push('「幫我決定」被按了 ' + fmt(click) + ' 次，出現 ' + fmt(result) + ' 次結果，重抽 ' + fmt(redraw) + ' 次。');
        } else {
          parts.push('今天還沒有人用「幫我決定」。');
        }
        $('kpi-note').textContent = parts.join(' ');
      }

      // ---------------- 核心漏斗 ----------------
      var lastFunnelSteps = [];
      var METRIC_NAMES = { sessions: '來訪', users: '人數', events: '次數' };

      function loadFunnel(days) {
        return fetch('/admin/liff/random-rice/api/funnel?days=' + encodeURIComponent(days))
          .then(function (r) { return r.json(); })
          .then(function (resp) {
            if (!resp.ok) throw new Error(resp.detail || 'funnel failed');
            lastFunnelSteps = resp.data || [];
            renderFunnel();
          })
          .catch(function (e) {
            console.error('funnel load failed:', e);
            lastFunnelSteps = [];
            $('funnel-wrap').hidden = true;
            $('funnel-table-wrap').hidden = true;
            $('funnel-empty').hidden = false;
            $('funnel-empty').textContent = '這段數字讀不到，按右上角的重新整理再試一次。';
          });
      }

      function currentFunnelMetric() {
        return (document.querySelector('input[name="funnel-metric"]:checked') || {}).value || 'sessions';
      }

      // 區間內完全沒動靜時，四步全是 0、第一步還會寫 100%，看起來像壞掉。
      // 這種時候整組圖表收起來，只留一句白話。
      function funnelHasData(steps) {
        return steps.some(function (s) {
          return Number(s.events || 0) > 0 || Number(s.sessions || 0) > 0 || Number(s.users || 0) > 0;
        });
      }

      function renderFunnel() {
        var metric = currentFunnelMetric();
        var hasData = lastFunnelSteps.length > 0 && funnelHasData(lastFunnelSteps);
        $('funnel-wrap').hidden = !hasData;
        $('funnel-table-wrap').hidden = !hasData;
        $('funnel-empty').hidden = hasData;
        if (!hasData) {
          $('funnel-empty').textContent = '這段時間還沒有人打開活動頁，所以還沒有數字可以看。';
          return;
        }
        renderFunnelChart(lastFunnelSteps, metric);
        renderFunnelTable(lastFunnelSteps, metric);
      }

      function stepValue(step, metric) {
        if (metric === 'users') return step.users;
        if (metric === 'events') return step.events;
        return step.sessions;
      }

      function renderFunnelChart(steps, metric) {
        var labels = steps.map(function (s) { return s.label; });
        var counts = steps.map(function (s) { return stepValue(s, metric); });
        var colors = steps.map(function (s, i) {
          return i === steps.length - 1 ? BRAND : '#d1d5db';
        });
        var ctx = $('funnel-chart').getContext('2d');
        if (funnelChart) funnelChart.destroy();
        funnelChart = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [{
              label: METRIC_NAMES[metric] || '來訪',
              data: counts,
              backgroundColor: colors,
              borderColor: '#9ca3af',
              borderWidth: 1,
              borderRadius: 4
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  afterLabel: function (c) {
                    var step = steps[c.dataIndex];
                    if (!step) return '';
                    var fromPrev = step[metric + '_from_prev_pct'];
                    var fromFirst = step[metric + '_from_first_pct'];
                    var lines = [];
                    if (fromPrev != null) lines.push('比上一步: ' + Number(fromPrev).toFixed(2) + '%');
                    if (fromFirst != null) lines.push('比第一步: ' + Number(fromFirst).toFixed(2) + '%');
                    if (step.note) lines.push(step.note);
                    return lines;
                  }
                }
              }
            },
            scales: {
              x: { grid: { display: false } },
              y: { beginAtZero: true, ticks: { precision: 0 } }
            }
          }
        });
      }

      function renderFunnelTable(steps, metric) {
        var tbody = $('funnel-tbody');
        var name = METRIC_NAMES[metric] || '來訪';
        $('funnel-th-prev').textContent = '比上一步（' + name + '）';
        $('funnel-th-first').textContent = '比第一步（' + name + '）';
        tbody.innerHTML = steps.map(function (s, i) {
          var prev = s[metric + '_from_prev_pct'];
          var first = s[metric + '_from_first_pct'];
          var isLast = i === steps.length - 1;
          return '<tr' + (isLast ? ' class="liff-funnel-goal"' : '') + '>' +
            '<td><div class="liff-step-label">' + escapeHtml(s.label) + '</div>' +
              '<div class="liff-step-note">' + escapeHtml(s.note || '') + '</div></td>' +
            '<td style="text-align:right;">' + fmt(s.sessions) + '</td>' +
            '<td style="text-align:right;">' + fmt(s.users) + '</td>' +
            '<td style="text-align:right;">' + fmt(s.events) + '</td>' +
            '<td style="text-align:right;">' + (prev == null ? '—' : fmtPct(prev)) + '</td>' +
            '<td style="text-align:right;">' + (first == null ? '—' : fmtPct(first)) + '</td>' +
            '</tr>';
        }).join('');
      }

      // ---------------- 最多人看的餐廳 ----------------
      function loadRestaurants(days) {
        return fetch('/admin/liff/random-rice/api/restaurants?days=' + encodeURIComponent(days) + '&limit=10')
          .then(function (r) { return r.json(); })
          .then(function (resp) {
            if (!resp.ok) throw new Error(resp.detail || 'restaurants failed');
            renderRestaurants(resp.data || []);
          })
          .catch(function (e) {
            console.error('restaurants load failed:', e);
            $('rest-tbody').innerHTML = '<tr><td colspan="4" class="muted" style="text-align:center;padding:18px 0;">這段數字讀不到，按右上角的重新整理再試一次。</td></tr>';
          });
      }

      function renderRestaurants(rows) {
        var tbody = $('rest-tbody');
        if (!rows.length) {
          tbody.innerHTML = '<tr><td colspan="4" class="muted" style="text-align:center;padding:18px 0;">這段時間還沒有人點開任何一間餐廳。</td></tr>';
          return;
        }
        tbody.innerHTML = rows.map(function (r, i) {
          var tier = r.tier_label ? '<span class="liff-rest-tier">' + escapeHtml(r.tier_label) + '</span>' : '';
          return '<tr>' +
            '<td>' +
              '<div class="liff-rest-name"><span class="liff-rank">' + (i + 1) + '</span>' + escapeHtml(r.name) + '</div>' +
              tier +
            '</td>' +
            '<td style="text-align:right;">' + fmt(r.views) + '</td>' +
            '<td style="text-align:right;">' + fmt(r.people) + '</td>' +
            '<td style="text-align:right;font-weight:600;">' + fmt(r.bookings) + '</td>' +
          '</tr>';
        }).join('');
      }

      // ---------------- 會員視角：玩的人裡面有幾個是我的會員 ----------------
      function rangeLabel(days) {
        var n = Number(days);
        if (n === 7) return '近 7 天';
        if (n === 30) return '近 30 天';
        return '目前為止';
      }

      function loadAudience(days) {
        return fetch('/admin/liff/random-rice/api/audience?days=' + encodeURIComponent(days))
          .then(function (r) { return r.json(); })
          .then(function (resp) {
            if (!resp.ok) throw new Error(resp.detail || 'audience failed');
            renderAudience(resp.data || {}, days);
          })
          .catch(function (e) {
            console.error('audience load failed:', e);
            hideAudienceDetail();
            $('aud-lead').textContent = '這段數字讀不到，按右上角的重新整理再試一次。';
          });
      }

      function hideAudienceDetail() {
        $('aud-grid').hidden = true;
        $('aud-foot').hidden = true;
        $('aud-actions').hidden = true;
        $('aud-table-wrap').hidden = true;
      }

      function renderAudience(d, days) {
        var member = d.member || {}, old = d.old || {}, unknown = d.unknown || {}, anon = d.anon || {};
        var label = rangeLabel(days);
        var people = Number(d.people_with_id || 0);
        var memberPeople = Number(member.people || 0);
        var anonEvents = Number(anon.events || 0);

        // 完全沒資料：講一句話，不要留一排 0 讓人以為壞掉
        if (!people && !anonEvents) {
          hideAudienceDetail();
          $('aud-lead').textContent = label + '沒有人打開過活動頁，所以還沒有數字可以看。';
          return;
        }

        var lead = label + '有 <b>' + fmt(people) + '</b> 個人用過活動頁，' +
                   '其中 <b>' + fmt(memberPeople) + '</b> 位是你現在的 LINE 好友。';
        if (people > 0 && memberPeople === 0) {
          lead += ' 也就是說，現在玩的人你都還發不到訊息。';
        }
        $('aud-lead').innerHTML = lead;

        $('aud-grid').hidden = false;
        $('aud-member-people').textContent = fmt(memberPeople) + ' 人';
        $('aud-member-events').textContent = '共 ' + fmt(Number(member.events || 0)) + ' 次使用';
        $('aud-old-people').textContent = fmt(Number(old.people || 0)) + ' 人';
        $('aud-old-events').textContent = '共 ' + fmt(Number(old.events || 0)) + ' 次使用';
        $('aud-unknown-people').textContent = fmt(Number(unknown.people || 0)) + ' 人';
        $('aud-unknown-events').textContent = '共 ' + fmt(Number(unknown.events || 0)) + ' 次使用';

        var notes = [];
        if (anonEvents > 0) {
          notes.push('另外有 ' + fmt(anonEvents) + ' 次使用沒有留下身分（不是從 LINE 裡面打開的），這些算不出是誰。');
        }
        if (memberPeople > 0) {
          notes.push('會員的部分你可以直接發訊息追，其他人要先想辦法讓他加好友。');
        }
        if (notes.length) {
          $('aud-foot').hidden = false;
          $('aud-foot').textContent = notes.join(' ');
        } else {
          $('aud-foot').hidden = true;
        }

        renderAudienceActions(d.member_actions || {}, memberPeople);
        renderAudienceMembers(d.members || []);
      }

      function renderAudienceActions(acts, memberPeople) {
        var box = $('aud-actions');
        if (!memberPeople) { box.hidden = true; box.innerHTML = ''; return; }
        var items = [
          ['開啟過活動頁', acts.open],
          ['看過餐廳', acts.view],
          ['點過訂位', acts.booking]
        ];
        box.innerHTML = items.map(function (it) {
          return '<span class="liff-aud-act"><b>' + fmt(Number(it[1] || 0)) + '</b> 位會員' + it[0] + '</span>';
        }).join('');
        box.hidden = false;
      }

      function renderAudienceMembers(rows) {
        var wrap = $('aud-table-wrap');
        var tbody = $('aud-tbody');
        if (!rows.length) { wrap.hidden = true; tbody.innerHTML = ''; return; }
        tbody.innerHTML = rows.map(function (m) {
          var name = m.display_name
            ? escapeHtml(m.display_name)
            : '<span class="liff-user-anon">還沒抓到名字</span>';
          var avatarHtml = m.picture_url
            ? '<img src="' + escapeHtml(m.picture_url) + '" alt="" class="liff-user-avatar" />'
            : '<div class="liff-user-avatar liff-user-avatar--blank">' + escapeHtml((m.display_name || '?').slice(0, 1)) + '</div>';
          return '<tr>' +
            '<td class="liff-user-cell">' +
              '<div class="liff-user-row">' +
                avatarHtml +
                '<div class="liff-user-meta">' +
                  '<div class="liff-user-name">' + name + '</div>' +
                  '<div class="liff-aud-since">共來過 ' + fmt(m.visits) + ' 次</div>' +
                '</div>' +
              '</div>' +
            '</td>' +
            '<td style="text-align:right;">' + fmt(m.opens) + '</td>' +
            '<td style="text-align:right;">' + fmt(m.views) + '</td>' +
            '<td style="text-align:right;font-weight:600;">' + fmt(m.bookings) + '</td>' +
            '<td>' + fmtTime(m.last_seen) + '</td>' +
          '</tr>';
        }).join('');
        wrap.hidden = false;
      }

      // ---------------- 用過的人清單 ----------------
      function loadUsers(days) {
        return fetch('/admin/liff/random-rice/api/users?days=' + encodeURIComponent(days))
          .then(function (r) { return r.json(); })
          .then(function (resp) {
            if (!resp.ok) throw new Error(resp.detail || 'users failed');
            renderUsersTable(resp.data || []);
          })
          .catch(function (e) {
            console.error('users load failed:', e);
            $('users-tbody').innerHTML = '<tr><td colspan="6" class="muted" style="text-align:center;padding:18px 0;">這段數字讀不到，按右上角的重新整理再試一次。</td></tr>';
          });
      }

      function renderUsersTable(rows) {
        var tbody = $('users-tbody');
        if (!rows.length) {
          tbody.innerHTML = '<tr><td colspan="6" class="muted" style="text-align:center;padding:18px 0;">這段時間沒有留得下身分的人打開活動頁。</td></tr>';
          return;
        }
        tbody.innerHTML = rows.map(function (u) {
          var displayName = u.display_name
            ? escapeHtml(u.display_name)
            : '<span class="liff-user-anon">名單裡對不到這個人</span>';
          var convPct = u.views > 0 ? (Math.round(u.bookings / u.views * 10000) / 100).toFixed(2) + '%' : '—';
          var avatarHtml = u.picture_url
            ? '<img src="' + escapeHtml(u.picture_url) + '" alt="" class="liff-user-avatar" />'
            : '<div class="liff-user-avatar liff-user-avatar--blank">' + escapeHtml((u.display_name || '?').slice(0, 1)) + '</div>';
          var crmBadge = u.in_crm
            ? '<span class="liff-user-badge">已在名單</span>'
            : '<span class="liff-user-badge liff-user-badge--out">不在名單</span>';
          return '<tr>' +
            '<td class="liff-user-cell">' +
              '<div class="liff-user-row">' +
                avatarHtml +
                '<div class="liff-user-meta">' +
                  '<div class="liff-user-name">' + displayName + ' ' + crmBadge + '</div>' +
                  '<button type="button" class="liff-user-uid" data-uid="' + escapeHtml(u.line_id) + '" title="點一下複製完整代碼">' +
                    escapeHtml(shortUid(u.line_id)) +
                  '</button>' +
                '</div>' +
              '</div>' +
            '</td>' +
            '<td style="text-align:right;">' + fmt(u.visits) + '</td>' +
            '<td style="text-align:right;">' + fmt(u.views) + '</td>' +
            '<td style="text-align:right;font-weight:600;">' + fmt(u.bookings) + '</td>' +
            '<td style="text-align:right;">' + convPct + '</td>' +
            '<td>' + fmtTime(u.last_seen) + '</td>' +
          '</tr>';
        }).join('');
        // 點一下複製完整代碼
        tbody.querySelectorAll('.liff-user-uid').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var uid = btn.getAttribute('data-uid');
            if (!uid) return;
            navigator.clipboard.writeText(uid).then(function () {
              var orig = btn.textContent;
              btn.textContent = '已複製';
              btn.classList.add('copied');
              setTimeout(function () {
                btn.textContent = orig;
                btn.classList.remove('copied');
              }, 1200);
            }).catch(function () { alert(uid); });
          });
        });
      }

      // ---------------- 每日趨勢 ----------------
      function loadTrend(days) {
        return fetch('/admin/liff/random-rice/api/trend?days=' + encodeURIComponent(days))
          .then(function (r) { return r.json(); })
          .then(function (resp) {
            if (!resp.ok) throw new Error(resp.detail || 'trend failed');
            renderTrendChart(resp.data || []);
          })
          .catch(function (e) {
            console.error('trend load failed:', e);
            $('trend-wrap').hidden = true;
            $('trend-empty').hidden = false;
            $('trend-empty').textContent = '這段數字讀不到，按右上角的重新整理再試一次。';
          });
      }

      function renderTrendChart(rows) {
        // 整段都是 0 的話畫出來是一條貼底的線，不如直接講一句
        var hasData = rows.some(function (r) {
          return Number(r.visits || 0) > 0 || Number(r.views || 0) > 0 || Number(r.bookings || 0) > 0;
        });
        $('trend-wrap').hidden = !hasData;
        $('trend-empty').hidden = hasData;
        if (!hasData) {
          $('trend-empty').textContent = '這段時間還沒有人打開活動頁，所以畫不出趨勢。';
          return;
        }
        var labels = rows.map(function (r) { return r.day; });
        var visits = rows.map(function (r) { return r.visits; });
        var views = rows.map(function (r) { return r.views; });
        var bookings = rows.map(function (r) { return r.bookings; });
        var conv = rows.map(function (r) { return r.conversion_rate_pct; });
        var ctx = $('trend-chart').getContext('2d');
        if (trendChart) trendChart.destroy();
        trendChart = new Chart(ctx, {
          data: {
            labels: labels,
            datasets: [
              {
                type: 'line', label: '來訪', data: visits,
                borderColor: GRAY_LIGHT, backgroundColor: 'transparent',
                fill: false, tension: 0.3, yAxisID: 'y', pointRadius: 2
              },
              {
                type: 'line', label: '看餐廳', data: views,
                borderColor: GRAY_MID, backgroundColor: 'transparent',
                fill: false, tension: 0.3, yAxisID: 'y', pointRadius: 2
              },
              {
                type: 'line', label: '點訂位', data: bookings,
                borderColor: BRAND, backgroundColor: 'rgba(252,199,38,0.14)',
                borderWidth: 3, fill: true, tension: 0.3, yAxisID: 'y', pointRadius: 2
              },
              {
                type: 'line', label: '轉換率 %', data: conv,
                borderColor: INK, borderDash: [4, 4],
                backgroundColor: 'transparent', fill: false,
                tension: 0.3, yAxisID: 'y1', pointRadius: 2
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            stacked: false,
            plugins: { legend: { position: 'bottom' } },
            scales: {
              x: { grid: { display: false } },
              y:  { type: 'linear', position: 'left',  beginAtZero: true, ticks: { precision: 0 } },
              y1: {
                type: 'linear', position: 'right',
                beginAtZero: true,
                grid: { drawOnChartArea: false },
                ticks: {
                  callback: function (v) { return v + '%'; }
                }
              }
            }
          }
        });
      }

      // ---------------- 觸發 + 互動 ----------------
      function pick(name, fallback) {
        return (document.querySelector('input[name="' + name + '"]:checked') || {}).value || fallback;
      }

      function refreshAll() {
        $('liff-last-updated').textContent = '載入中…';
        Promise.all([
          loadOverview(),
          loadAudience(pick('aud-days', 7)),
          loadFunnel(pick('funnel-days', 7)),
          loadRestaurants(pick('rest-days', 30)),
          loadUsers(pick('users-days', 7)),
          loadTrend(pick('trend-days', 30))
        ]).then(function () {
          $('liff-last-updated').textContent = '最後更新: ' + nowLabel();
        });
      }

      document.querySelectorAll('input[name="funnel-days"]').forEach(function (el) {
        el.addEventListener('change', function () { loadFunnel(el.value); });
      });
      document.querySelectorAll('input[name="funnel-metric"]').forEach(function (el) {
        el.addEventListener('change', function () { renderFunnel(); });
      });
      document.querySelectorAll('input[name="rest-days"]').forEach(function (el) {
        el.addEventListener('change', function () { loadRestaurants(el.value); });
      });
      document.querySelectorAll('input[name="trend-days"]').forEach(function (el) {
        el.addEventListener('change', function () { loadTrend(el.value); });
      });
      document.querySelectorAll('input[name="users-days"]').forEach(function (el) {
        el.addEventListener('change', function () { loadUsers(el.value); });
      });
      document.querySelectorAll('input[name="aud-days"]').forEach(function (el) {
        el.addEventListener('change', function () { loadAudience(el.value); });
      });
      $('btn-liff-refresh').addEventListener('click', refreshAll);

      refreshAll();
    })();
    </script>

