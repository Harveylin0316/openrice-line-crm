<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#F9C73B" />
  <title><%= title %></title>
  <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
  <script src="/games-mgm.js?v=20260811a"></script>
  <style>
    /* ── OpenRice 九月轉盤 ─────────────────────────────────────────
       設計準據：openrice-september-wheel-ready-state-v1.png
       紙感暖底、黃銅轉盤、手繪食物線稿、活版印刷按鈕。
       禁用：紫藍漸層 / 毛玻璃 / 光暈球 / 漸層標題 / emoji / 紙花 / 滿頁陰影。 */
    /* 這頁固定亮色。原本跟著系統深色模式走，結果手機開深色就整頁變黑，
       跟品牌素材（奶油白底＋暖色扁平插畫）完全對不上。設計定案是亮色，不做深色版。 */
    :root{
      --ink:#3F2C25; --ink2:#806A61; --paper:#F7F4EC; --surface:#FFFFFF;
      --orange:#E8491D; --yellow:#F9C73B; --yellow-soft:#FFF7D6; --line:#EDE4CE;
      color-scheme: light;
    }
    *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
    /* display:flex/block 會蓋掉瀏覽器預設的 [hidden]，JS 藏不掉元素 */
    [hidden]{display:none !important}
    html,body{margin:0;padding:0}
    body{
      background:var(--paper); color:var(--ink);
      font-family:"PingFang TC","Heiti TC","Microsoft JhengHei",sans-serif;
      -webkit-font-smoothing:antialiased;
      padding-bottom:env(safe-area-inset-bottom);
    }
    .page{position:relative;z-index:1;max-width:520px;min-height:100svh;margin:0 auto;padding:16px 18px 32px;background:var(--surface)}

    /* ── 品牌列 ── */
    .brand-bar{display:flex;align-items:center;gap:8px;margin-bottom:10px}
    .logo{font-weight:800;font-size:20px;letter-spacing:-.02em;color:var(--ink)}
    .logo .o{color:var(--orange)}
    .chip{font-size:11px;font-weight:800;background:var(--yellow);border:0;border-radius:999px;padding:3px 9px;color:var(--ink)}

    /* ── 標題 ── */
    .hero{position:relative;margin:0 0 14px;padding:17px 18px;border-radius:18px;background:var(--yellow-soft);overflow:hidden}
    .hero h1{
      margin:0;font-size:32px;line-height:1.15;font-weight:900;letter-spacing:-.01em;
      max-width:76%;
    }
    /* 手寫感底線：兩段不等長，避免電腦畫出來的死板 */
    .hero .rule{display:none}
    .hero p{margin:7px 0 0;font-size:13px;color:var(--ink2);line-height:1.55;max-width:76%}
    .hero .art{position:absolute;top:3px;right:2px;width:98px;opacity:.66;pointer-events:none}

    /* ── 轉盤 ── */
    .stage-wrap{margin:0;display:flex;justify-content:center}
    .stage{position:relative;width:min(82vw,318px);aspect-ratio:1;}
    .ring{position:absolute;inset:0;pointer-events:none;z-index:3}
    .canvas-wrap{position:absolute;inset:7.5%;border-radius:50%;overflow:hidden}
    #wheel{width:100%;height:100%;display:block}
    /* 指針：有重量的實體物件，不是三角形 */
    .pointer{position:absolute;left:50%;top:-9px;transform:translateX(-50%);z-index:5;filter:drop-shadow(0 3px 3px rgba(62,39,35,.22))}
    /* 中心轂 */
    .hub{
      position:absolute;left:50%;top:50%;width:19%;aspect-ratio:1;transform:translate(-50%,-50%);
      border-radius:50%;z-index:4;border:0;padding:0;cursor:pointer;
      background:#FFFFFF;
      border:3.4px solid #4E342E;
      font-size:0;color:transparent;
      background-image:url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Cpath d='M9 21 h30 a15 15 0 0 1 -30 0 z' fill='%23FFFFFF' stroke='%234E342E' stroke-width='3' stroke-linejoin='round'/%3E%3Cpath d='M13 21 a11 6 0 0 1 22 0 z' fill='%23FBC02D' stroke='%234E342E' stroke-width='2.6' stroke-linejoin='round'/%3E%3Cpath d='M18 29 q6 5 12 0' fill='none' stroke='%23E8491D' stroke-width='2.8' stroke-linecap='round'/%3E%3C/svg%3E");
      background-size:74% 74%;background-position:center;background-repeat:no-repeat;
    }
    .hub:disabled{cursor:default}
    #wheel.windup{transition:transform .32s cubic-bezier(.34,.02,.72,.24)}
    .stage.spinning #wheel{transition:transform 4.05s cubic-bezier(.12,.74,.14,1)}
    .stage.landed .hub{animation:hubKnock .42s ease-out}
    @keyframes hubKnock{0%{transform:translate(-50%,-50%) scale(1)}30%{transform:translate(-50%,-50%) scale(.93)}100%{transform:translate(-50%,-50%) scale(1)}}

    /* ── 狀態行：數字是主角 ── */
    .status-row{margin:14px 0 0;text-align:center}
    .status-row .big{font-size:22px;font-weight:900;letter-spacing:-.01em;line-height:1.1}
    .status-row .n{font-size:42px;color:var(--orange);margin:0 5px;vertical-align:-4px;display:inline-block}
    .status-row .sub{margin-top:5px;font-size:13px;color:var(--ink2);line-height:1.5;min-height:19px}
    .status-row .sub .name{font-weight:800;color:var(--ink)}
    .status-row.ready .sub{color:var(--ink)}
    .status-row.done .big{font-size:19px;color:var(--ink2)}
    .status-row.done .n{display:none}
    @keyframes statPop{0%{transform:scale(1)}34%{transform:scale(1.32)}100%{transform:scale(1)}}
    .pop{animation:statPop .42s cubic-bezier(.2,1.4,.4,1)}

    /* ── 主行動：活版印刷，實心位移陰影不是柔光 ── */
    .cta{
      display:block;width:100%;margin:13px 0 0;padding:16px 20px;border:0;border-radius:14px;
      background:var(--yellow);color:var(--ink);font-size:20px;font-weight:900;font-family:inherit;
      letter-spacing:.02em;cursor:pointer;box-shadow:0 5px 12px rgba(171,124,0,.18);transition:transform .1s, box-shadow .1s;
    }
    .cta:active{transform:translateY(2px);box-shadow:0 2px 6px rgba(171,124,0,.18)}
    .cta:disabled{background:#EDE9DF;color:#A69B95;box-shadow:none;cursor:default}
    .cta.ghost{background:#fff;color:var(--ink);border:1.5px solid var(--line);box-shadow:none}
    .cta.ghost:active{transform:translateY(1px)}

    /* ── 分隔：虛線，不是實線卡片邊 ── */
    .dash{border:0;border-top:1px solid var(--line);margin:18px 0}

    /* ── 邀請區：刻意不做成又一張圓角卡片 ── */
    .invite-card{display:flex;align-items:center;gap:13px;padding:15px;border-radius:16px;background:var(--yellow-soft)}
    .invite-card.maxed{opacity:.72}
    .invite-art{width:52px;flex:0 0 auto;opacity:.85}
    .invite-left{flex:1;min-width:0}
    .invite-title{font-size:16px;font-weight:800;line-height:1.35}
    .invite-title .n{color:var(--orange);font-size:19px;margin:0 2px}
    .invite-sub{font-size:12px;color:var(--ink2);margin-top:3px;line-height:1.5}
    .invite-meta{font-size:12px;color:var(--ink2);margin-top:3px;line-height:1.5}
    #invite-existing{display:block;font-size:11px;opacity:.9}
    .invite-meta .n{font-size:16px;font-weight:900;color:var(--orange);margin:0 2px;display:inline-block}
    .invite-card.maxed .invite-meta .n{color:var(--ink2)}
    .invite-btn{
      flex:0 0 auto;padding:11px 17px;border:0;border-radius:10px;background:var(--yellow);
      color:var(--ink);font-size:15px;font-weight:800;font-family:inherit;cursor:pointer;
    }
    .invite-btn:active{transform:translateY(1px)}
    .invite-card.maxed .invite-btn{background:#EEE8D9;color:var(--ink2)}

    /* ── 結果：由下往上推的 bottom sheet ── */
    .modal{position:fixed;inset:0;z-index:60;display:none}
    .modal.shown{display:block}
    .modal::before{content:'';position:absolute;inset:0;background:rgba(45,28,22,.55);opacity:0;transition:opacity .26s}
    .modal.open::before{opacity:1}
    .sheet{
      position:absolute;left:0;right:0;bottom:0;background:var(--surface);
      border-radius:24px 24px 0 0;padding:24px 22px calc(24px + env(safe-area-inset-bottom));
      text-align:center;transform:translateY(102%);transition:transform .38s cubic-bezier(.16,.9,.24,1);
      max-height:88vh;overflow-y:auto;box-shadow:0 -4px 0 var(--yellow);
    }
    .modal.open .sheet{transform:translateY(0)}
    .modal.grand .sheet{background:var(--yellow-soft);box-shadow:0 -5px 0 var(--yellow)}
    .ornament{display:flex;align-items:center;justify-content:center;gap:9px;color:var(--orange);margin-bottom:11px}
    .ornament i{display:block;width:38px;height:1.5px;background:currentColor;opacity:.55}
    .ornament b{font-size:15px;font-style:normal;line-height:1}
    .modal.grand .ornament{color:#7A5B00}
    .modal-eyebrow{font-size:14px;font-weight:800;color:var(--ink);margin-bottom:7px}
    .modal-img-wrap{margin:0 0 8px;min-height:0}
    .modal-img-wrap img{max-width:190px;max-height:150px;border-radius:14px}
    .modal-prize{font-size:31px;font-weight:900;line-height:1.2;color:var(--orange);letter-spacing:-.01em}
    .modal.grand .modal-prize{color:#3E2723;font-size:33px}
    .modal.noprize .modal-prize{color:var(--ink);font-size:25px}
    .modal.noprize .ornament{color:var(--ink2)}
    .modal-desc{font-size:13.5px;color:var(--ink2);margin-top:8px;line-height:1.6}
    .modal.grand .modal-desc{color:#6B5200}
    .modal-btn{
      display:block;width:100%;margin-top:17px;padding:15px;border:0;border-radius:9px;
      background:var(--yellow);color:var(--ink);font-size:17px;font-weight:900;font-family:inherit;cursor:pointer;
      box-shadow:0 4px 10px rgba(171,124,0,.18);
    }
    .modal-btn:active{transform:translateY(2px);box-shadow:0 2px 5px rgba(171,124,0,.18)}
    .modal.grand .modal-btn{background:var(--yellow);color:var(--ink);box-shadow:0 4px 10px rgba(171,124,0,.18)}
    .modal.grand .modal-btn:active{box-shadow:0 2px 5px rgba(171,124,0,.18)}
    .sheet-dismiss{display:block;margin:13px auto 0;border:0;background:transparent;font-family:inherit;
      font-size:13.5px;font-weight:700;color:var(--ink2);cursor:pointer;text-decoration:underline;text-underline-offset:3px}
    .modal-prize.pop{animation:statPop .46s cubic-bezier(.2,1.4,.4,1)}
    .myprize{margin-top:18px;padding:16px;border:2px solid var(--yellow);border-radius:16px;background:#fff}
    .myprize-head{font-size:18px;font-weight:900;color:var(--ink)}
    .myprize-note{font-size:12px;color:var(--ink2);margin:3px 0 8px;line-height:1.5}
    .pz{display:flex;align-items:flex-start;gap:10px;padding:12px 0;border-bottom:1px solid var(--line)}
    .pz:first-child{margin:0 -7px;padding:12px 9px;border-radius:11px;background:var(--yellow-soft);border-bottom:0}
    .pz:last-child{border-bottom:0}
    .pz-main{flex:1;min-width:0}
    .pz-name{font-size:15px;font-weight:900;color:var(--ink);line-height:1.4}
    .pz-latest{display:inline-block;margin-right:6px;padding:2px 6px;border-radius:999px;background:var(--yellow);font-size:10px;font-weight:900;vertical-align:1px}
    .pz-miss .pz-name{font-weight:700;color:var(--ink2)}
    .pz-miss{opacity:.78}
    .pz-sub{font-size:12px;color:var(--ink2);margin-top:3px;line-height:1.6}
    .pz-code{display:inline-flex;align-items:center;gap:8px;margin-top:6px;padding:6px 10px;border:1px dashed var(--line);border-radius:8px;font-size:13px;font-weight:800;color:var(--ink);letter-spacing:.04em}
    .pz-copy{border:0;background:var(--orange);color:#fff;font-size:11.5px;font-weight:800;padding:4px 9px;border-radius:6px;cursor:pointer}
    .pz-when{font-size:11.5px;color:var(--ink2);white-space:nowrap;padding-top:3px}
    .modal-foot{font-size:12.5px;color:var(--ink2);margin-top:11px;line-height:1.6}
    .modal-foot .n{color:var(--orange);font-weight:900;font-size:15px;margin:0 2px}

    /* ── 優惠碼：橘框盒 + 複製 ── */
    .coupon-block{margin-top:15px;border:2px solid var(--orange);border-radius:10px;display:flex;align-items:stretch;overflow:hidden}
    .coupon-code{flex:1;padding:13px 12px;font-size:21px;font-weight:800;letter-spacing:.05em;color:var(--ink);
      font-family:ui-monospace,Menlo,Consolas,monospace;word-break:break-all;display:flex;align-items:center;justify-content:center}
    .coupon-copy{flex:0 0 auto;width:70px;border:0;border-left:2px solid var(--orange);background:transparent;
      color:var(--ink);font-family:inherit;font-size:11px;font-weight:800;cursor:pointer;display:flex;
      flex-direction:column;align-items:center;justify-content:center;gap:3px}
    .coupon-oos{margin-top:13px;font-size:13px;color:var(--ink2);line-height:1.6}
    .modal.grand .coupon-block{border-color:#7A5B00}
    .modal.grand .coupon-copy{border-left-color:#7A5B00;color:#3E2723}
    .modal.grand .coupon-code{color:#3E2723}
    /* 大獎彈窗永遠是黃底，所以文字一律鎖深棕，不能跟著深色模式變淺 */
    .modal.grand .modal-eyebrow{color:#3E2723}
    .modal.grand .coupon-oos{color:#6B5200}
    .modal.grand .sheet-dismiss{color:#6B5200}
    .modal.grand .modal-foot{color:#6B5200}
    .modal.grand .modal-foot .n{color:#7A5B00}

    @media (prefers-reduced-motion: reduce){
      #wheel.windup,.stage.spinning #wheel{transition:transform .2s linear}
      .sheet{transition:opacity .2s}
      .stage.landed .hub{animation:none}
      .cta,.modal-btn{transition:none}
    }
  
    /* 官方 logo（去背 PNG）——文字版拼出來的 logo 字距與品牌不一致，統一改用圖檔 */
    .logo-img{height:26px;width:auto;display:block}
    .logo{font-size:0 !important;letter-spacing:0 !important}
    @media (min-width:560px){.page{margin:20px auto;border-radius:22px;box-shadow:0 12px 35px rgba(63,44,37,.09);min-height:calc(100svh - 40px)}}
    @media (max-width:374px){.page{padding-left:14px;padding-right:14px}.hero h1{font-size:29px}.stage{width:min(80vw,292px)}}
    </style>
</head>
<body>
  <div class="page">

    <header class="brand-bar">
      <!-- 正式上線請換成專案內的官方 OpenRice Logo 資產 -->
      <div class="logo"><img src="/images/openrice-wordmark.png" alt="OpenRice 開飯喇" class="logo-img" /></div>
      <div class="chip">台灣</div>
    </header>

    <section class="hero">
      <h1><%= activity.name %></h1>
      <svg class="rule" height="9" viewBox="0 0 240 9" preserveAspectRatio="none" aria-hidden="true">
        <path d="M2 6 C 40 2, 96 8, 150 4 C 186 1.6, 214 5, 236 3" stroke="#F15A22" stroke-width="4" fill="none" stroke-linecap="round"/>
      </svg>
      <% if (activity.description) { %><p><%= activity.description %></p><% } %>
      <!-- 台式火鍋線稿：單色、低透明，題材具體到台灣 -->
      <svg class="art" viewBox="0 0 100 88" fill="none" stroke="#F15A22" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17 42 h66 a4 4 0 0 1 4 4 l-5 26 a8 8 0 0 1-8 7 H26 a8 8 0 0 1-8-7 l-5-26 a4 4 0 0 1 4-4z"/>
        <path d="M13 50 H5 M87 50 h8"/>
        <path d="M24 42 v-9 M34 42 V26 M44 42 V31 M54 42 V24 M64 42 v-13 M74 42 v-7"/>
        <path d="M31 20 c4-4 0-8 3-11 M47 17 c4-4 0-8 3-11 M63 21 c4-4 0-8 3-11" opacity=".72"/>
        <circle cx="38" cy="57" r="4"/><circle cx="56" cy="61" r="4"/><circle cx="68" cy="55" r="3"/>
      </svg>
    </section>

    <div class="stage-wrap">
      <div class="stage" id="stage">
        <!-- 黃銅指針：有厚度、有鉚釘 -->
        <div class="pointer">
          <svg width="40" height="46" viewBox="0 0 40 46" aria-hidden="true">
            <path d="M20 3 C11 3 4 9.6 4 17.6 C4 25.6 12.4 33.4 20 43 C27.6 33.4 36 25.6 36 17.6 C36 9.6 29 3 20 3 Z"
                  fill="#E8491D" stroke="#4E342E" stroke-width="3" stroke-linejoin="round"/>
            <circle cx="20" cy="17" r="4.4" fill="#FBC02D" stroke="#4E342E" stroke-width="2.4"/>
          </svg>
        </div>
        <div class="canvas-wrap"><canvas id="wheel" width="720" height="720"></canvas></div>
        <!-- 扁平深棕外框＋圓點（覆蓋在 canvas 上） -->
        <svg class="ring" viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="96" fill="none" stroke="#4E342E" stroke-width="3.2"/>
          <circle cx="100" cy="100" r="88" fill="none" stroke="#4E342E" stroke-width="3.2"/>
          <g stroke="#4E342E" stroke-width="2.6">
            <circle cx="100" cy="92" r="0" fill="none"/>
          </g>
        </svg>
        <button type="button" id="spin-btn" class="hub" aria-label="開始轉">SPIN</button>
      </div>
    </div>

    <div class="status-row done" id="status-row">
      <div class="big"><span id="stat-lead">準備中</span><span class="n" id="stat-remaining">—</span><span id="stat-unit"></span></div>
      <div class="sub" id="status" aria-live="polite">正在確認你的身分</div>
    </div>

    <button type="button" class="cta" id="cta-spin">開始轉</button>

    <section class="myprize" id="myprize" hidden>
      <div class="myprize-head">我抽到的獎</div>
      <div class="myprize-note">結果會留在這一頁，不用再跳到別的地方找</div>
      <div id="myprize-list" aria-live="polite"></div>
    </section>

    <hr class="dash" />

    <section class="invite-card" id="invite-card">
      <svg class="invite-art" viewBox="0 0 60 52" fill="none" stroke="#8D6E63" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="16" cy="14" r="7"/><path d="M4 47 c0-9 5.6-14 12-14 s12 5 12 14"/>
        <circle cx="43" cy="17" r="6"/><path d="M33 47 c0-8 4.6-12 10-12 s10 4 10 12"/>
        <path d="M30 6 h18 a3 3 0 0 1 3 3 v7 a3 3 0 0 1-3 3 h-11 l-5 4 v-4 h-2 a3 3 0 0 1-3-3 V9 a3 3 0 0 1 3-3z" stroke="#F15A22"/>
      </svg>
      <div class="invite-left">
        <% if (activity.referral_bonus_per && activity.referral_bonus_per > 0) { %>
          <%
  // 邀請規則的人話版本：need=1 →「邀 1 位多 X 次」；need>1 →「每邀 N 位多 X 次」
  var _need = Number(activity.referral_invites_per_bonus || 1);
  var _ruleText = (_need > 1 ? ('每邀 ' + _need + ' 位朋友多 ') : '邀 1 位朋友多 ') + activity.referral_bonus_per + ' 次';
%>
          <div class="invite-title">找朋友一起，多一次機會</div>
          <div class="invite-sub" id="invite-sub"><%= _ruleText %>，最多加 <%= activity.referral_bonus_max %> 次</div>
          <div class="invite-meta">已邀 <span class="n" id="stat-referrals">0</span> 人<span id="invite-existing"></span></div>
        <% } else { %>
          <div class="invite-title">分享給朋友一起玩</div>
          <div class="invite-sub" id="invite-sub">把這個活動傳出去</div>
          <div class="invite-meta" hidden>已邀 <span class="n" id="stat-referrals">0</span> 人</div>
        <% } %>
      </div>
      <button type="button" class="invite-btn" id="invite-btn">找朋友</button>
    </section>

  </div>

  <div id="modal" class="modal" aria-hidden="true">
    <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="modal-prize">
      <div class="ornament"><i></i><b id="modal-glyph">◆</b><i></i></div>
      <div class="modal-eyebrow" id="modal-eyebrow">你抽到了</div>
      <div class="modal-img-wrap" id="modal-img-wrap"><img id="modal-img" alt="" hidden /></div>
      <div class="modal-prize" id="modal-prize">—</div>
      <div class="modal-desc" id="modal-desc"></div>
      <div class="coupon-block" id="coupon-block" hidden>
        <div class="coupon-code" id="coupon-code">—</div>
        <button type="button" class="coupon-copy" id="coupon-copy">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
          複製
        </button>
      </div>
      <div class="coupon-oos" id="coupon-oos" hidden>這份券剛好發完了，我們會依活動規則處理</div>
      <button type="button" class="modal-btn" id="modal-close">完成</button>
      <button type="button" class="sheet-dismiss" id="modal-dismiss" hidden>先不用</button>
      <div class="modal-foot" id="modal-foot" hidden></div>
    </div>
  </div>
  <script>
    (function () {
      var slug = <%- JSON.stringify(activity.slug).replace(/</g,'\\u003c') %>;
      var liffId = <%- JSON.stringify(liffId || '').replace(/</g,'\\u003c') %>;
      var addFriendUrl = <%- JSON.stringify(typeof addFriendUrl !== 'undefined' ? addFriendUrl : '').replace(/</g,'\\u003c') %>;
      var prizes = <%- JSON.stringify(prizes || []).replace(/</g,'\\u003c') %>;
      var GRAND_PRIZE_IMAGE = '/images/share-miles-grand-prize-v1.webp';
      var activityMeta = <%- JSON.stringify({
        name: activity.name,
        referral_bonus_per: activity.referral_bonus_per,
        referral_bonus_max: activity.referral_bonus_max,
        referral_invites_per_bonus: activity.referral_invites_per_bonus || 1
      }).replace(/</g,'\\u003c') %>;

      var canvas = document.getElementById('wheel');
      var ctx = canvas.getContext('2d');
      var spinBtn = document.getElementById('spin-btn');
      var statusEl = document.getElementById('status');
      var statusRow = document.getElementById('status-row');
      var modal = document.getElementById('modal');
      // 一定要在 bootstrap 之前取到：晚宣告的話（var hoisting）bootstrap 讀到 undefined，
      // 「尚未開放」「稍等一下」的初始鎖定完全不會套用
      var ctaBtn = document.getElementById('cta-spin');

      var spinning = false;
      // 防重複扣次數的鑰匙。存進瀏覽器暫存：收訊斷掉後如果使用者是「重新整理」
      // 而不是按按鈕（刮刮樂開頁就自動抽，最容易這樣），重載後還撿得回同一把，
      // 伺服器認得就回原結果，不會被扣第二次。
      var PLAYKEY_STORE = 'orplaykey:' + 'wheel' + ':' + slug;
      function loadPlayKey() {
        try { return sessionStorage.getItem(PLAYKEY_STORE) || null; } catch (e) { return null; }
      }
      function savePlayKey(k) {
        try { if (k) sessionStorage.setItem(PLAYKEY_STORE, k); else sessionStorage.removeItem(PLAYKEY_STORE); } catch (e) {}
      }
      var pendingPlayKey = loadPlayKey();
      var currentRotation = 0;
      var profile = null;
      var idToken = null;
      var liffReady = false;

      var REDUCED = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

      // ----- 觸覺回饋（guard）-----
      function buzz(pattern) {
        if (navigator.vibrate) {
          try { navigator.vibrate(pattern); } catch (e) {}
        }
      }

      // 轉盤停下來之後，把最終角度畫進 canvas 本身（CSS 轉回 0），
      // 這樣扇形位置不變、但文字回到橫排。否則整盤字會跟著旋轉變成上下顛倒。
      var wheelOffsetRad = 0;
      function drawWheel(highlightIdx, pulse) {
        var W = canvas.width;
        var H = canvas.height;
        var cx = W / 2, cy = H / 2;
        var R = W / 2 - 3;
        var n = prizes.length;
        var anglePer = (Math.PI * 2) / n;

        ctx.clearRect(0, 0, W, H);

        // 扇形填色
        prizes.forEach(function (p, i) {
          var start = i * anglePer - Math.PI / 2 + wheelOffsetRad;
          var end = start + anglePer;
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.arc(cx, cy, R, start, end);
          ctx.closePath();
          // 設計配色：米白 / 品牌黃 / 橘，三色輪替；大獎固定橘。
          // n % 3 === 1 時最後一格會跟第一格同色且相鄰，往後推一格避開。
          // 白／淡黃兩色交替；格數為奇數時最後一格會跟第一格同色且相鄰，往後推一格避開
          var ci = i % 2;
          if (i === n - 1 && n > 2 && ci === 0) ci = 1;
          if (p.is_grand_prize) ctx.fillStyle = '#F9C73B';
          else ctx.fillStyle = ['#FFFFFF', '#FFF3C4'][ci];
          ctx.fill();
        });

        // 扇形分隔線（細）
        prizes.forEach(function (p, i) {
          var angle = i * anglePer - Math.PI / 2 + wheelOffsetRad;
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(cx + Math.cos(angle) * R, cy + Math.sin(angle) * R);
          ctx.lineWidth = 4;
          ctx.strokeStyle = '#4E342E';
          ctx.lineCap = 'round';
          ctx.stroke();
        });

        // 外圈細線
        ctx.beginPath();
        ctx.arc(cx, cy, R, 0, Math.PI * 2);
        ctx.lineWidth = 5;
        ctx.strokeStyle = '#4E342E';
        ctx.stroke();

        // 文字 — 一律橫排、不跟著扇形旋轉。
        // 舊版沿半徑排版，正上方那格會變成直書、左半圈上下顛倒，實機根本讀不動；
        // 獎項多大是這頁唯一要傳達的事，讀不到就沒有意義。
        var baseFs = Math.round(R * 0.105);
        function setFont(px, weight) {
          ctx.font = (weight || 800) + ' ' + px + 'px "PingFang TC","Heiti TC","Microsoft JhengHei",sans-serif';
        }
        // 獎品名慣例是「【26,000 哩】頭獎」：括號內是主角（大字），括號外是獎次（小字）。
        // 沒有括號就整串當一行，太長才從空白處切兩行。
        function splitLabel(name) {
          var t = String(name || '').trim();
          var m = t.match(/^\u3010(.+?)\u3011\s*(.*)$/);
          if (m) return { big: m[1].trim(), small: (m[2] || '').trim() };
          if (t.length <= 6) return { big: t, small: '' };
          var sp = t.indexOf(' ');
          if (sp > 0) return { big: t.slice(0, sp), small: t.slice(sp + 1) };
          var h = Math.ceil(t.length / 2);
          return { big: t.slice(0, h), small: t.slice(h) };
        }
        function fitText(t, px, maxW) {
          setFont(px);
          while (px > 9 && ctx.measureText(t).width > maxW) { px -= 1; setFont(px); }
          return px;
        }

        prizes.forEach(function (p, i) {
          var midAngle = i * anglePer - Math.PI / 2 + anglePer / 2 + wheelOffsetRad;
          var lab = splitLabel(p.name);
          // 放在扇形重心附近；格子越多半徑越往外，字才不會擠在圓心
          var rr = R * (n <= 5 ? 0.60 : 0.66);
          var x = cx + Math.cos(midAngle) * rr;
          var y = cy + Math.sin(midAngle) * rr;
          // 一格在該半徑上的弦長，就是這行字能用的寬度
          var maxW = Math.max(56, 2 * rr * Math.sin(anglePer / 2) * 0.92);

          ctx.save();
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillStyle = '#4E342E';

          var bigPx = fitText(lab.big, Math.round(baseFs * 1.15), maxW);
          var smallPx = Math.max(9, Math.round(bigPx * 0.55));
          if (lab.small) {
            setFont(bigPx);
            ctx.fillText(lab.big, x, y - Math.round(bigPx * 0.42));
            setFont(smallPx, 700);
            ctx.fillText(lab.small, x, y + Math.round(bigPx * 0.52));
          } else {
            setFont(bigPx);
            ctx.fillText(lab.big, x, y);
          }
          ctx.restore();
        });

        // 停止瞬間的中獎高亮：其餘扇形微暗 + 中獎格亮黃描邊 pulse
        if (typeof highlightIdx === 'number' && highlightIdx >= 0 && highlightIdx < n) {
          prizes.forEach(function (p, i) {
            if (i === highlightIdx) return;
            var ds = i * anglePer - Math.PI / 2 + wheelOffsetRad;
            var de = ds + anglePer;
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.arc(cx, cy, R, ds, de);
            ctx.closePath();
            ctx.fillStyle = 'rgba(62, 39, 35, 0.42)';
            ctx.fill();
          });
          var hs = highlightIdx * anglePer - Math.PI / 2 + wheelOffsetRad;
          var he = hs + anglePer;
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.arc(cx, cy, R - 5, hs, he);
          ctx.closePath();
          ctx.lineWidth = 10;
          ctx.lineJoin = 'round';
          ctx.globalAlpha = (typeof pulse === 'number') ? (0.35 + 0.65 * pulse) : 1;
          ctx.strokeStyle = '#F9C73B';
          ctx.stroke();
          ctx.globalAlpha = 1;
        }
      }

      // ----- 停止瞬間：中獎扇形高亮 pulse（~0.55s）再揭曉 -----
      function highlightWinner(prize) {
        var idx = prizes.findIndex(function (p) { return p.id === prize.id; });
        if (idx < 0) {
          return new Promise(function (resolve) { setTimeout(resolve, 250); });
        }
        buzz([12, 50, 20]);
        return new Promise(function (resolve) {
          if (REDUCED) {
            drawWheel(idx, 1);
            setTimeout(resolve, 250);
            return;
          }
          var startTs = null;
          var DUR = 550;
          var done = false;
          function finish() {
            if (done) return;
            done = true;
            drawWheel(idx, 1);
            resolve();
          }
          // requestAnimationFrame 在分頁／App 被切到背景時不會觸發。
          // 沒有這個保險，使用者轉一半切走再回來就永遠看不到結果。
          var guard = setTimeout(finish, DUR + 600);
          function frame(ts) {
            if (done) return;
            if (startTs === null) startTs = ts;
            var t = Math.min((ts - startTs) / DUR, 1);
            var pulse = 0.5 - 0.5 * Math.cos(t * Math.PI * 4); // 兩次脈衝
            drawWheel(idx, t >= 1 ? 1 : pulse);
            if (t < 1) { requestAnimationFrame(frame); return; }
            clearTimeout(guard);
            finish();
          }
          requestAnimationFrame(frame);
        });
      }

      // ----- LIFF init -----
      async function initLiff() {
        var qs = new URLSearchParams(location.search);
        var devUid = qs.get('uid');
        if (devUid) {
          profile = { userId: devUid, displayName: qs.get('name') || 'DEV' };
          return;
        }
        if (qs.get('preview') === '1') {
          profile = { userId: 'PREVIEW', displayName: '預覽' };
          spinBtn.disabled = true;
          spinBtn.textContent = '預覽';
          return;
        }
        if (!liffId) throw new Error('LIFF ID 未設定');
        // 伺服器端已經把 liff.state 轉送到正確頁面了，但 Netlify 的 rewrite 會把原始
        // query 補回沒有 query 的相對轉址，害這個參數殘留在網址上。留著的話 liff.init()
        // 會再導一次頁 → 在 LINE 裡多一次整頁重載（首屏只有 2 秒預算，不能浪費）。
        try {
          if (location.search.indexOf('liff.state') >= 0) {
            var _u = new URL(location.href);
            _u.searchParams.delete('liff.state');
            history.replaceState({}, '', _u.pathname + _u.search + _u.hash);
          }
        } catch (e) { /* 舊 webview 沒有 URL/replaceState 就算了，只是多一次導頁 */ }
        try { await liff.init({ liffId: liffId }); }
        catch (e) { throw new Error('LIFF 初始化失敗'); }
        if (!liff.isInClient()) throw new Error('請在 LINE App 內打開');
        if (!liff.isLoggedIn()) {
          liff.login();
          return new Promise(function () {});
        }
        profile = await liff.getProfile();
        try { idToken = liff.getIDToken(); } catch (e) {}
      }

      // ----- 旋轉動畫：反向蓄力 → 長尾 ease-out 正轉 → 指針 bounce -----
      function animateToPrize(prize) {
        var n = prizes.length;
        if (n === 0) return Promise.resolve();
        var idx = prizes.findIndex(function (p) { return p.id === prize.id; });
        if (idx < 0) idx = 0;
        var anglePer = 360 / n;
        var targetCenter = (idx + 0.5) * anglePer;
        var jitter = (Math.random() - 0.5) * (anglePer * 0.5);
        // 指針在正上方。扇形 i 的中心在「順時針 targetCenter 度」，
        // 要讓它轉到正上方，畫面上的總轉角必須 ≡ 360 - targetCenter（mod 360）。
        //
        // 這裡有兩個角度疊在一起：canvas 裡已經烘進去的 bakedDeg（上一次落地留下的），
        // 以及這次要下的 CSS 轉角。原本的寫法把上一次的「殘留角度」直接當基準往上加，
        // 第二次抽獎開始就整個偏掉——指針停在 A 格、實際中的卻是 B 格。
        var bakedDeg = (wheelOffsetRad * 180 / Math.PI) % 360;
        var need = ((360 - targetCenter + jitter) - bakedDeg) % 360;
        if (need < 0) need += 360;
        var finalAngle = 360 * 6 + need;
        var windFrom = currentRotation;
        currentRotation = finalAngle;

        var stage = document.getElementById('stage');
        var spinMs = REDUCED ? 1200 : 4050; // 必須等於 CSS .stage.spinning #wheel 的 transition 時長

        return new Promise(function (resolve) {
          function mainSpin() {
            canvas.classList.remove('windup');
            void canvas.offsetWidth; // 強制 reflow，確保 transition 切換生效
            if (stage) stage.classList.add('spinning');
            canvas.style.transform = 'rotate(' + finalAngle + 'deg)';
            setTimeout(function () {
              if (stage) {
                stage.classList.remove('spinning');
                stage.classList.add('landed');
                setTimeout(function () { stage.classList.remove('landed'); }, 650);
              }
              // 角度烘進 canvas、CSS 歸零：畫面位置完全一樣，但文字回正
              wheelOffsetRad = ((wheelOffsetRad * 180 / Math.PI) + finalAngle) % 360 * Math.PI / 180;
              var prevTransition = canvas.style.transition;
              canvas.style.transition = 'none';
              canvas.style.transform = 'rotate(0deg)';
              currentRotation = 0;
              drawWheel();
              void canvas.offsetWidth;
              canvas.style.transition = prevTransition;
              resolve();
            }, spinMs);
          }
          if (REDUCED) {
            mainSpin();
            return;
          }
          // 蓄力：先反向 -15deg（0.3s），再正轉
          canvas.classList.add('windup');
          canvas.style.transform = 'rotate(' + (windFrom - 15) + 'deg)';
          setTimeout(mainSpin, 320);
        });
      }

      // ----- spin -----
      async function spin() {
        if (spinning) return;
        if (!liffReady || !profile) {
          statusEl.textContent = '請稍候';
          return;
        }
        spinning = true;
        spinBtn.disabled = true;
        if (ctaBtn) { ctaBtn.disabled = true; ctaBtn.textContent = '轉動中'; }
        statusRow.classList.remove('ready');
        statusEl.textContent = '看它停在哪⋯';
        buzz(12);

        try {
          // 防重複扣次數：每一次「想抽」產一把鑰匙；只有網路斷掉（沒收到任何回應）
          // 才保留同一把，下次按就帶同一把重送——伺服器認得就回原結果，不再扣一次
          if (!pendingPlayKey) {
            pendingPlayKey = 'pk' + Date.now().toString(36) + Math.random().toString(36).slice(2, 10);
            savePlayKey(pendingPlayKey);
          }
          var resp = await fetch('/api/games/wheel/' + encodeURIComponent(slug) + '/spin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              line_user_id: profile.userId,
              line_display_name: profile.displayName || null,
              id_token: idToken,
              play_key: pendingPlayKey
            })
          }).then(function (r) { return r.json(); });

          if (!resp.ok) {
            pendingPlayKey = null; savePlayKey(null);   // 伺服器明確拒絕（沒扣次數）→ 換新鑰匙
            if (resp.error === 'must_follow_oa') {
              if (window.ORMGM) ORMGM.gate.serverDenied();
              openFollowGate('要先加「OpenRice 開飯喇」好友才能參加，加完回來就可以玩。');
            }
            statusEl.textContent = resp.detail || resp.error || '抽選失敗';
            spinning = false;
            spinBtn.disabled = false;
            return;
          }

          await animateToPrize(resp.prize);
          await highlightWinner(resp.prize); // 停頓：高亮 pulse ~0.55s
          showResult(resp.prize, resp);
          // 鑰匙撐到結果真的顯示出來才換新：萬一動畫或顯示途中出錯，
          // 用戶照提示再按一次會帶同一把鑰匙→伺服器回原結果，不會被多扣一次
          pendingPlayKey = null; savePlayKey(null);
        } catch (e) {
          // 收不到回應或顯示途中出錯：鑰匙留著，下一次按會重送同一把，
          // 伺服器認得就回原本的結果，不會扣兩次
          statusEl.textContent = '收訊不穩，再按一次「開始轉」';
        } finally {
          spinning = false;
          spinBtn.disabled = false;
          if (ctaBtn) { ctaBtn.disabled = false; setCtaMode(ctaMode); }
          refreshQuota(); // 抽完立刻回寫剩餘次數
        }
      }

      // 「銘謝惠顧」類判斷（純演出用：決定要不要慶祝）
      function isNoPrize(prize) {
        if (!prize) return false;
        if (prize.prize_type === 'none') return true;
        return /銘謝|惠顧|再接再厲|未中|落空/.test(String(prize.name || ''));
      }

      // 優惠序號顯示：coupon_code 可能在 prize 物件上或 /play 回應頂層
      function renderCoupon(prize, resp) {
        var block = document.getElementById('coupon-block');
        var oos = document.getElementById('coupon-oos');
        if (!block || !oos) return;
        var code = (prize && prize.coupon_code) || (resp && resp.coupon_code) || '';
        var outOfStock = !!(resp && resp.coupon_out_of_stock) || !!(prize && prize.coupon_out_of_stock);
        if (code) {
          document.getElementById('coupon-code').textContent = code;
          block.hidden = false;
          oos.hidden = true;
        } else if (outOfStock) {
          block.hidden = true;
          oos.hidden = false;
        } else {
          block.hidden = true;
          oos.hidden = true;
        }
      }

      function showResult(prize, resp) {
        statusEl.textContent = '';
        renderCoupon(prize, resp);
        var noPrize = isNoPrize(prize);
        var eyebrowEl = document.getElementById('modal-eyebrow');
        if (eyebrowEl) eyebrowEl.textContent = noPrize ? '開獎結果' : '恭喜抽中';
        document.getElementById('modal-prize').textContent = prize.name || '—';
        var imgEl = document.getElementById('modal-img');
        var glyphEl = document.getElementById('modal-glyph');
        var resultImage = prize.image_url || (prize.is_grand_prize ? GRAND_PRIZE_IMAGE : '');
        if (resultImage) {
          imgEl.src = resultImage;
          imgEl.hidden = false;
          glyphEl.style.display = 'none';
        } else {
          imgEl.hidden = true;
          glyphEl.style.display = 'block';
          glyphEl.textContent = prize.is_grand_prize ? '★' : '◆';
        }
        var descParts = [];
        if (prize.prize_value) {
          if (prize.prize_value.amount) descParts.push('NT$ ' + prize.prize_value.amount);
          if (prize.prize_value.code) descParts.push('優惠碼 ' + prize.prize_value.code);
          if (prize.prize_value.label) descParts.push(prize.prize_value.label);
          if (prize.prize_value.note) descParts.push(prize.prize_value.note);
        }
        // 後台填的獎品說明（例「消費滿 500 元可用」）也要露出，不然使用者不知道怎麼用。
        // 但「銘謝惠顧」不是獎品，那一格的說明欄實務上都被當成後台備註在寫
        // （實際看過：「沒中獎時顯示這個」），照秀出去等於把內部字條貼到用戶臉上。
        if (prize.description && !noPrize) descParts.push(String(prize.description));
        var descText = descParts.join(' · ');
        if (noPrize) descText = '這次沒中，找個朋友一起，再試一次';
        document.getElementById('modal-desc').textContent = descText;
        if (prize.is_grand_prize) modal.classList.add('grand');
        else modal.classList.remove('grand');
        if (noPrize) modal.classList.add('noprize');
        else modal.classList.remove('noprize');

        // 抽完就把結果留在本頁；不依賴 wallet API 才能看到。
        renderMyPrizes([{
          prize_name: prize.name || '獎品', prize_desc: prize.description || '',
          is_win: !noPrize, miles: prize.miles || null,
          code: prize.coupon_code || (resp && resp.coupon_code) || null,
          won_at: new Date().toISOString(), redeemed: false
        }]);

        // 彈窗底部：沒中且還能邀請時，提供「找朋友」；其餘都回本頁看結果。
        var closeBtn = document.getElementById('modal-close');
        var dismissBtn = document.getElementById('modal-dismiss');
        var footEl = document.getElementById('modal-foot');
        var bonusLeft = lastQuota
          ? (lastQuota.referral_bonus_max - lastQuota.referral_bonus)
          : (activityMeta.referral_bonus_max || 0);
        var canInvite = (activityMeta.referral_bonus_per > 0) && bonusLeft > 0;

        if (noPrize && canInvite) {
          modalMode = 'invite';
          closeBtn.textContent = '找朋友再抽一次';
          dismissBtn.hidden = false;
          footEl.hidden = false;
          footEl.innerHTML = '朋友加入官方帳號才算，最多還能加 <span class="n">' + bonusLeft + '</span> 次';
        } else {
          modalMode = 'close';
          closeBtn.textContent = '完成，回本頁看結果';
          dismissBtn.hidden = true;
          footEl.hidden = true;
          footEl.textContent = '';
        }

        // 先顯示、強制 reflow、再位移，否則 display:none→block 會把 transition 吃掉。
        // 這裡不能用 requestAnimationFrame：App 被切到背景時 rAF 不會觸發，
        // 使用者切回來就永遠看不到結果。
        clearTimeout(hideTimer);
        modal.classList.add('shown');
        modal.setAttribute('aria-hidden', 'false');
        void modal.offsetWidth;
        modal.classList.add('open');
        // 揭曉節奏：modal 彈起 → 獎名彈跳放大 → 慶祝
        if (!noPrize) {
          setTimeout(function () {
            // 不放紙花：改用獎名彈跳（.pop）＋震動做慶祝，設計明文禁止紙花
            var pn = document.getElementById('modal-prize');
            if (pn && !REDUCED) { pn.classList.remove('pop'); void pn.offsetWidth; pn.classList.add('pop'); }
            buzz(prize.is_grand_prize ? [18, 70, 32] : [16, 60]);
          }, 380);
        } else {
          buzz(14);
        }
      }

      // 優惠碼複製
      (function () {
        var cp = document.getElementById('coupon-copy');
        if (!cp) return;
        var label = cp.lastChild;
        cp.addEventListener('click', async function () {
          var t = (document.getElementById('coupon-code').textContent || '').trim();
          if (!t) return;
          try {
            await navigator.clipboard.writeText(t);
            label.textContent = '已複製';
            setTimeout(function () { label.textContent = '複製'; }, 1800);
          } catch (e) {
            prompt('複製這組優惠碼：', t);
          }
        });
      })();

      var modalMode = 'close';
      var hideTimer = null;
      function closeModal() {
        modal.classList.remove('open');
        modal.setAttribute('aria-hidden', 'true');
        clearTimeout(hideTimer);
        hideTimer = setTimeout(function () { modal.classList.remove('shown'); }, 400);
        drawWheel(); // 還原高亮
      }
      document.getElementById('modal-close').addEventListener('click', function () {
        if (modalMode === 'invite') { closeModal(); shareWithFriend(); return; }
        closeModal();
      });
      document.getElementById('modal-dismiss').addEventListener('click', closeModal);
      modal.addEventListener('click', function (e) {
        if (e.target === modal) closeModal();
      });

      spinBtn.addEventListener('click', spin);

      // ----- bootstrap -----
      if (prizes.length < 2) {
        statusEl.textContent = '這個活動還在準備中，晚點再來';
        statusRow.classList.add('done');
        document.getElementById('stat-lead').textContent = '還沒開始';
        document.getElementById('stat-unit').textContent = '';
        spinBtn.disabled = true;
        if (ctaBtn) { ctaBtn.disabled = true; ctaBtn.textContent = '尚未開放'; }
      } else {
        drawWheel();
        spinBtn.disabled = true;
        if (ctaBtn) { ctaBtn.disabled = true; ctaBtn.textContent = '稍等一下'; }
        statusEl.textContent = '正在確認你的身分';
      }

      (async function () {
        if (prizes.length < 2) return;
        try {
          await initLiff();
          liffReady = true;

          // 1) 先處理「我是被邀請來的」— 把 referral 寫進 DB
          await maybeRegisterReferral();
          if (window.ORMGM) {
            ORMGM.gate.init(addFriendUrl, recheckFollow);
            ORMGM.watchReturn({
              slug: slug,
              busy: function () { return !!spinning; },
              onQuota: refreshQuota,
              onRecheck: recheckFollow,
              onReferral: maybeRegisterReferral
            });
          }

          // 2) 拉 quota
          await refreshQuota();

          // 3) ready — 只有還有次數才打招呼，否則會蓋掉 renderQuota 寫的引導文案
          statusRow.classList.add('ready');
          if (lastRemaining === null || lastRemaining > 0) {
            statusEl.innerHTML = '哈囉，<span class="name">' + (profile.displayName || '') + '</span>';
          }
        } catch (e) {
          statusEl.textContent = e.message || '初始化失敗';
        }
      })();

      // ----- 邀請拉新：偵測 ?ref= 並寫 referral -----
      // 邀請送出。失敗不代表沒救——被邀請的人多半只是還沒加好友，
      // ORMGM 會把邀請存起來，等他加完好友切回來自動重送。
      async function maybeRegisterReferral() {
        if (!window.ORMGM || !profile || !profile.userId) return;
        var r = await ORMGM.referral({
          gameType: 'wheel', slug: slug, userId: profile.userId,
          getIdToken: function () { try { return liff.getIDToken() || idToken || ''; } catch (e) { return idToken || ''; } }
        });
        handleReferralResult(r);
      }

      function handleReferralResult(r) {
        if (!r) return;
        if (r.state === 'done') {
          // 本來就是官方帳號好友 → 不會幫邀請人加次數。要當場講，
          // 否則對方會回頭跟朋友說「我幫你點了」，朋友卻沒多一次機會，兩邊都覺得系統壞了。
          if (r.counted && r.wasExisting) {
            ORMGM.toast('你本來就是官方帳號好友，這次不算朋友的新邀請，但你自己照樣可以玩');
          } else if (r.counted) {
            ORMGM.toast('好了，這次算你朋友邀請成功');
          } else if (r.sameInviter === false) {
            ORMGM.toast('你已經在這個活動裡了，直接開始玩');
          }
          return;
        }
        if (r.state !== 'pending') return;
        if (r.code === 'invitee_not_follower') {
          openFollowGate('先加「OpenRice 開飯喇」好友，才算你朋友邀請成功，你也才能玩。');
        } else if (r.later) {
          ORMGM.toast('活動還沒開跑，你朋友的邀請我們先幫你記著');
        }
      }

      // 加好友閘門。重新確認一律問伺服器（前端的好友判定不可靠），
      // 伺服器放行就把閘門收起來並刷新次數。
      function openFollowGate(text) {
        if (!window.ORMGM) return;
        ORMGM.gate.init(addFriendUrl, recheckFollow);
        ORMGM.gate.show(text);
      }

      async function recheckFollow() {
        var r = await ORMGM.referral({
          gameType: 'wheel', slug: slug, userId: (profile && profile.userId) || '',
          getIdToken: function () { try { return liff.getIDToken() || idToken || ''; } catch (e) { return idToken || ''; } }
        });
        // 沒有待處理的邀請（自然流量的人）就直接問 quota，能拿到就代表過了
        var passed = (r && (r.state === 'done' || r.state === 'none' || r.state === 'skip'));
        if (passed) {
          ORMGM.gate.hide();
          await refreshQuota();
          handleReferralResult(r);
          return true;
        }
        return false;
      }

      // ----- 拉 quota 並更新 UI -----
      // 我抽到的獎：從 wallet API 撈，只留這檔活動的。哩數獎品也算（沒有優惠碼）
      function fmtWhen(ts){
        try{ return new Date(ts).toLocaleDateString('zh-TW',{timeZone:'Asia/Taipei',month:'numeric',day:'numeric'}); }
        catch(e){ return ''; }
      }
      function escHtml(x){return String(x==null?'':x).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
      function renderMyPrizes(mine) {
        var box = document.getElementById('myprize');
        var list = document.getElementById('myprize-list');
        if (!box || !list || !mine || !mine.length) return;
        var wins = mine.filter(function (p) { return p.is_win !== false; }).length;
        var head = document.querySelector('.myprize-head');
        if (head) {
          head.textContent = '我抽到的獎（共 ' + mine.length + ' 次' +
            (wins ? ('，中了 ' + wins + ' 次') : '') + '）';
        }
        list.innerHTML = mine.map(function (p, i) {
          var isWin = p.is_win !== false;
          var sub = !isWin ? '這次沒中，找個朋友一起就能多抽一次'
            : (p.miles
                ? (p.redeemed ? '哩數已經發放' : '活動結束後統一發放到你的帳戶')
                : (p.prize_desc || ''));
          var code = (isWin && p.code)
            ? '<div class="pz-code"><span id="pzc' + i + '">' + escHtml(p.code) + '</span>' +
              '<button type="button" class="pz-copy" data-i="' + i + '">複製</button></div>'
            : '';
          return '<div class="pz' + (isWin ? '' : ' pz-miss') + '"><div class="pz-main">' +
            '<div class="pz-name">' + (i === 0 ? '<span class="pz-latest">最新</span>' : '') + escHtml(p.prize_name) + '</div>' +
            (sub ? '<div class="pz-sub">' + escHtml(sub) + '</div>' : '') + code +
            '</div><div class="pz-when">' + fmtWhen(p.won_at) + '</div></div>';
        }).join('');
        box.hidden = false;
        [].slice.call(list.querySelectorAll('.pz-copy')).forEach(function (b) {
          b.addEventListener('click', function () {
            var el = document.getElementById('pzc' + b.getAttribute('data-i'));
            if (!el) return;
            try {
              navigator.clipboard.writeText(el.textContent.trim());
              b.textContent = '已複製';
              setTimeout(function () { b.textContent = '複製'; }, 1500);
            } catch (e) { /* 複製失敗時儲值碼仍會顯示 */ }
          });
        });
      }
      async function refreshMyPrizes() {
        try {
          if (!profile || !profile.userId) return;
          var resp = await fetch('/api/games/wallet?line_user_id=' + encodeURIComponent(profile.userId),
            { headers: { 'Authorization': 'Bearer ' + (idToken || '') } }).then(function (r) { return r.json(); });
          if (!resp || !resp.ok || !Array.isArray(resp.prizes)) return;
          var mine = resp.prizes.filter(function (p) { return p.activity_slug === slug; });
          var box = document.getElementById('myprize');
          var list = document.getElementById('myprize-list');
          if (!box || !list) return;
          // /spin 的結果已經先留在畫面上。若 wallet 同步慢半拍，不可把剛抽到的結果藏掉。
          if (!mine.length) { if (!list.children.length) box.hidden = true; return; }
          var wins = mine.filter(function (p) { return p.is_win !== false; }).length;
          var head = document.querySelector('.myprize-head');
          if (head) {
            head.textContent = '我抽到的獎（共 ' + mine.length + ' 次' +
              (wins ? ('，中了 ' + wins + ' 次') : '') + '）';
          }
          list.innerHTML = mine.map(function (p, i) {
            var isWin = p.is_win !== false;
            var sub = !isWin ? '這次沒中，再找朋友來就能多抽一次'
              : (p.miles
                  ? (p.redeemed ? '哩數已經發放' : '活動結束後統一發放到你的帳戶')
                  : (p.prize_desc || ''));
            var code = (isWin && p.code)
              ? '<div class="pz-code"><span id="pzc' + i + '">' + escHtml(p.code) + '</span>' +
                '<button type="button" class="pz-copy" data-i="' + i + '">複製</button></div>'
              : '';
            return '<div class="pz' + (isWin ? '' : ' pz-miss') + '"><div class="pz-main">' +
              '<div class="pz-name">' + (i === 0 ? '<span class="pz-latest">最新</span>' : '') + escHtml(p.prize_name) + '</div>' +
              (sub ? '<div class="pz-sub">' + escHtml(sub) + '</div>' : '') + code +
              '</div><div class="pz-when">' + fmtWhen(p.won_at) + '</div></div>';
          }).join('');
          box.hidden = false;
          [].slice.call(list.querySelectorAll('.pz-copy')).forEach(function (b) {
            b.addEventListener('click', function () {
              var el = document.getElementById('pzc' + b.getAttribute('data-i'));
              if (!el) return;
              try {
                navigator.clipboard.writeText(el.textContent.trim());
                b.textContent = '已複製';
                setTimeout(function () { b.textContent = '複製'; }, 1500);
              } catch (e) { /* 複製失敗就算了，碼還是看得到 */ }
            });
          });
        } catch (e) { console.warn('my prizes fetch failed:', e); }
      }

      async function refreshQuota() {
        try {
          if (!profile || !profile.userId) return;
          var resp = await fetch('/api/games/wheel/' + encodeURIComponent(slug) +
            '/meta?line_user_id=' + encodeURIComponent(profile.userId),
            { headers: { 'Authorization': 'Bearer ' + (idToken || '') } }).then(function (r) { return r.json(); });
          if (!resp.ok || !resp.quota) return;
          renderQuota(resp.quota);
          refreshMyPrizes();
        } catch (e) { console.warn('quota fetch failed:', e); }
      }

      // 數字變化時 pop 一下（scale 1.3 → 1）
      var lastRemaining = null;
      var lastReferrals = null;
      var lastQuota = null;
      function popStat(el) {
        if (!el || REDUCED) return;
        el.classList.remove('pop');
        void el.offsetWidth; // restart animation
        el.classList.add('pop');
      }

      // 主 CTA 有三種身分：轉、找朋友、已完成。獎項直接留在本頁。
      // 是整個 MGM 能不能擴散的關鍵，不能只把鈕變灰。
      // （ctaBtn 本身在最上面宣告——bootstrap 比這裡早跑，需要用到它）
      var ctaMode = 'spin';
      function setCtaMode(mode) {
        if (!ctaBtn) return;
        ctaMode = mode;
        ctaBtn.classList.toggle('ghost', mode === 'done');
        ctaBtn.disabled = mode === 'done';
        ctaBtn.textContent = mode === 'invite' ? '找朋友' : (mode === 'done' ? '本次活動已完成' : '開始轉');
      }

      function renderQuota(q) {
        var remEl = document.getElementById('stat-remaining');
        var refEl = document.getElementById('stat-referrals');
        if (remEl) remEl.textContent = q.remaining;
        if (refEl) refEl.textContent = q.referrals;
        // 有人點了連結但本來就是好友 → 明講不算，否則邀請人會以為系統沒算到他
        var exEl = document.getElementById('invite-existing');
        if (exEl) {
          var ex = Number(q.referrals_existing || 0);
          exEl.textContent = ex > 0 ? ('（另外 ' + ex + ' 位本來就是好友，不加次數）') : '';
        }
        if (remEl && lastRemaining !== null && lastRemaining !== q.remaining) popStat(remEl);
        if (refEl && lastReferrals !== null && lastReferrals !== q.referrals) popStat(refEl);
        lastRemaining = q.remaining;
        lastReferrals = q.referrals;
        lastQuota = q;

        var leadEl = document.getElementById('stat-lead');
        var unitEl = document.getElementById('stat-unit');

        // 沒次數 → SPIN 鈕禁用 + 提示
        if (q.remaining <= 0) {
          spinBtn.disabled = true;
          statusRow.classList.add('done');
          var canMore = q.referral_bonus_per > 0 && q.referral_bonus < q.referral_bonus_max;
          if (canMore) {
            statusRow.classList.remove('ready');
            if (leadEl) leadEl.textContent = '次數用完了';
            if (unitEl) unitEl.textContent = '';
            var nbw = Number(q.next_bonus_in || 0);
            statusEl.textContent = nbw > 0
              ? ('再找 ' + nbw + ' 位朋友來，就多 ' + q.referral_bonus_per + ' 次')
              : ('找朋友來，就多 ' + q.referral_bonus_per + ' 次');
            setCtaMode('invite');
          } else {
            if (leadEl) leadEl.textContent = '這次玩完了';
            if (unitEl) unitEl.textContent = '';
            statusEl.textContent = '你抽到的結果就在下方，下次活動見';
            setCtaMode('done');
          }
        } else {
          spinBtn.disabled = false;
          statusRow.classList.remove('done');
          if (leadEl) leadEl.textContent = '還可以轉';
          if (unitEl) unitEl.textContent = '次';
          setCtaMode('spin');
        }

        // invite card 顯示剩餘可加額度
        var inviteCard = document.getElementById('invite-card');
        var inviteSub = document.getElementById('invite-sub');
        // 只在有邀請機制時更新文案；否則保留 server render 的「把這個活動傳出去」
        if (inviteCard && q.referral_bonus_per > 0) {
          var bonusLeft = q.referral_bonus_max - q.referral_bonus;
          if (bonusLeft <= 0) {
            inviteCard.classList.add('maxed');
            if (inviteSub) inviteSub.textContent = '邀請次數已用滿';
          } else {
            inviteCard.classList.remove('maxed');
            // 邀 N 換 1 的進度感：講「再邀幾位就多 1 次」，不是叫人自己除
            var nb = Number(q.next_bonus_in || 0);
            if (inviteSub) inviteSub.textContent = nb > 0
              ? ('已邀 ' + q.referrals + ' 位，再邀 ' + nb + ' 位就多 ' + q.referral_bonus_per + ' 次（還能加 ' + bonusLeft + ' 次）')
              : ('還能加 ' + bonusLeft + ' 次');
          }
        }
      }

      // 主 CTA 依目前身分分派
      if (ctaBtn) {
        ctaBtn.addEventListener('click', function () {
          if (ctaMode === 'invite') return shareWithFriend();
          if (ctaMode === 'done') return;
          spinBtn.click();
        });
      }

      // ----- 分享按鈕（LIFF Share Target Picker）-----
      var inviteBtn = document.getElementById('invite-btn');
      if (inviteBtn) {
        inviteBtn.addEventListener('click', shareWithFriend);
      }
      async function shareWithFriend() {
        if (!profile || !profile.userId) {
          alert('身分驗證中，稍等一下再試');
          return;
        }
        // 邀請連結：LIFF 短網址帶 ref query 跟 sub-path
        // 注意：LIFF 短網址子路徑會被 append 到 endpoint URL
        // /wheel/<slug>?ref=<my_id> 會解析到 /games/wheel/<slug>?ref=<my_id>
        var inviteUrl = 'https://liff.line.me/' + liffId +
          '/wheel/' + encodeURIComponent(slug) + '?ref=' + encodeURIComponent(profile.userId);
        var msg = '快來抽「' + activityMeta.name + '」！我已經抽過了，你也來試試';

        try {
          if (liff.isApiAvailable && liff.isApiAvailable('shareTargetPicker')) {
            var res = await liff.shareTargetPicker([{
              type: 'text',
              text: msg + '\n' + inviteUrl
            }]);
            if (res) {
              // 分享成功（不一定代表對方點開，只代表用戶選擇了對象）
              var needShare = Number(activityMeta.referral_invites_per_bonus || 1);
              flashStatus(needShare > 1
                ? ('已分享！朋友加好友並打開才算，每 ' + needShare + ' 位加 ' + activityMeta.referral_bonus_per + ' 次')
                : ('已分享！朋友打開後就加 ' + activityMeta.referral_bonus_per + ' 次'));
            }
            return;
          }
        } catch (e) {
          console.warn('shareTargetPicker failed:', e);
        }
        // fallback: 複製連結
        try {
          await navigator.clipboard.writeText(inviteUrl);
          flashStatus('連結已複製，傳給朋友吧');
        } catch (e) {
          prompt('複製這個連結傳給朋友：', inviteUrl);
        }
      }
      function flashStatus(msg) {
        var orig = statusEl.textContent;
        statusEl.textContent = msg;
        setTimeout(function () {
          // 重新拉 quota 確保 UI sync
          refreshQuota();
          if (statusEl.textContent === msg && profile && lastRemaining > 0) {
            statusEl.innerHTML = '哈囉，<span class="name">' + (profile.displayName || '') + '</span>';
          }
        }, 2400);
      }

      // spin 成功後也要 refresh quota
      var origAnimate = animateToPrize;
      animateToPrize = function (prize) {
        return origAnimate(prize).then(function () {
          // 不要 await（讓 modal 先彈），但稍後 refresh
          setTimeout(refreshQuota, 600);
        });
      };
    })();
  </script>
</body>
</html>
